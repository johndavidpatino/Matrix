@{
    ViewData["Title"] = "Requerimientos de Equipo";
}

<div class="container-fluid mt-4">
    <div class="card">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0">
                <i class="bi bi-tools"></i> Requerimientos de Equipo
            </h4>
        </div>
        <div class="card-body">
            <!-- Filtros -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Trabajo</label>
                    <select id="filtroTrabajo" class="form-select">
                        <option value="">Todos</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Estado</label>
                    <select id="filtroEstado" class="form-select">
                        <option value="">Todos</option>
                        <option value="1">Pendiente</option>
                        <option value="2">Aprobado</option>
                        <option value="3">Rechazado</option>
                        <option value="4">En Proceso</option>
                        <option value="5">Completado</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button id="btnFiltrar" class="btn btn-info w-100">
                        <i class="bi bi-search"></i> Filtrar
                    </button>
                </div>
            </div>

            <!-- Botones de acción -->
            <div class="mb-3">
                <button id="btnNuevo" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Nuevo Requerimiento
                </button>
                <button id="btnGenerarMuestra" class="btn btn-warning text-white">
                    <i class="bi bi-file-earmark-text"></i> Generar Muestra
                </button>
            </div>

            <!-- Tabla -->
            <div class="table-responsive">
                <table id="tablaRequerimientos" class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Trabajo</th>
                            <th>Tipo Equipo</th>
                            <th>Cantidad Req.</th>
                            <th>Disponible</th>
                            <th>Faltante</th>
                            <th>Estado</th>
                            <th>Fecha Solicitud</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Requerimiento -->
<div class="modal fade" id="modalRequerimiento" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="bi bi-tools"></i> <span id="modalTitulo">Nuevo Requerimiento</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formRequerimiento">
                    <input type="hidden" id="idRequerimiento">
                    
                    <div class="mb-3">
                        <label for="idTrabajo" class="form-label">Trabajo <span class="text-danger">*</span></label>
                        <select id="idTrabajo" class="form-select" required>
                            <option value="">Seleccione...</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="tipoEquipo" class="form-label">Tipo de Equipo <span class="text-danger">*</span></label>
                        <input type="text" id="tipoEquipo" class="form-control" maxlength="100" required>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="cantidadRequerida" class="form-label">Cantidad Requerida <span class="text-danger">*</span></label>
                            <input type="number" id="cantidadRequerida" class="form-control" min="1" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="cantidadDisponible" class="form-label">Cantidad Disponible</label>
                            <input type="number" id="cantidadDisponible" class="form-control" min="0" value="0">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="especificaciones" class="form-label">Especificaciones</label>
                        <textarea id="especificaciones" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="observaciones" class="form-label">Observaciones</label>
                        <textarea id="observaciones" class="form-control" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> Cancelar
                </button>
                <button type="button" id="btnGuardar" class="btn btn-info">
                    <i class="bi bi-save"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Muestra -->
<div class="modal fade" id="modalMuestra" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">
                    <i class="bi bi-file-earmark-text"></i> Muestra de Requerimientos
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="trabajoMuestra" class="form-label">Seleccione Trabajo</label>
                    <select id="trabajoMuestra" class="form-select">
                        <option value="">Seleccione...</option>
                    </select>
                </div>
                <div id="contenidoMuestra"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let tabla = null;
            const modal = new bootstrap.Modal('#modalRequerimiento');
            const modalMuestra = new bootstrap.Modal('#modalMuestra');

            const estadosBadge = {
                1: '<span class="badge bg-warning">Pendiente</span>',
                2: '<span class="badge bg-success">Aprobado</span>',
                3: '<span class="badge bg-danger">Rechazado</span>',
                4: '<span class="badge bg-info">En Proceso</span>',
                5: '<span class="badge bg-primary">Completado</span>'
            };

            // Inicializar DataTable
            function inicializarTabla() {
                tabla = $('#tablaRequerimientos').DataTable({
                    language: {
                        url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
                    },
                    columns: [
                        { data: 'idRequerimiento' },
                        { data: 'nombreTrabajo' },
                        { data: 'tipoEquipo' },
                        { data: 'cantidadRequerida', className: 'text-end' },
                        { data: 'cantidadDisponible', className: 'text-end' },
                        {
                            data: 'cantidadFaltante',
                            className: 'text-end',
                            render: (data) => data > 0 ? `<span class="text-danger fw-bold">${data}</span>` : data
                        },
                        {
                            data: 'estado',
                            render: (data) => estadosBadge[data] || data
                        },
                        {
                            data: 'fechaSolicitud',
                            render: (data) => data ? new Date(data).toLocaleDateString('es-CO') : ''
                        },
                        {
                            data: null,
                            orderable: false,
                            render: (data) => `
                                <button class="btn btn-sm btn-danger btn-eliminar" data-id="${data.idRequerimiento}">
                                    <i class="bi bi-trash"></i>
                                </button>
                            `
                        }
                    ]
                });
            }

            // Cargar requerimientos
            function cargarRequerimientos() {
                const idTrabajo = $('#filtroTrabajo').val() || null;
                const estado = $('#filtroEstado').val() || null;

                $.get('@Url.Action("ObtenerRequerimientos", "RequerimientosEquipo")', {
                    idTrabajo, estado
                }).done(function (response) {
                    if (response.success) {
                        tabla.clear().rows.add(response.data).draw();
                    } else {
                        Swal.fire('Error', response.message, 'error');
                    }
                });
            }

            // Nuevo requerimiento
            $('#btnNuevo').click(function () {
                $('#formRequerimiento')[0].reset();
                $('#idRequerimiento').val('');
                $('#modalTitulo').text('Nuevo Requerimiento');
                modal.show();
            });

            // Guardar requerimiento
            $('#btnGuardar').click(function () {
                if (!$('#formRequerimiento')[0].checkValidity()) {
                    $('#formRequerimiento')[0].reportValidity();
                    return;
                }

                const request = {
                    idRequerimiento: parseInt($('#idRequerimiento').val()) || 0,
                    idTrabajo: parseInt($('#idTrabajo').val()),
                    tipoEquipo: $('#tipoEquipo').val(),
                    cantidadRequerida: parseInt($('#cantidadRequerida').val()),
                    cantidadDisponible: parseInt($('#cantidadDisponible').val()),
                    especificaciones: $('#especificaciones').val(),
                    observaciones: $('#observaciones').val(),
                    usuarioSolicita: '@User.Identity?.Name'
                };

                $.ajax({
                    url: '@Url.Action("GuardarRequerimiento", "RequerimientosEquipo")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(request)
                }).done(function (response) {
                    if (response.success) {
                        Swal.fire('Éxito', 'Requerimiento guardado correctamente', 'success');
                        modal.hide();
                        cargarRequerimientos();
                    } else {
                        Swal.fire('Error', response.message, 'error');
                    }
                });
            });

            // Generar muestra
            $('#btnGenerarMuestra').click(function () {
                modalMuestra.show();
            });

            $('#trabajoMuestra').change(function () {
                const idTrabajo = $(this).val();
                if (!idTrabajo) return;

                $.get('@Url.Action("GenerarMuestra", "RequerimientosEquipo")', { idTrabajo })
                    .done(function (response) {
                        if (response.success && response.data.length > 0) {
                            let html = '<table class="table table-sm table-bordered"><thead><tr>' +
                                '<th>Equipo</th><th>Requerido</th><th>Disponible</th><th>Faltante</th></tr></thead><tbody>';
                            
                            response.data.forEach(m => {
                                html += `<tr>
                                    <td>${m.tipoEquipo}</td>
                                    <td>${m.cantidadRequerida}</td>
                                    <td>${m.cantidadDisponible}</td>
                                    <td class="text-danger fw-bold">${m.cantidadFaltante}</td>
                                </tr>`;
                            });
                            
                            html += '</tbody></table>';
                            $('#contenidoMuestra').html(html);
                        } else {
                            $('#contenidoMuestra').html('<div class="alert alert-info">No hay datos para generar muestra</div>');
                        }
                    });
            });

            // Eliminar requerimiento
            $(document).on('click', '.btn-eliminar', function () {
                const id = $(this).data('id');

                Swal.fire({
                    title: '¿Está seguro?',
                    text: 'Esta acción no se puede deshacer',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("EliminarRequerimiento", "RequerimientosEquipo")',
                            type: 'DELETE',
                            data: { id }
                        }).done(function (response) {
                            if (response.success) {
                                Swal.fire('Éxito', 'Requerimiento eliminado', 'success');
                                cargarRequerimientos();
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        });
                    }
                });
            });

            // Eventos
            $('#btnFiltrar').click(cargarRequerimientos);

            // Inicializar
            inicializarTabla();
            cargarRequerimientos();
        });
    </script>
}
