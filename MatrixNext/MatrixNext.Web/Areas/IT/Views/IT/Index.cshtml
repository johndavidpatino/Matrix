@{
    ViewData["Title"] = "Infraestructura Tecnológica";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="mb-3">
                <i class="fas fa-server me-2"></i>
                Infraestructura Tecnológica
            </h2>
            <p class="text-muted">Sistema de gestión técnica y sincronización</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Synchronization -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm hover-shadow">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-sync-alt fa-3x text-primary"></i>
                    </div>
                    <h5 class="card-title">Synchronization</h5>
                    <p class="card-text text-muted small">Resolución de problemas de sincronización</p>
                </div>
                <div class="card-footer bg-transparent border-top-0">
                    <a href="@Url.Action("Index", "SyncIssues", new { area = "IT" })" 
                       class="btn btn-primary btn-sm w-100">
                        <i class="fas fa-tools me-1"></i>
                        Arreglar Problemas
                    </a>
                </div>
            </div>
        </div>

        <!-- Centro Información -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-database fa-3x text-info"></i>
                    </div>
                    <h5 class="card-title">Centro Información</h5>
                    <p class="card-text text-muted small">Gestión de almacenamiento y medios</p>
                </div>
                <div class="card-footer bg-transparent border-top-0">
                    <div class="d-grid gap-2">
                        <a href="#" class="btn btn-outline-info btn-sm disabled" title="Pendiente migración">
                            <i class="fas fa-hdd me-1"></i>
                            Almacenamiento en Disco
                        </a>
                        <a href="#" class="btn btn-outline-info btn-sm disabled" title="Pendiente migración">
                            <i class="fas fa-search me-1"></i>
                            Solicitud de Medios
                        </a>
                        <a href="#" class="btn btn-outline-info btn-sm disabled" title="Pendiente migración">
                            <i class="fas fa-list me-1"></i>
                            Consulta de Solicitudes
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Inventario -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-boxes fa-3x text-warning"></i>
                    </div>
                    <h5 class="card-title">Inventario</h5>
                    <p class="card-text text-muted small">Gestión de artículos y activos</p>
                </div>
                <div class="card-footer bg-transparent border-top-0">
                    <a href="#" class="btn btn-outline-warning btn-sm w-100 disabled" title="Pendiente migración">
                        <i class="fas fa-box me-1"></i>
                        Registro de Artículos
                    </a>
                </div>
            </div>
        </div>

        <!-- Usuarios -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-users-cog fa-3x text-success"></i>
                    </div>
                    <h5 class="card-title">Usuarios</h5>
                    <p class="card-text text-muted small">Administración de usuarios y permisos</p>
                </div>
                <div class="card-footer bg-transparent border-top-0">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Index", "Usuarios", new { area = "US" })" 
                           class="btn btn-outline-success btn-sm">
                            <i class="fas fa-user me-1"></i>
                            Gestión de Usuarios
                        </a>
                        <a href="#" class="btn btn-outline-success btn-sm disabled" title="Pendiente migración">
                            <i class="fas fa-building me-1"></i>
                            Unidades
                        </a>
                        <a href="#" class="btn btn-outline-success btn-sm disabled" title="Pendiente migración">
                            <i class="fas fa-shield-alt me-1"></i>
                            Permisos
                        </a>
                        <a href="#" class="btn btn-outline-success btn-sm disabled" title="Pendiente migración">
                            <i class="fas fa-user-tag me-1"></i>
                            Roles
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .hover-shadow {
            transition: box-shadow 0.3s ease-in-out, transform 0.3s ease-in-out;
        }

        .hover-shadow:hover {
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
            transform: translateY(-5px);
        }

        .card-footer .d-grid {
            gap: 0.5rem;
        }
    </style>
}
