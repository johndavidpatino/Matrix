@{
    ViewData["Title"] = "Easy Work";
    ViewData["PageHeader"] = "Easy Work";
    ViewData["PageSubHeader"] = "Gestione sus días de trabajo remoto";
}

<div class="container-fluid">
    <!-- Encabezado con botón de nueva solicitud -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card card-outline card-primary">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-home me-2"></i>
                        Solicitar Easy Work
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="txtUsuario">Documento del Empleado</label>
                                <input type="text" class="form-control" id="txtUsuario" placeholder="Número de documento">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>&nbsp;</label>
                                <div id="lblUsuario" class="form-control-static font-weight-bold text-primary"></div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="txtFecha">Fecha del Easy Work</label>
                                <input type="date" class="form-control" id="txtFecha">
                            </div>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="button" class="btn btn-primary btn-block" id="btnEnviar">
                                <i class="fas fa-paper-plane me-1"></i> Solicitar
                            </button>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-8">
                            <div class="form-group">
                                <label for="txtObservaciones">Observaciones</label>
                                <textarea class="form-control" id="txtObservaciones" rows="2" 
                                          placeholder="Observaciones opcionales"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-12">
                            <div class="alert alert-info mb-0">
                                <i class="fas fa-info-circle me-2"></i>
                                <strong>Reglas:</strong> Máximo 2 días de Easy Work por mes, 1 por quincena. 
                                No se permiten días consecutivos.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Búsqueda de solicitudes -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card card-outline card-info">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-search me-2"></i>
                        Mis Solicitudes
                    </h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool" data-card-widget="collapse">
                            <i class="fas fa-minus"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="txtFechaIni">Fecha Inicio</label>
                                <input type="date" class="form-control" id="txtFechaIni">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="txtFechaFin">Fecha Fin</label>
                                <input type="date" class="form-control" id="txtFechaFin">
                            </div>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="button" class="btn btn-info btn-block" id="btnBuscar">
                                <i class="fas fa-search me-1"></i> Buscar
                            </button>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="button" class="btn btn-secondary btn-block" id="btnLimpiar">
                                <i class="fas fa-eraser me-1"></i> Limpiar
                            </button>
                        </div>
                    </div>
                    
                    <!-- Tabla de solicitudes -->
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="tblSolicitudes">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Usuario</th>
                                    <th>Nombre</th>
                                    <th>Fecha Programada</th>
                                    <th>Estado</th>
                                    <th>Observaciones</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tbodySolicitudes">
                                <tr>
                                    <td colspan="7" class="text-center text-muted">
                                        <i class="fas fa-search me-2"></i>
                                        Ingrese criterios de búsqueda y presione Buscar
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Calendario Gantt -->
    <div class="row">
        <div class="col-12">
            <div class="card card-outline card-success">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-calendar-alt me-2"></i>
                        Calendario de Easy Work
                    </h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool" data-card-widget="collapse">
                            <i class="fas fa-minus"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div id="ganttContainer" style="min-height: 300px;">
                        <div class="text-center text-muted py-5">
                            <i class="fas fa-calendar-times fa-3x mb-3"></i>
                            <p>Realice una búsqueda para ver el calendario</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para gestionar solicitud -->
<div class="modal fade" id="modalGestion" tabindex="-1" aria-labelledby="modalGestionLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalGestionLabel">
                    <i class="fas fa-cog me-2"></i>Gestionar Easy Work
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hfIdGestion">
                <input type="hidden" id="hfEstadoGestion">
                
                <div class="form-group mb-3">
                    <label>Usuario</label>
                    <input type="text" class="form-control" id="txtUsuarioGestion" readonly>
                </div>
                <div class="form-group mb-3">
                    <label>Nombre</label>
                    <input type="text" class="form-control" id="txtNombreGestion" readonly>
                </div>
                <div class="form-group mb-3">
                    <label>Fecha Programada</label>
                    <input type="text" class="form-control" id="txtFechaGestion" readonly>
                </div>
                <div class="form-group mb-3">
                    <label>Estado Actual</label>
                    <input type="text" class="form-control" id="txtEstadoGestion" readonly>
                </div>
                <div class="form-group mb-3">
                    <label for="txtObservacionesGestion">Observaciones de Gestión</label>
                    <textarea class="form-control" id="txtObservacionesGestion" rows="3" 
                              placeholder="Ingrese observaciones (requerido para rechazar o anular)"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cerrar
                </button>
                <button type="button" class="btn btn-danger" id="btnAnular">
                    <i class="fas fa-ban me-1"></i> Anular
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        // Inicializar fechas por defecto
        const hoy = new Date();
        const primerDia = new Date(hoy.getFullYear(), hoy.getMonth(), 1);
        const ultimoDia = new Date(hoy.getFullYear(), hoy.getMonth() + 2, 0);
        
        $('#txtFechaIni').val(formatDate(primerDia));
        $('#txtFechaFin').val(formatDate(ultimoDia));
        
        // Eventos
        $('#txtUsuario').on('change', buscarUsuario);
        $('#btnEnviar').on('click', enviarSolicitud);
        $('#btnBuscar').on('click', buscarSolicitudes);
        $('#btnLimpiar').on('click', limpiar);
        $('#btnAnular').on('click', anularSolicitud);
        
        // Cargar solicitudes iniciales
        buscarSolicitudes();
    });
    
    function formatDate(date) {
        return date.toISOString().split('T')[0];
    }
    
    function buscarUsuario() {
        const documento = $('#txtUsuario').val().trim();
        if (!documento) {
            $('#lblUsuario').text('');
            return;
        }
        
        // TODO: Llamar API para obtener nombre del usuario
        $.get('@Url.Action("BuscarEmpleado", "Empleados", new { area = "TH" })', { identificacion: documento }, function(response) {
            if (response.success && response.data) {
                $('#lblUsuario').text(response.data.nombres + ' ' + response.data.apellidos);
            } else {
                $('#lblUsuario').text('Usuario no encontrado');
            }
        });
    }
    
    function enviarSolicitud() {
        const usuario = $('#txtUsuario').val().trim();
        const fecha = $('#txtFecha').val();
        const observaciones = $('#txtObservaciones').val().trim();
        
        if (!usuario) {
            toastr.error('El documento del empleado es obligatorio');
            return;
        }
        if (!fecha) {
            toastr.error('La fecha del Easy Work es obligatoria');
            return;
        }
        
        $.ajax({
            url: '@Url.Action("Crear", "HWH", new { area = "TH" })',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                usuario: parseInt(usuario),
                fechaProgramada: fecha,
                observaciones: observaciones
            }),
            success: function(response) {
                if (response.success) {
                    toastr.success(response.message);
                    limpiarFormulario();
                    buscarSolicitudes();
                } else {
                    toastr.error(response.message);
                }
            },
            error: function() {
                toastr.error('Error al procesar la solicitud');
            }
        });
    }
    
    function buscarSolicitudes() {
        const fechaIni = $('#txtFechaIni').val();
        const fechaFin = $('#txtFechaFin').val();
        
        $.get('@Url.Action("MisSolicitudes", "HWH", new { area = "TH" })', function(response) {
            if (response.success) {
                renderizarSolicitudes(response.data);
            }
        });
    }
    
    function renderizarSolicitudes(solicitudes) {
        const tbody = $('#tbodySolicitudes');
        tbody.empty();
        
        if (!solicitudes || solicitudes.length === 0) {
            tbody.html('<tr><td colspan="7" class="text-center text-muted">No se encontraron solicitudes</td></tr>');
            return;
        }
        
        solicitudes.forEach(function(s) {
            const row = `
                <tr>
                    <td>${s.id}</td>
                    <td>${s.usuario}</td>
                    <td>${s.nombreUsuario || '-'}</td>
                    <td>${s.fechaProgramadaStr}</td>
                    <td><span class="badge ${s.estadoBadgeClass}">${s.nombreEstado}</span></td>
                    <td>${s.observaciones || '-'}</td>
                    <td>
                        ${s.puedeAnular ? `<button class="btn btn-sm btn-danger" onclick="abrirModalGestion(${s.id})"><i class="fas fa-ban"></i></button>` : ''}
                    </td>
                </tr>
            `;
            tbody.append(row);
        });
    }
    
    function abrirModalGestion(id) {
        $.get('@Url.Action("Obtener", "HWH", new { area = "TH" })', { id: id }, function(response) {
            if (response.success) {
                const s = response.data;
                $('#hfIdGestion').val(s.id);
                $('#hfEstadoGestion').val(s.estado);
                $('#txtUsuarioGestion').val(s.usuario);
                $('#txtNombreGestion').val(s.nombreUsuario);
                $('#txtFechaGestion').val(s.fechaProgramadaStr);
                $('#txtEstadoGestion').val(s.nombreEstado);
                $('#txtObservacionesGestion').val('');
                
                $('#btnAnular').prop('disabled', !s.puedeAnular);
                
                $('#modalGestion').modal('show');
            }
        });
    }
    
    function anularSolicitud() {
        const id = $('#hfIdGestion').val();
        const observaciones = $('#txtObservacionesGestion').val().trim();
        
        if (!observaciones) {
            toastr.error('Debe indicar el motivo de la anulación');
            return;
        }
        
        $.ajax({
            url: '@Url.Action("Anular", "HWH", new { area = "TH" })',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                id: parseInt(id),
                estado: 4,
                observaciones: observaciones
            }),
            success: function(response) {
                if (response.success) {
                    toastr.success(response.message);
                    $('#modalGestion').modal('hide');
                    buscarSolicitudes();
                } else {
                    toastr.error(response.message);
                }
            },
            error: function() {
                toastr.error('Error al anular la solicitud');
            }
        });
    }
    
    function limpiar() {
        $('#txtFechaIni').val('');
        $('#txtFechaFin').val('');
        $('#tbodySolicitudes').html('<tr><td colspan="7" class="text-center text-muted">Ingrese criterios de búsqueda</td></tr>');
        $('#ganttContainer').html('<div class="text-center text-muted py-5"><i class="fas fa-calendar-times fa-3x mb-3"></i><p>Realice una búsqueda para ver el calendario</p></div>');
    }
    
    function limpiarFormulario() {
        $('#txtUsuario').val('');
        $('#lblUsuario').text('');
        $('#txtFecha').val('');
        $('#txtObservaciones').val('');
    }
</script>
}
