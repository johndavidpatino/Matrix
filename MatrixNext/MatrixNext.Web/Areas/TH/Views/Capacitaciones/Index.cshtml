@using MatrixNext.Data.Modules.TH.Capacitaciones.Models
@model IEnumerable<CapacitacionDto>

@{
    ViewData["Title"] = "Capacitaciones";
    var trabajoId = ViewBag.TrabajoId as long?;
    var responsables = ViewBag.Responsables as IEnumerable<ResponsableComboDto> ?? Enumerable.Empty<ResponsableComboDto>();
}

<div class="container-fluid">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-mortarboard me-2"></i>Capacitaciones</h2>
            @if (trabajoId.HasValue)
            {
                <small class="text-muted">Trabajo: @trabajoId</small>
            }
        </div>
        <div>
            <button type="button" class="btn btn-primary" id="btnNuevo">
                <i class="bi bi-plus-lg me-1"></i>Nueva Capacitación
            </button>
            @if (trabajoId.HasValue)
            {
                <a href="@Url.Action("Index", "Trabajos", new { area = "PY" })" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Volver
                </a>
            }
        </div>
    </div>

    <!-- Filtros -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Responsable</label>
                    <select id="filtroResponsable" class="form-select">
                        <option value="">-- Todos --</option>
                        @foreach (var resp in responsables)
                        {
                            <option value="@resp.Id">@resp.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fecha Desde</label>
                    <input type="date" id="filtroFechaDesde" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fecha Hasta</label>
                    <input type="date" id="filtroFechaHasta" class="form-control" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-primary w-100" id="btnBuscar">
                        <i class="bi bi-search me-1"></i>Buscar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Lista de capacitaciones -->
    <div class="card">
        <div class="card-body">
            <div id="listaCapacitaciones">
                @await Html.PartialAsync("_Lista", Model)
            </div>
        </div>
    </div>
</div>

<!-- Modal Container -->
<div class="modal fade" id="modalCapacitacion" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="modalContent">
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const trabajoId = @(trabajoId.HasValue ? trabajoId.Value.ToString() : "null");

        // Nueva capacitación
        $('#btnNuevo').click(function() {
            const url = '@Url.Action("Create")' + (trabajoId ? '?trabajoId=' + trabajoId : '');
            $.get(url, function(html) {
                $('#modalContent').html(html);
                $('#modalCapacitacion').modal('show');
            });
        });

        // Buscar
        $('#btnBuscar').click(function() {
            cargarLista();
        });

        // Cargar lista
        function cargarLista() {
            const url = '@Url.Action("Lista")' + (trabajoId ? '?trabajoId=' + trabajoId : '');
            $.get(url, function(html) {
                $('#listaCapacitaciones').html(html);
            });
        }

        // Editar capacitación
        $(document).on('click', '.btn-editar', function() {
            const id = $(this).data('id');
            $.get('@Url.Action("Edit")/' + id, function(html) {
                $('#modalContent').html(html);
                $('#modalCapacitacion').modal('show');
            });
        });

        // Eliminar capacitación
        $(document).on('click', '.btn-eliminar', function() {
            const id = $(this).data('id');
            $.get('@Url.Action("Delete")/' + id, function(html) {
                $('#modalContent').html(html);
                $('#modalCapacitacion').modal('show');
            });
        });

        // Ver participantes
        $(document).on('click', '.btn-participantes', function() {
            const id = $(this).data('id');
            $.get('@Url.Action("Participantes")/' + id, function(html) {
                $('#modalContent').html(html);
                $('#modalCapacitacion').modal('show');
            });
        });

        // Crear refuerzo
        $(document).on('click', '.btn-refuerzo', function() {
            const id = $(this).data('id');
            if (confirm('¿Desea crear un refuerzo de esta capacitación?')) {
                $.post('@Url.Action("CrearRefuerzo")/' + id, {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                }, function(response) {
                    if (response.success) {
                        toastr.success(response.message);
                        cargarLista();
                    } else {
                        toastr.error(response.message);
                    }
                });
            }
        });

        // Guardar desde modal
        $(document).on('submit', '#formCapacitacion', function(e) {
            e.preventDefault();
            const form = $(this);
            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                success: function(response) {
                    if (response.success) {
                        $('#modalCapacitacion').modal('hide');
                        toastr.success(response.message);
                        cargarLista();
                    } else {
                        toastr.error(response.message);
                    }
                },
                error: function() {
                    toastr.error('Error al procesar la solicitud');
                }
            });
        });

        // Confirmar eliminación
        $(document).on('click', '#btnConfirmarEliminar', function() {
            const id = $(this).data('id');
            $.post('@Url.Action("DeleteConfirm")/' + id, {
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            }, function(response) {
                if (response.success) {
                    $('#modalCapacitacion').modal('hide');
                    toastr.success(response.message);
                    cargarLista();
                } else {
                    toastr.error(response.message);
                }
            });
        });
    </script>
}
