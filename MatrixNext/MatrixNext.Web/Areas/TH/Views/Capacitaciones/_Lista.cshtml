@using MatrixNext.Data.Modules.TH.Capacitaciones.Models
@model IEnumerable<CapacitacionDto>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>No se encontraron capacitaciones
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Fecha</th>
                    <th>Actividad</th>
                    <th>Ubicación</th>
                    <th>Responsable</th>
                    <th>Duración (h)</th>
                    <th>Participantes</th>
                    <th>Aprobados</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Fecha?.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span title="@item.Actividad">
                                @(item.Actividad?.Length > 50 ? item.Actividad.Substring(0, 50) + "..." : item.Actividad)
                            </span>
                        </td>
                        <td>@item.Ubicacion</td>
                        <td>@item.ResponsableNombre</td>
                        <td class="text-center">@item.Duracion</td>
                        <td class="text-center">
                            <span class="badge bg-primary">@item.TotalParticipantes</span>
                        </td>
                        <td class="text-center">
                            @if (item.TotalParticipantes > 0)
                            {
                                var porcentaje = (item.TotalAprobados * 100) / item.TotalParticipantes;
                                var colorClass = porcentaje >= 80 ? "bg-success" : (porcentaje >= 50 ? "bg-warning" : "bg-danger");
                                <span class="badge @colorClass">@item.TotalAprobados (@porcentaje%)</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">-</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-primary btn-participantes" 
                                        data-id="@item.Id" title="Participantes">
                                    <i class="bi bi-people"></i>
                                </button>
                                <button type="button" class="btn btn-outline-info btn-editar" 
                                        data-id="@item.Id" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-refuerzo" 
                                        data-id="@item.Id" title="Crear Refuerzo">
                                    <i class="bi bi-arrow-repeat"></i>
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-eliminar" 
                                        data-id="@item.Id" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@Html.AntiForgeryToken()
