@model MatrixNext.Data.ViewModels.MBO.AOTPorGerentesViewModel
@{
    ViewData["Title"] = "AOT por Gerentes - Dashboard";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="text-primary">
                <i class="fas fa-users me-2"></i>AOT por Gerentes - Dashboard
            </h2>
            <p class="text-muted">Rendimiento Individual de Gerentes de Cuenta</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("Index", "Home", new { area = "MBO" })" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Volver
            </a>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label for="año" class="form-label">Año</label>
                    <select id="año" name="año" class="form-select">
                        @for (int i = DateTime.Now.Year; i >= DateTime.Now.Year - 3; i--)
                        {
                            <option value="@i" selected="@(i == Model.AñoSeleccionado)">@i</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="mes" class="form-label">Mes</label>
                    <select id="mes" name="mes" class="form-select">
                        @{
                            var meses = new[] { "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", 
                                              "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
                            for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i" selected="@(i == Model.MesSeleccionado)">@meses[i-1]</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="sigla" class="form-label">Unidad</label>
                    <select id="sigla" name="sigla" class="form-select">
                        @foreach (var unidad in Model.UnidadesDisponibles)
                        {
                            <option value="@unidad.Sigla" selected="@(unidad.Sigla == Model.SiglaSeleccionada)">
                                @unidad.NombreUnidad (@unidad.Sigla)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-filter me-2"></i>Filtrar
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.TieneDatos)
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            No hay datos disponibles para los filtros seleccionados.
        </div>
    }
    else
    {
        <!-- Gráfico de Gerentes -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="fas fa-chart-bar me-2 text-primary"></i>
                            AOT por Gerente de Cuenta
                        </h5>
                        <canvas id="gerentesChart" height="120"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla de Gerentes -->
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="fas fa-table me-2 text-primary"></i>
                            Detalle por Gerente
                        </h5>
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Gerente</th>
                                        <th>Unidad</th>
                                        <th class="text-end">Budget</th>
                                        <th class="text-end">Meta</th>
                                        <th class="text-end">AOT</th>
                                        <th class="text-end">% Logro</th>
                                        <th class="text-center">Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var gerente in Model.GerentesDetalle.OrderByDescending(g => g.PorcentajeLogro))
                                    {
                                        <tr>
                                            <td><strong>@gerente.NombreCompleto</strong></td>
                                            <td>@gerente.Unidad</td>
                                            <td class="text-end">@gerente.BudgetGerente.ToString("N0")</td>
                                            <td class="text-end">@gerente.MetaGerente.ToString("N0")</td>
                                            <td class="text-end">@gerente.AOTGerente.ToString("N0")</td>
                                            <td class="text-end"><strong>@gerente.PorcentajeLogro.ToString("F1")%</strong></td>
                                            <td class="text-center">
                                                @if (gerente.PorcentajeLogro >= 100)
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-check-circle me-1"></i>Cumplido
                                                    </span>
                                                }
                                                else if (gerente.PorcentajeLogro >= 80)
                                                {
                                                    <span class="badge bg-warning">
                                                        <i class="fas fa-clock me-1"></i>En Progreso
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">
                                                        <i class="fas fa-exclamation-triangle me-1"></i>Rezagado
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        @if (Model.TieneDatos)
        {
            <text>
            const gerentesLabels = [@Html.Raw(string.Join(",", Model.GerentesDetalle.Select(g => $"'{g.NombreCompleto}'")))];
            const gerentesBudget = [@Html.Raw(string.Join(",", Model.GerentesDetalle.Select(g => g.BudgetGerente)))];
            const gerentesMeta = [@Html.Raw(string.Join(",", Model.GerentesDetalle.Select(g => g.MetaGerente)))];
            const gerentesAOT = [@Html.Raw(string.Join(",", Model.GerentesDetalle.Select(g => g.AOTGerente)))];

            const gerentesCtx = document.getElementById('gerentesChart').getContext('2d');
            new Chart(gerentesCtx, {
                type: 'bar',
                data: {
                    labels: gerentesLabels,
                    datasets: [
                        {
                            label: 'Budget',
                            data: gerentesBudget,
                            backgroundColor: '#0d6efd',
                            borderRadius: 4
                        },
                        {
                            label: 'Meta',
                            data: gerentesMeta,
                            backgroundColor: '#198754',
                            borderRadius: 4
                        },
                        {
                            label: 'AOT',
                            data: gerentesAOT,
                            backgroundColor: '#17a2b8',
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    indexAxis: 'y',
                    plugins: {
                        legend: { position: 'top' },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': ' + context.parsed.x.toLocaleString();
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString();
                                }
                            }
                        }
                    }
                }
            });
            </text>
        }
    </script>
}
