@model MatrixNext.Data.ViewModels.MBO.AOTGerenciaViewModel
@{
    ViewData["Title"] = "AOT Gerencia - Dashboard";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="text-primary">
                <i class="fas fa-bullseye me-2"></i>AOT Gerencia - Dashboard
            </h2>
            <p class="text-muted">Achievement of Tasks - Vista de Gerencia</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("Index", "Home", new { area = "MBO" })" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Volver
            </a>
        </div>
    </div>

    <!-- Filtros (similar a Dirección) -->
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label for="año" class="form-label">Año</label>
                    <select id="año" name="año" class="form-select">
                        @for (int i = DateTime.Now.Year; i >= DateTime.Now.Year - 3; i--)
                        {
                            <option value="@i" selected="@(i == Model.AñoSeleccionado)">@i</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="mes" class="form-label">Mes</label>
                    <select id="mes" name="mes" class="form-select">
                        @{
                            var meses = new[] { "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", 
                                              "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
                            for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i" selected="@(i == Model.MesSeleccionado)">@meses[i-1]</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="sigla" class="form-label">Unidad/Gerencia</label>
                    <select id="sigla" name="sigla" class="form-select">
                        @foreach (var unidad in Model.UnidadesDisponibles)
                        {
                            <option value="@unidad.Sigla" selected="@(unidad.Sigla == Model.SiglaSeleccionada)">
                                @unidad.NombreUnidad (@unidad.Sigla)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-filter me-2"></i>Filtrar
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.TieneDatos)
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            No hay datos disponibles para los filtros seleccionados.
        </div>
    }
    else
    {
        <!-- Métricas Principales (igual que Dirección) -->
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-primary text-white">
                    <div class="card-body">
                        <h6 class="card-subtitle mb-2 opacity-75">Budget Total</h6>
                        <h3 class="mb-0">@(Model.BudgetEjecucion?.BudgetTotal.ToString("N0") ?? "0")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-success text-white">
                    <div class="card-body">
                        <h6 class="card-subtitle mb-2 opacity-75">Meta Total</h6>
                        <h3 class="mb-0">@(Model.BudgetEjecucion?.MetaTotal.ToString("N0") ?? "0")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-info text-white">
                    <div class="card-body">
                        <h6 class="card-subtitle mb-2 opacity-75">AOT Actual</h6>
                        <h3 class="mb-0">@(Model.BudgetEjecucion?.AOTTotal.ToString("N0") ?? "0")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm @(Model.BudgetEjecucion?.PorcentajeLogro >= 100 ? "bg-success" : Model.BudgetEjecucion?.PorcentajeLogro >= 80 ? "bg-warning" : "bg-danger") text-white">
                    <div class="card-body">
                        <h6 class="card-subtitle mb-2 opacity-75">% Logro</h6>
                        <h3 class="mb-0">@(Model.BudgetEjecucion?.PorcentajeLogro.ToString("F1") ?? "0")%</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gráficos -->
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="fas fa-tachometer-alt me-2 text-primary"></i>
                            Porcentaje de Logro
                        </h5>
                        <canvas id="gaugeChart" height="200"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="fas fa-chart-bar me-2 text-primary"></i>
                            Budget vs Meta vs AOT
                        </h5>
                        <canvas id="categoriaChart" height="200"></canvas>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        @if (Model.TieneDatos)
        {
            <text>
            const porcentajeLogro = @(Model.BudgetEjecucion?.PorcentajeLogro ?? 0);
            
            // Gauge Chart
            const gaugeCtx = document.getElementById('gaugeChart').getContext('2d');
            new Chart(gaugeCtx, {
                type: 'doughnut',
                data: {
                    datasets: [{
                        data: [porcentajeLogro, 100 - porcentajeLogro],
                        backgroundColor: [
                            porcentajeLogro >= 100 ? '#198754' : porcentajeLogro >= 80 ? '#ffc107' : '#dc3545',
                            '#e9ecef'
                        ],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    circumference: 180,
                    rotation: 270,
                    cutout: '70%',
                    plugins: {
                        legend: { display: false },
                        tooltip: { enabled: false },
                        title: {
                            display: true,
                            text: porcentajeLogro.toFixed(1) + '%',
                            font: { size: 32, weight: 'bold' },
                            color: '#333',
                            padding: { top: 30 }
                        }
                    }
                }
            });

            // Categoría Chart
            const categoriaCtx = document.getElementById('categoriaChart').getContext('2d');
            new Chart(categoriaCtx, {
                type: 'bar',
                data: {
                    labels: ['Action', 'Watch', 'Booster'],
                    datasets: [
                        {
                            label: 'Budget',
                            data: [@(Model.BudgetEjecucion?.BudgetAction ?? 0), @(Model.BudgetEjecucion?.BudgetWatch ?? 0), @(Model.BudgetEjecucion?.BudgetBooster ?? 0)],
                            backgroundColor: '#0d6efd',
                            borderRadius: 4
                        },
                        {
                            label: 'Meta',
                            data: [@(Model.BudgetEjecucion?.MetaAction ?? 0), @(Model.BudgetEjecucion?.MetaWatch ?? 0), @(Model.BudgetEjecucion?.MetaBooster ?? 0)],
                            backgroundColor: '#198754',
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top' }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { callback: function(value) { return value.toLocaleString(); } }
                        }
                    }
                }
            });
            </text>
        }
    </script>
}
