@model IEnumerable<MatrixNext.Data.Models.MBO.CampoEncuestadorDto>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover table-sm">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Encuestador</th>
                    <th class="text-center">Código</th>
                    <th class="text-center">Revisadas</th>
                    <th class="text-center">% Calidad</th>
                    <th class="text-center">Índice Error</th>
                    <th class="text-center">Semáforo</th>
                </tr>
            </thead>
            <tbody>
                @{ int ranking = 1; }
                @foreach (var encuestador in Model.OrderByDescending(e => e.PorcentajeCalidad))
                {
                    var colorSemaforo = encuestador.PorcentajeCalidad >= 95 ? "success" : (encuestador.PorcentajeCalidad >= 85 ? "warning" : "danger");
                    var textoSemaforo = encuestador.PorcentajeCalidad >= 95 ? "Verde" : (encuestador.PorcentajeCalidad >= 85 ? "Amarillo" : "Rojo");
                    
                    <tr>
                        <td class="fw-bold">@ranking</td>
                        <td>@encuestador.NombreEncuestador</td>
                        <td class="text-center">@encuestador.CodigoEncuestador</td>
                        <td class="text-center">@encuestador.EncuestasRevisadas</td>
                        <td class="text-center">
                            <span class="badge bg-@colorSemaforo">
                                @encuestador.PorcentajeCalidad.ToString("F1")%
                            </span>
                        </td>
                        <td class="text-center">@encuestador.IndiceError.ToString("F2")</td>
                        <td class="text-center">
                            <i class="fas fa-circle text-@colorSemaforo" title="@textoSemaforo"></i>
                            @textoSemaforo
                        </td>
                    </tr>
                    ranking++;
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center py-4">
        <i class="fas fa-info-circle fa-3x text-muted mb-3"></i>
        <p class="text-muted">No hay datos de encuestadores disponibles</p>
    </div>
}
