@{
    ViewData["Title"] = "Carga Masiva de Errores - Excel";
}

<div class="container-fluid">
    <!-- Encabezado -->
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="mb-3">
                <i class="fas fa-file-excel text-success"></i>
                Carga Masiva de Errores desde Excel
            </h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Errores">Gestión de Errores</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Carga Excel</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Instrucciones -->
    <div class="row mb-4">
        <div class="col-md-8 offset-md-2">
            <div class="alert alert-info">
                <h5 class="alert-heading">
                    <i class="fas fa-info-circle"></i> Instrucciones
                </h5>
                <p>El archivo Excel debe contener las siguientes columnas en orden:</p>
                <ol class="mb-0">
                    <li><strong>IdTrabajo</strong> - Número entero</li>
                    <li><strong>IdEncuestador</strong> - Número entero</li>
                    <li><strong>IdCiudad</strong> - Número entero</li>
                    <li><strong>FechaEncuesta</strong> - Formato: dd/MM/yyyy</li>
                    <li><strong>NumeroEncuesta</strong> - Texto</li>
                    <li><strong>IdTipoError</strong> - Número entero</li>
                    <li><strong>Observaciones</strong> - Texto (opcional)</li>
                </ol>
                <hr />
                <p class="mb-0">
                    <i class="fas fa-exclamation-triangle"></i>
                    <strong>Nota:</strong> La primera fila debe contener los encabezados. Los datos inician en la fila 2.
                </p>
            </div>
        </div>
    </div>

    <!-- Formulario de carga -->
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-upload"></i> Cargar Archivo Excel
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="CargarErroresExcel" method="post" enctype="multipart/form-data" id="formCargarExcel">
                        <div class="mb-3">
                            <label for="archivo" class="form-label">Archivo Excel (.xlsx o .xls)</label>
                            <input type="file" class="form-control" id="archivo" name="archivo" 
                                   accept=".xlsx,.xls" required />
                            <div class="form-text">
                                Tamaño máximo: 10 MB
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="año" class="form-label">Año</label>
                                <input type="number" class="form-control" id="año" name="año" 
                                       value="@DateTime.Now.Year" min="2020" max="2030" required />
                            </div>
                            <div class="col-md-6">
                                <label for="mes" class="form-label">Mes</label>
                                <select class="form-select" id="mes" name="mes" required>
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        <option value="@i" selected="@(i == DateTime.Now.Month)">
                                            @System.Globalization.CultureInfo.GetCultureInfo("es-ES").DateTimeFormat.GetMonthName(i)
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg" id="btnCargar">
                                <i class="fas fa-upload"></i> Cargar Errores
                            </button>
                            <a asp-action="Errores" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Resultado de la carga -->
    <div class="row mt-4" id="resultadoCarga" style="display: none;">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-sm" id="cardResultado">
                <div class="card-header" id="headerResultado">
                    <h5 class="mb-0" id="tituloResultado"></h5>
                </div>
                <div class="card-body">
                    <div id="contenidoResultado"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Spinner de carga -->
    <div class="row mt-4" id="spinnerCarga" style="display: none;">
        <div class="col-md-8 offset-md-2 text-center">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted">Procesando archivo Excel...</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#formCargarExcel').on('submit', function (e) {
                e.preventDefault();

                // Validar archivo
                const archivo = $('#archivo')[0].files[0];
                if (!archivo) {
                    alert('Debe seleccionar un archivo');
                    return;
                }

                // Validar tamaño (10 MB)
                if (archivo.size > 10485760) {
                    alert('El archivo excede el tamaño máximo de 10 MB');
                    return;
                }

                // Validar extensión
                const extension = archivo.name.split('.').pop().toLowerCase();
                if (extension !== 'xlsx' && extension !== 'xls') {
                    alert('Solo se permiten archivos .xlsx o .xls');
                    return;
                }

                // Mostrar spinner
                $('#spinnerCarga').show();
                $('#resultadoCarga').hide();
                $('#btnCargar').prop('disabled', true);

                // Enviar formulario
                const formData = new FormData(this);

                $.ajax({
                    url: $(this).attr('action'),
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        $('#spinnerCarga').hide();
                        $('#btnCargar').prop('disabled', false);

                        if (response.success) {
                            $('#headerResultado').removeClass('bg-danger').addClass('bg-success text-white');
                            $('#tituloResultado').html('<i class="fas fa-check-circle"></i> Carga Exitosa');
                            
                            let contenido = '<p>' + response.message + '</p>';
                            contenido += '<ul class="list-group">';
                            contenido += '<li class="list-group-item d-flex justify-content-between align-items-center">';
                            contenido += 'Registros insertados <span class="badge bg-success rounded-pill">' + response.insertados + '</span>';
                            contenido += '</li>';
                            contenido += '<li class="list-group-item d-flex justify-content-between align-items-center">';
                            contenido += 'Errores encontrados <span class="badge bg-danger rounded-pill">' + response.errores + '</span>';
                            contenido += '</li>';
                            contenido += '<li class="list-group-item d-flex justify-content-between align-items-center">';
                            contenido += 'Total registros procesados <span class="badge bg-info rounded-pill">' + response.totalRegistros + '</span>';
                            contenido += '</li>';
                            contenido += '</ul>';
                            contenido += '<div class="mt-3">';
                            contenido += '<a href="@Url.Action("Errores")" class="btn btn-primary"><i class="fas fa-list"></i> Ver Errores Cargados</a>';
                            contenido += '</div>';

                            $('#contenidoResultado').html(contenido);
                        } else {
                            $('#headerResultado').removeClass('bg-success').addClass('bg-danger text-white');
                            $('#tituloResultado').html('<i class="fas fa-exclamation-circle"></i> Error en la Carga');
                            $('#contenidoResultado').html('<p class="text-danger">' + response.message + '</p>');
                        }

                        $('#resultadoCarga').show();
                        
                        // Limpiar formulario si fue exitoso
                        if (response.success) {
                            $('#formCargarExcel')[0].reset();
                        }
                    },
                    error: function () {
                        $('#spinnerCarga').hide();
                        $('#btnCargar').prop('disabled', false);
                        
                        $('#headerResultado').removeClass('bg-success').addClass('bg-danger text-white');
                        $('#tituloResultado').html('<i class="fas fa-exclamation-circle"></i> Error');
                        $('#contenidoResultado').html('<p class="text-danger">Error inesperado al procesar el archivo</p>');
                        $('#resultadoCarga').show();
                    }
                });
            });
        });
    </script>
}
