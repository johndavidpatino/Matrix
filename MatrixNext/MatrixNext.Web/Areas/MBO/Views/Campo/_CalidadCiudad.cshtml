@model IEnumerable<MatrixNext.Data.Models.MBO.CampoCiudadDto>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover table-sm">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Ciudad</th>
                    <th class="text-center">Encuestas</th>
                    <th class="text-center">% Calidad</th>
                    <th class="text-center">Índice Error</th>
                </tr>
            </thead>
            <tbody>
                @{ int ranking = 1; }
                @foreach (var ciudad in Model.OrderByDescending(c => c.PorcentajeCalidad))
                {
                    var colorSemaforo = ciudad.PorcentajeCalidad >= 95 ? "success" : (ciudad.PorcentajeCalidad >= 85 ? "warning" : "danger");
                    
                    <tr>
                        <td class="fw-bold">@ranking</td>
                        <td>@ciudad.NombreCiudad</td>
                        <td class="text-center">@ciudad.EncuestasRevisadas</td>
                        <td class="text-center">
                            <span class="badge bg-@colorSemaforo">
                                @ciudad.PorcentajeCalidad.ToString("F1")%
                            </span>
                        </td>
                        <td class="text-center">@ciudad.IndiceError.ToString("F2")</td>
                    </tr>
                    ranking++;
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center py-4">
        <i class="fas fa-info-circle fa-3x text-muted mb-3"></i>
        <p class="text-muted">No hay datos de ciudades disponibles</p>
    </div>
}
