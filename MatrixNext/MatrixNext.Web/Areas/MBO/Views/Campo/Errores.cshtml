@model MatrixNext.Data.ViewModels.CampoErroresViewModel
@{
    ViewData["Title"] = $"Gestión de Errores - {Model.Mes:D2}/{Model.Año}";
}

<div class="container-fluid">
    <!-- Encabezado -->
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="mb-3">
                <i class="fas fa-exclamation-triangle text-danger"></i>
                Gestión de Errores de Campo
            </h2>
        </div>
    </div>

    <!-- Filtros y acciones -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form method="get" class="row g-3 mb-3">
                        <div class="col-md-2">
                            <label for="año" class="form-label">Año</label>
                            <input type="number" class="form-control form-control-sm" id="año" name="año" 
                                   value="@Model.Año" min="2020" max="2030" />
                        </div>
                        <div class="col-md-2">
                            <label for="mes" class="form-label">Mes</label>
                            <select class="form-select form-select-sm" id="mes" name="mes">
                                <option value="">Todos</option>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i" selected="@(i == Model.Mes)">
                                        @System.Globalization.CultureInfo.GetCultureInfo("es-ES").DateTimeFormat.GetMonthName(i)
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="sigla" class="form-label">Unidad</label>
                            <input type="text" class="form-control form-control-sm" id="sigla" name="sigla" 
                                   value="@Model.Sigla" placeholder="CO, EC, PE..." />
                        </div>
                        <div class="col-md-2">
                            <label for="idTrabajo" class="form-label">ID Trabajo</label>
                            <input type="number" class="form-control form-control-sm" id="idTrabajo" name="idTrabajo" 
                                   value="@Model.IdTrabajo" />
                        </div>
                        <div class="col-md-2">
                            <label for="idEncuestador" class="form-label">ID Encuestador</label>
                            <input type="number" class="form-control form-control-sm" id="idEncuestador" name="idEncuestador" 
                                   value="@Model.IdEncuestador" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-sm btn-primary w-100">
                                <i class="fas fa-search"></i> Buscar
                            </button>
                        </div>
                    </form>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#crearErrorModal">
                                <i class="fas fa-plus"></i> Nuevo Error
                            </button>
                            <a asp-action="CargarErroresExcel" class="btn btn-info">
                                <i class="fas fa-file-excel"></i> Carga Masiva Excel
                            </a>
                        </div>
                        <div class="col-md-6 text-end">
                            <span class="badge bg-secondary">Total: @(Model.Errores?.Count() ?? 0) errores</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de errores -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    @if (Model.Errores != null && Model.Errores.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover table-sm">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Trabajo</th>
                                        <th>Encuestador</th>
                                        <th>Ciudad</th>
                                        <th>Fecha Encuesta</th>
                                        <th>Nº Encuesta</th>
                                        <th>Tipo Error</th>
                                        <th>Severidad</th>
                                        <th>Estado</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var error in Model.Errores)
                                    {
                                        var severidadClass = error.SeveridadTexto == "Crítico" ? "danger" : 
                                                           (error.SeveridadTexto == "Mayor" ? "warning" : "info");
                                        var estadoClass = error.Estado == "Pendiente" ? "warning" : 
                                                        (error.Estado == "Resuelto" ? "success" : "secondary");
                                        
                                        <tr>
                                            <td>@error.IdError</td>
                                            <td>@error.IdTrabajo</td>
                                            <td>@error.NombreEncuestador</td>
                                            <td>@error.NombreCiudad</td>
                                            <td>@error.FechaEncuesta.ToString("dd/MM/yyyy")</td>
                                            <td>@error.NumeroEncuesta</td>
                                            <td>@error.TipoError</td>
                                            <td>
                                                <span class="badge bg-@severidadClass">@error.SeveridadTexto</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-@estadoClass">@error.Estado</span>
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-primary" 
                                                        onclick="editarError(@error.IdError)">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-danger" 
                                                        onclick="eliminarError(@error.IdError)">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                            <p class="text-muted">No se encontraron errores con los filtros aplicados</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Crear/Editar Error -->
<div class="modal fade" id="crearErrorModal" tabindex="-1" aria-labelledby="crearErrorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="crearErrorModalLabel">
                    <i class="fas fa-plus-circle"></i> Nuevo Error de Campo
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalContentCreate">
                <!-- Se cargará dinámicamente -->
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editarErrorModal" tabindex="-1" aria-labelledby="editarErrorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="editarErrorModalLabel">
                    <i class="fas fa-edit"></i> Editar Error de Campo
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalContentEdit">
                <!-- Se cargará dinámicamente -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Cargar modal de creación
        $('#crearErrorModal').on('show.bs.modal', function () {
            $.get('@Url.Action("CrearError")', function (data) {
                $('#modalContentCreate').html(data);
            });
        });

        // Función para editar error
        function editarError(id) {
            $.get('@Url.Action("EditarError")/' + id, function (data) {
                $('#modalContentEdit').html(data);
                $('#editarErrorModal').modal('show');
            });
        }

        // Función para eliminar error
        function eliminarError(id) {
            if (confirm('¿Está seguro de eliminar este error?')) {
                $.post('@Url.Action("EliminarError")/' + id, function (response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                });
            }
        }

        // Submit de formulario de crear/editar
        $(document).on('submit', '#formCrearError, #formEditarError', function (e) {
            e.preventDefault();
            
            $.post($(this).attr('action'), $(this).serialize(), function (response) {
                if (response.success) {
                    alert(response.message);
                    location.reload();
                } else {
                    alert('Error: ' + response.message);
                }
            });
        });
    </script>
}
