@model MatrixNext.Data.ViewModels.PropuestasEstadoViewModel
@{
    ViewData["Title"] = "Propuestas - Estado por Unidad";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-chart-line"></i> Estado de Propuestas por Unidad
                        @if (!string.IsNullOrEmpty(Model.Sigla) && Model.Sigla != "9")
                        {
                            var unidadNombre = Model.UnidadesDisponibles.FirstOrDefault(u => u.Sigla == Model.Sigla)?.NombreUnidad ?? Model.Sigla;
                            <span class="badge bg-light text-dark">@unidadNombre</span>
                        }
                    </h4>
                </div>
                <div class="card-body">
                    <form method="get" asp-action="EstadoUnidad" class="row g-3">
                        <div class="col-md-4">
                            <label for="sigla" class="form-label">Seleccionar Unidad <span class="text-danger">*</span></label>
                            <select name="sigla" id="sigla" class="form-select" onchange="this.form.submit()" required>
                                <option value="">Seleccione una unidad...</option>
                                @foreach (var unidad in Model.UnidadesDisponibles.Where(u => u.Sigla != "9"))
                                {
                                    <option value="@unidad.Sigla" selected="@(Model.Sigla == unidad.Sigla ? "selected" : null)">
                                        @unidad.NombreUnidad
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <a href="@Url.Action("EstadoTotal")" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left"></i> Ver Todas las Unidades
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Sigla) && Model.Sigla != "9")
    {
        <!-- Fila: Propuestas Creadas/Enviadas y Alta Probabilidad -->
        <div class="row mb-3">
            <!-- Gráfico: Propuestas Creadas/Enviadas -->
            <div class="col-lg-6 mb-3">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Propuestas Creadas / Enviadas</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.PropuestasPorUnidad.Any())
                        {
                            <canvas id="chartCreadasEnviadas" style="max-height: 400px;"></canvas>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i> No hay propuestas creadas/enviadas para esta unidad
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Gráfico: Alta Probabilidad -->
            <div class="col-lg-6 mb-3">
                <div class="card shadow-sm">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">Propuestas ALTA PROBABILIDAD</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.PropuestasAltaProbabilidad.Any())
                        {
                            <canvas id="chartAltaProbabilidad" style="max-height: 400px;"></canvas>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i> No hay propuestas de alta probabilidad para esta unidad
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Propuestas por Gerente -->
        @if (Model.PropuestasPorGerente.Any())
        {
            <div class="row">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">Creadas / Enviadas por Gerente de Cuentas</h5>
                        </div>
                        <div class="card-body">
                            <canvas id="chartPorGerente" style="max-height: 500px;"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle"></i> Seleccione una unidad para visualizar sus propuestas
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @if (!string.IsNullOrEmpty(Model.Sigla) && Model.Sigla != "9" && (Model.PropuestasPorUnidad.Any() || Model.PropuestasAltaProbabilidad.Any() || Model.PropuestasPorGerente.Any()))
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
        <script>
            // Datos del servidor
            const datosCreadasEnviadas = @Html.Raw(Json.Serialize(Model.PropuestasPorUnidad));
            const datosAltaProbabilidad = @Html.Raw(Json.Serialize(Model.PropuestasAltaProbabilidad));
            const datosPorGerente = @Html.Raw(Json.Serialize(Model.PropuestasPorGerente));

            // Gráfico 1: Propuestas Creadas/Enviadas
            @if (Model.PropuestasPorUnidad.Any())
            {
                <text>
                const ctxCreadas = document.getElementById('chartCreadasEnviadas').getContext('2d');
                new Chart(ctxCreadas, {
                    type: 'bar',
                    data: {
                        labels: datosCreadasEnviadas.map(d => d.grupoUnidad),
                        datasets: [
                            {
                                label: 'Creadas y Enviadas',
                                data: datosCreadasEnviadas.map(d => d.propuestasEnGestion),
                                backgroundColor: '#28a745',
                                borderWidth: 1
                            },
                            {
                                label: 'Por Actualizar',
                                data: datosCreadasEnviadas.map(d => d.propuestasPorActualizar),
                                backgroundColor: '#dc3545',
                                borderWidth: 1
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });
                </text>
            }

            // Gráfico 2: Alta Probabilidad
            @if (Model.PropuestasAltaProbabilidad.Any())
            {
                <text>
                const ctxAlta = document.getElementById('chartAltaProbabilidad').getContext('2d');
                new Chart(ctxAlta, {
                    type: 'bar',
                    data: {
                        labels: datosAltaProbabilidad.map(d => d.grupoUnidad),
                        datasets: [
                            {
                                label: 'Alta Probabilidad',
                                data: datosAltaProbabilidad.map(d => d.tPropuestas),
                                backgroundColor: '#28a745',
                                borderWidth: 1
                            },
                            {
                                label: 'Por Actualizar',
                                data: datosAltaProbabilidad.map(d => d.nSinActualizar),
                                backgroundColor: '#dc3545',
                                borderWidth: 1
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });
                </text>
            }

            // Gráfico 3: Por Gerente
            @if (Model.PropuestasPorGerente.Any())
            {
                <text>
                const ctxGerente = document.getElementById('chartPorGerente').getContext('2d');
                new Chart(ctxGerente, {
                    type: 'bar',
                    data: {
                        labels: datosPorGerente.map(d => d.nombreCompleto),
                        datasets: [
                            {
                                label: 'Creadas y Enviadas',
                                data: datosPorGerente.map(d => d.propuestasEnGestion),
                                backgroundColor: '#28a745',
                                borderWidth: 1
                            },
                            {
                                label: 'Por Actualizar',
                                data: datosPorGerente.map(d => d.propuestasPorActualizar),
                                backgroundColor: '#dc3545',
                                borderWidth: 1
                            }
                        ]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: { beginAtZero: true }
                        }
                    }
                });
                </text>
            }
        </script>
    }
}
