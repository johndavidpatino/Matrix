@model MatrixNext.Data.ViewModels.IndicesManualesViewModel
@{
    ViewData["Title"] = "Índices Manuales - Cuentas";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-chart-bar"></i> Índices Manuales de Cuentas
                    </h4>
                </div>
            </div>
        </div>
    </div>

    @if (Model.IndicesManuales.Any())
    {
        <!-- Gráficos de índices -->
        <div class="row">
            <!-- Gráfico CT1 -->
            <div class="col-lg-4 mb-3">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Índice CT1</h5>
                    </div>
                    <div class="card-body">
                        <canvas id="chartCT1" style="max-height: 400px;"></canvas>
                    </div>
                </div>
            </div>

            <!-- Gráfico CT2 -->
            <div class="col-lg-4 mb-3">
                <div class="card shadow-sm">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">Índice CT2</h5>
                    </div>
                    <div class="card-body">
                        <canvas id="chartCT2" style="max-height: 400px;"></canvas>
                    </div>
                </div>
            </div>

            <!-- Gráfico CT3 -->
            <div class="col-lg-4 mb-3">
                <div class="card shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">Índice CT3</h5>
                    </div>
                    <div class="card-body">
                        <canvas id="chartCT3" style="max-height: 400px;"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla detallada -->
        <div class="row mt-3">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">Detalle de Índices</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover table-sm">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Cuenta</th>
                                        <th class="text-end">Índice CT1</th>
                                        <th class="text-end">Índice CT2</th>
                                        <th class="text-end">Índice CT3</th>
                                        <th class="text-center">Año</th>
                                        <th class="text-center">Mes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.IndicesManuales)
                                    {
                                        <tr>
                                            <td>@item.IdCuenta</td>
                                            <td>@item.NombreCuenta</td>
                                            <td class="text-end">
                                                <span class="badge bg-success">@item.IndiceCT1.ToString("N2")</span>
                                            </td>
                                            <td class="text-end">
                                                <span class="badge bg-warning text-dark">@item.IndiceCT2.ToString("N2")</span>
                                            </td>
                                            <td class="text-end">
                                                <span class="badge bg-info">@item.IndiceCT3.ToString("N2")</span>
                                            </td>
                                            <td class="text-center">@item.Año</td>
                                            <td class="text-center">@item.Mes</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> No hay índices manuales registrados
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @if (Model.IndicesManuales.Any())
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
        <script>
            // Datos del servidor
            const indicesCT1 = @Html.Raw(Json.Serialize(Model.IndicesCT1));
            const indicesCT2 = @Html.Raw(Json.Serialize(Model.IndicesCT2));
            const indicesCT3 = @Html.Raw(Json.Serialize(Model.IndicesCT3));

            // Configuración común para todos los gráficos
            const commonOptions = {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y', // Gráfico horizontal
                scales: {
                    x: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Índice'
                        }
                    },
                    y: {
                        title: {
                            display: true,
                            text: 'Cuentas'
                        }
                    }
                },
                plugins: {
                    legend: {
                        display: false
                    }
                }
            };

            // Gráfico CT1
            const ctxCT1 = document.getElementById('chartCT1').getContext('2d');
            new Chart(ctxCT1, {
                type: 'bar',
                data: {
                    labels: indicesCT1.map(d => d.nombreCuenta),
                    datasets: [{
                        label: 'Índice CT1',
                        data: indicesCT1.map(d => d.indiceCT1),
                        backgroundColor: '#28a745',
                        borderColor: '#28a745',
                        borderWidth: 1
                    }]
                },
                options: commonOptions
            });

            // Gráfico CT2
            const ctxCT2 = document.getElementById('chartCT2').getContext('2d');
            new Chart(ctxCT2, {
                type: 'bar',
                data: {
                    labels: indicesCT2.map(d => d.nombreCuenta),
                    datasets: [{
                        label: 'Índice CT2',
                        data: indicesCT2.map(d => d.indiceCT2),
                        backgroundColor: '#ffc107',
                        borderColor: '#ffc107',
                        borderWidth: 1
                    }]
                },
                options: commonOptions
            });

            // Gráfico CT3
            const ctxCT3 = document.getElementById('chartCT3').getContext('2d');
            new Chart(ctxCT3, {
                type: 'bar',
                data: {
                    labels: indicesCT3.map(d => d.nombreCuenta),
                    datasets: [{
                        label: 'Índice CT3',
                        data: indicesCT3.map(d => d.indiceCT3),
                        backgroundColor: '#17a2b8',
                        borderColor: '#17a2b8',
                        borderWidth: 1
                    }]
                },
                options: commonOptions
            });
        </script>
    }
}
