@model MatrixNext.Data.ViewModels.PropuestasSinTrabajoViewModel
@{
    ViewData["Title"] = "Propuestas sin Trabajo";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-exclamation-triangle"></i> Propuestas sin entregar a Operaciones
                    </h4>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Tabla: Propuestas por Unidad -->
        <div class="col-lg-6 mb-3">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Propuestas por Unidad</h5>
                </div>
                <div class="card-body">
                    @if (Model.PropuestasPorUnidad.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover table-sm">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Unidad</th>
                                        <th class="text-end">Propuestas</th>
                                        <th class="text-end">Valor Presupuesto</th>
                                        <th>Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.PropuestasPorUnidad)
                                    {
                                        var isSelected = Model.UnidadSeleccionada == item.Unidad;
                                        <tr class="@(isSelected ? "table-warning" : "")">
                                            <td>@item.Unidad</td>
                                            <td class="text-end">
                                                <span class="badge bg-danger">@item.Propuestas</span>
                                            </td>
                                            <td class="text-end">$@item.VrPresupuesto.ToString("N0")</td>
                                            <td>
                                                <a href="@Url.Action("SinTrabajo", new { unidad = item.Unidad })"
                                                   class="btn btn-sm @(isSelected ? "btn-warning" : "btn-outline-primary")">
                                                    <i class="fas fa-search"></i> Ver Detalle
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <th>TOTAL</th>
                                        <th class="text-end">
                                            <span class="badge bg-danger">@Model.PropuestasPorUnidad.Sum(p => p.Propuestas)</span>
                                        </th>
                                        <th class="text-end">$@Model.PropuestasPorUnidad.Sum(p => p.VrPresupuesto).ToString("N0")</th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> No hay propuestas sin trabajo registradas
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Tabla: Propuestas por Metodología (cuando hay unidad seleccionada) -->
        <div class="col-lg-6 mb-3">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        Detalle por Metodología
                        @if (!string.IsNullOrEmpty(Model.UnidadSeleccionada))
                        {
                            <span class="badge bg-light text-dark">@Model.UnidadSeleccionada</span>
                        }
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.PropuestasPorMetodologia != null && Model.PropuestasPorMetodologia.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover table-sm">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Metodología</th>
                                        <th class="text-end">Propuestas</th>
                                        <th class="text-end">Valor Presupuesto</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.PropuestasPorMetodologia)
                                    {
                                        <tr>
                                            <td>@(item.Metodologia ?? "Sin Metodología")</td>
                                            <td class="text-end">
                                                <span class="badge bg-warning text-dark">@item.Propuestas</span>
                                            </td>
                                            <td class="text-end">$@item.VrPresupuesto.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <th>TOTAL</th>
                                        <th class="text-end">
                                            <span class="badge bg-warning text-dark">@Model.PropuestasPorMetodologia.Sum(p => p.Propuestas)</span>
                                        </th>
                                        <th class="text-end">$@Model.PropuestasPorMetodologia.Sum(p => p.VrPresupuesto).ToString("N0")</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <!-- Botón para volver al resumen -->
                        <div class="mt-3">
                            <a href="@Url.Action("SinTrabajo")" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left"></i> Volver al Resumen
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> Seleccione una unidad en la tabla izquierda para ver el detalle por metodología
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Gráfico resumen (solo cuando hay datos) -->
    @if (Model.PropuestasPorUnidad.Any())
    {
        <div class="row mt-3">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">Gráfico de Propuestas por Unidad</h5>
                    </div>
                    <div class="card-body">
                        <canvas id="chartPropuestasSinTrabajo" style="max-height: 400px;"></canvas>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @if (Model.PropuestasPorUnidad.Any())
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
        <script>
            // Datos del servidor
            const datosPropuestas = @Html.Raw(Json.Serialize(Model.PropuestasPorUnidad));

            // Gráfico: Propuestas sin trabajo por unidad
            const ctx = document.getElementById('chartPropuestasSinTrabajo').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: datosPropuestas.map(d => d.unidad),
                    datasets: [{
                        label: 'Propuestas sin Trabajo',
                        data: datosPropuestas.map(d => d.propuestas),
                        backgroundColor: '#dc3545',
                        borderColor: '#dc3545',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Cantidad de Propuestas'
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Unidades de Negocio'
                            }
                        }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const item = datosPropuestas[context.dataIndex];
                                    return [
                                        `Propuestas: ${item.propuestas}`,
                                        `Valor: $${item.vrPresupuesto.toLocaleString()}`
                                    ];
                                }
                            }
                        }
                    }
                }
            });
        </script>
    }
}
