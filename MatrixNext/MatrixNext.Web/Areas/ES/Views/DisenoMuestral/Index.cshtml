@model IEnumerable<MatrixNext.Data.DTOs.ES.ESDisenoMuestralOutputDto>

@{
    ViewData["Title"] = "Diseños Muestrales";
    var briefId = ViewBag.BriefId;
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-12">
            <h2>@ViewData["Title"]</h2>
            @if (briefId != null)
            {
                <p>Brief ID: @briefId</p>
            }
        </div>
    </div>

    @if (briefId != null)
    {
        <div class="row mb-3">
            <div class="col-md-12">
                <button class="btn btn-primary" onclick="abrirModalCrear(@briefId)">
                    <i class="fas fa-plus"></i> Nuevo Diseño
                </button>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-md-12">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Brief ID</th>
                        <th>Muestreo Probabilístico</th>
                        <th>Objetivo</th>
                        <th>Versión</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.BriefId</td>
                                <td>@(item.MuestroProbabilistico == true ? "Sí" : "No")</td>
                                <td>@(item.ObjetivoT != null && item.ObjetivoT.Length > 50 ? item.ObjetivoT.Substring(0, 50) + "..." : item.ObjetivoT ?? "")</td>
                                <td>@item.NumVersion</td>
                                <td>
                                    <button class="btn btn-sm btn-info" onclick="verDetalles(@item.Id)">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button class="btn btn-sm btn-warning" onclick="abrirModalEditar(@item.Id)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger" onclick="eliminar(@item.Id)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center">No hay diseños registrados</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalDiseno" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content" id="contenidoModal"></div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModalCrear(briefId) {
            $.get('@Url.Action("Create")?briefId=' + briefId, function (data) {
                $('#contenidoModal').html(data);
                $('#modalDiseno').modal('show');
            });
        }

        function abrirModalEditar(id) {
            $.get('@Url.Action("Edit")/' + id, function (data) {
                $('#contenidoModal').html(data);
                $('#modalDiseno').modal('show');
            });
        }

        function verDetalles(id) {
            $.get('@Url.Action("Details")/' + id, function (data) {
                $('#contenidoModal').html(data);
                $('#modalDiseno').modal('show');
            });
        }

        function eliminar(id) {
            if (confirm('¿Está seguro de eliminar este diseño?')) {
                $.post('@Url.Action("Delete")/' + id, {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                }, function (response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                });
            }
        }

        $(document).on('submit', '#formDiseno', function (e) {
            e.preventDefault();
            var form = $(this);
            $.ajax({
                url: form.attr('action'),
                type: form.attr('method'),
                data: form.serialize(),
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        $('#modalDiseno').modal('hide');
                        location.reload();
                    } else {
                        $('#contenidoModal').html(response);
                    }
                }
            });
        });
    </script>
}
