@model MatrixNext.Data.DTOs.ES.ESDisenoMuestralOutputDto

<div class="modal-header">
    <h5 class="modal-title">Detalles del Diseño Muestral</h5>
    <button type="button" class="close" data-dismiss="modal">
        <span>&times;</span>
    </button>
</div>

<div class="modal-body">
    <p><strong>Brief ID:</strong> @Model.BriefId</p>
    <p><strong>Versión:</strong> @Model.NumVersion</p>
    <p><strong>Muestreo Probabilístico:</strong> @(Model.MuestroProbabilistico == true ? "Sí" : "No")</p>
    
    <h6 class="mt-3">Objetivo</h6>
    <p>@Model.Objetivo</p>
    
    <h6 class="mt-3">Población</h6>
    <p>@Model.Poblacion</p>
    
    <h6 class="mt-3">Mercado</h6>
    <p>@Model.Mercado</p>
    
    <h6 class="mt-3">Marco</h6>
    <p>@Model.Marco</p>
    
    <h6 class="mt-3">Técnica</h6>
    <p>@Model.Tecnica</p>
    
    <h6 class="mt-3">Diseño</h6>
    <p>@Model.Diseno</p>
    
    @if (!string.IsNullOrEmpty(Model.Observaciones))
    {
        <h6 class="mt-3">Observaciones</h6>
        <p>@Model.Observaciones</p>
    }
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
</div>
