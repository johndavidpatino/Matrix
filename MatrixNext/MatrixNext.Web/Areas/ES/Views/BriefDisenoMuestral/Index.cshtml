@model IEnumerable<MatrixNext.Data.DTOs.ES.ESBriefDisenoMuestralOutputDto>

@{
    ViewData["Title"] = "Brief Diseño Muestral";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-12">
            <h2>@ViewData["Title"]</h2>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-12">
            <button class="btn btn-primary" onclick="abrirModalCrear()">
                <i class="fas fa-plus"></i> Nuevo Brief
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <table class="table table-striped table-hover" id="tablaBriefs">
                <thead>
                    <tr>
                        <th>ID Propuesta</th>
                        <th>Usuario Genera</th>
                        <th>Fecha Generación</th>
                        <th>Aprobado</th>
                        <th>Fecha Aprobación</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.IdPropuesta</td>
                                <td>@item.UsuarioGenera</td>
                                <td>@(item.FechaGenera?.ToString("dd/MM/yyyy HH:mm") ?? "")</td>
                                <td>
                                    @if (item.Aprobado == true)
                                    {
                                        <span class="badge badge-success">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">No</span>
                                    }
                                </td>
                                <td>@(item.FechaAprobacion?.ToString("dd/MM/yyyy HH:mm") ?? "")</td>
                                <td>
                                    <button class="btn btn-sm btn-info" onclick="verDetalles(@item.Id)">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button class="btn btn-sm btn-warning" onclick="abrirModalEditar(@item.Id)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger" onclick="eliminar(@item.Id)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">No hay briefs registrados</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="modalBrief" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="contenidoModal">
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModalCrear() {
            var propuestaId = prompt("Ingrese el ID de la propuesta:");
            if (propuestaId) {
                $.get('@Url.Action("Create")?propuestaId=' + propuestaId, function (data) {
                    $('#contenidoModal').html(data);
                    $('#modalBrief').modal('show');
                });
            }
        }

        function abrirModalEditar(id) {
            $.get('@Url.Action("Edit")/' + id, function (data) {
                $('#contenidoModal').html(data);
                $('#modalBrief').modal('show');
            });
        }

        function verDetalles(id) {
            $.get('@Url.Action("Details")/' + id, function (data) {
                $('#contenidoModal').html(data);
                $('#modalBrief').modal('show');
            });
        }

        function eliminar(id) {
            if (confirm('¿Está seguro de eliminar este brief?')) {
                $.post('@Url.Action("Delete")/' + id, {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                }, function (response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                });
            }
        }

        $(document).on('submit', '#formBrief', function (e) {
            e.preventDefault();
            var form = $(this);
            $.ajax({
                url: form.attr('action'),
                type: form.attr('method'),
                data: form.serialize(),
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        $('#modalBrief').modal('hide');
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert('Error al procesar la solicitud');
                }
            });
        });
    </script>
}
