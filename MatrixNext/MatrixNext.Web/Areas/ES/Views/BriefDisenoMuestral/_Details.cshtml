@model MatrixNext.Data.DTOs.ES.ESBriefDisenoMuestralOutputDto

<div class="modal-header">
    <h5 class="modal-title">Detalles del Brief</h5>
    <button type="button" class="close" data-dismiss="modal">
        <span>&times;</span>
    </button>
</div>

<div class="modal-body">
    <div class="row">
        <div class="col-md-6">
            <strong>ID Propuesta:</strong> @Model.IdPropuesta
        </div>
        <div class="col-md-6">
            <strong>Usuario Genera:</strong> @Model.UsuarioGenera
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-md-6">
            <strong>Fecha Generación:</strong> @(Model.FechaGenera?.ToString("dd/MM/yyyy HH:mm") ?? "")
        </div>
        <div class="col-md-6">
            <strong>Aprobado:</strong> @(Model.Aprobado == true ? "Sí" : "No")
        </div>
    </div>
    @if (Model.Aprobado == true)
    {
        <div class="row mt-2">
            <div class="col-md-6">
                <strong>Usuario Aprobación:</strong> @Model.UsuarioAprobacion
            </div>
            <div class="col-md-6">
                <strong>Fecha Aprobación:</strong> @(Model.FechaAprobacion?.ToString("dd/MM/yyyy HH:mm") ?? "")
            </div>
        </div>
    }
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
</div>
