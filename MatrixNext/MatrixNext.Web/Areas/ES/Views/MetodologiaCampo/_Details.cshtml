@model MatrixNext.Data.DTOs.ES.ESMetodologiaCampoOutputDto

<div class="modal-header">
    <h5 class="modal-title">Detalles de Metodología de Campo</h5>
    <button type="button" class="close" data-dismiss="modal">
        <span>&times;</span>
    </button>
</div>

<div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
    <p><strong>Trabajo ID:</strong> @Model.TrabajoId</p>
    <p><strong>Nombre del Estudio:</strong> @Model.NombreEstudio</p>
    <p><strong>Versión:</strong> @Model.NumVersion</p>
    <p><strong>Aprobado:</strong> @(Model.Aprobado == true ? "Sí" : "No")</p>
    
    <h6 class="mt-3">Objetivo</h6>
    <p>@Model.Objetivo</p>
    
    <h6 class="mt-3">Mercado</h6>
    <p>@Model.Mercado</p>
    
    <h6 class="mt-3">Marco</h6>
    <p>@Model.Marco</p>
    
    <h6 class="mt-3">Técnica</h6>
    <p>@Model.Tecnica</p>
    
    <h6 class="mt-3">Diseño</h6>
    <p>@Model.Diseno</p>
    
    <h6 class="mt-3">Instrucciones</h6>
    <p>@Model.Instrucciones</p>
    
    <h6 class="mt-3">Distribución</h6>
    <p>@(Model.Distribucion ? "Sí" : "No")</p>
    
    @if (!string.IsNullOrEmpty(Model.NivelConfianzaT))
    {
        <h6 class="mt-3">Nivel de Confianza</h6>
        <p>@Model.NivelConfianzaT</p>
    }
    
    @if (!string.IsNullOrEmpty(Model.MargenErrorT))
    {
        <h6 class="mt-3">Margen de Error</h6>
        <p>@Model.MargenErrorT</p>
    }
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
</div>
