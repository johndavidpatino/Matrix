@model MatrixNext.Data.Modules.CU.Proyectos.Models.ProyectosIndexViewModel
@{
    ViewData["Title"] = "Proyectos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Breadcrumb y título -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0">
                <i class="ri-folder-line me-2"></i>Proyectos
                @if (Model.EstudioId.HasValue)
                {
                    <small class="text-muted">- Estudio #@Model.EstudioId</small>
                }
            </h4>
        </div>
        <div>
            <a asp-area="CU" asp-controller="Estudios" asp-action="Index" class="btn btn-outline-secondary me-2">
                <i class="ri-arrow-left-line"></i> Volver a Estudios
            </a>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalProyecto"
                    onclick="cargarModalProyecto(0)">
                <i class="ri-add-line"></i> Nuevo Proyecto
            </button>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card mb-3">
        <div class="card-body">
            <form id="formFiltros" class="row g-3">
                <input type="hidden" name="estudioId" value="@Model.EstudioId" />
                <div class="col-md-3">
                    <label class="form-label">JobBook</label>
                    <input type="text" class="form-control" name="jobBook" placeholder="Buscar por JobBook..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Nombre</label>
                    <input type="text" class="form-control" name="nombre" placeholder="Buscar por nombre..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Tipo Proyecto</label>
                    <select class="form-select" name="tipoProyectoId">
                        <option value="">Todos</option>
                        @foreach (var tipo in Model.TiposProyecto)
                        {
                            <option value="@tipo.Id">@tipo.TipoProyecto</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="ri-search-line"></i> Buscar
                    </button>
                    <button type="reset" class="btn btn-outline-secondary" onclick="limpiarFiltros()">
                        <i class="ri-refresh-line"></i> Limpiar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Lista de proyectos -->
    <div class="card">
        <div class="card-body">
            <div id="tablaProyectos">
                <partial name="_ListaProyectos" model="Model.Proyectos" />
            </div>
        </div>
    </div>
</div>

<!-- Modal Crear/Editar Proyecto -->
<div class="modal fade" id="modalProyecto" tabindex="-1" aria-labelledby="modalProyectoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalProyectoLabel">Proyecto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalProyectoBody">
                <!-- Contenido cargado vía AJAX -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Cargar modal de proyecto
    function cargarModalProyecto(id) {
        const estudioId = @(Model.EstudioId ?? 0);
        const url = `@Url.Action("CreateEdit", "Proyectos", new { area = "CU" })?id=${id}&estudioId=${estudioId}`;
        
        $('#modalProyectoBody').html('<div class="text-center p-4"><div class="spinner-border"></div></div>');
        $('#modalProyectoLabel').text(id > 0 ? 'Editar Proyecto' : 'Nuevo Proyecto');
        
        $.get(url, function(html) {
            $('#modalProyectoBody').html(html);
        }).fail(function(xhr) {
            $('#modalProyectoBody').html('<div class="alert alert-danger">Error al cargar el formulario</div>');
        });
    }

    // Buscar proyectos
    $('#formFiltros').on('submit', function(e) {
        e.preventDefault();
        buscarProyectos();
    });

    function buscarProyectos() {
        const formData = $('#formFiltros').serialize();
        $.get('@Url.Action("Buscar", "Proyectos", new { area = "CU" })?' + formData, function(html) {
            $('#tablaProyectos').html(html);
        });
    }

    function limpiarFiltros() {
        $('#formFiltros')[0].reset();
        buscarProyectos();
    }

    // Guardar proyecto
    $(document).on('submit', '#formProyecto', function(e) {
        e.preventDefault();
        
        const form = $(this);
        const submitBtn = form.find('button[type="submit"]');
        const originalText = submitBtn.html();
        
        submitBtn.html('<span class="spinner-border spinner-border-sm"></span> Guardando...').prop('disabled', true);
        
        $.ajax({
            url: '@Url.Action("Guardar", "Proyectos", new { area = "CU" })',
            type: 'POST',
            data: form.serialize(),
            success: function(response) {
                if (response.success) {
                    $('#modalProyecto').modal('hide');
                    showToast(response.message, 'success');
                    buscarProyectos();
                } else {
                    showToast(response.message, 'error');
                }
            },
            error: function() {
                showToast('Error al guardar el proyecto', 'error');
            },
            complete: function() {
                submitBtn.html(originalText).prop('disabled', false);
            }
        });
    });

    // Toast de notificación
    function showToast(message, type) {
        const toastClass = type === 'success' ? 'bg-success' : 'bg-danger';
        const toast = $(`
            <div class="toast align-items-center text-white ${toastClass} border-0" role="alert">
                <div class="d-flex">
                    <div class="toast-body">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        `);
        
        let container = $('.toast-container');
        if (container.length === 0) {
            container = $('<div class="toast-container position-fixed top-0 end-0 p-3"></div>');
            $('body').append(container);
        }
        
        container.append(toast);
        const bsToast = new bootstrap.Toast(toast[0]);
        bsToast.show();
        
        toast.on('hidden.bs.toast', function() {
            $(this).remove();
        });
    }
</script>
}
