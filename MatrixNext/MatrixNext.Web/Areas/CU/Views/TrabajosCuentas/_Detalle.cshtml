@model MatrixNext.Data.Modules.CU.TrabajosCuentas.Models.TrabajoCuentaDto

<div class="row g-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="ri-information-line me-2"></i>Información General</h6>
            </div>
            <div class="card-body">
                <table class="table table-sm table-borderless">
                    <tr>
                        <th width="40%">ID:</th>
                        <td>@Model.Id</td>
                    </tr>
                    <tr>
                        <th>JobBook:</th>
                        <td><span class="badge bg-primary">@Model.JobBook</span></td>
                    </tr>
                    <tr>
                        <th>Nombre:</th>
                        <td>@Model.NombreTrabajo</td>
                    </tr>
                    <tr>
                        <th>Estado:</th>
                        <td><span class="badge bg-info">@Model.EstadoTrabajo</span></td>
                    </tr>
                    <tr>
                        <th>Metodología:</th>
                        <td>@Model.Metodologia</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="ri-team-line me-2"></i>Asignaciones</h6>
            </div>
            <div class="card-body">
                <table class="table table-sm table-borderless">
                    <tr>
                        <th width="40%">Unidad:</th>
                        <td>@Model.NombreUnidad</td>
                    </tr>
                    <tr>
                        <th>Gerencia:</th>
                        <td>@Model.GerenciaOperativa</td>
                    </tr>
                    <tr>
                        <th>Gerente Proy.:</th>
                        <td>@Model.GerenteProyectos</td>
                    </tr>
                    <tr>
                        <th>COE Asignado:</th>
                        <td>
                            @if (!string.IsNullOrEmpty(Model.CoeAsignado))
                            {
                                <span class="badge bg-success">@Model.CoeAsignado</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Sin asignar</span>
                            }
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
    
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="ri-calendar-line me-2"></i>Fechas y Muestra</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <label class="text-muted small">Fecha Inicio</label>
                        <p class="mb-0 fw-bold">@(Model.FechaInicio?.ToString("dd/MM/yyyy") ?? "-")</p>
                    </div>
                    <div class="col-md-3">
                        <label class="text-muted small">Fecha Fin</label>
                        <p class="mb-0 fw-bold">@(Model.FechaFin?.ToString("dd/MM/yyyy") ?? "-")</p>
                    </div>
                    <div class="col-md-3">
                        <label class="text-muted small">Muestra Estimada</label>
                        <p class="mb-0 fw-bold">@(Model.Muestra?.ToString("N0") ?? "-")</p>
                    </div>
                    <div class="col-md-3">
                        <label class="text-muted small">Muestra Real</label>
                        <p class="mb-0 fw-bold">@(Model.MuestraReal?.ToString("N0") ?? "-")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal-footer mt-3">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
    <button type="button" class="btn btn-primary" onclick="verCronograma(@Model.Id)">
        <i class="ri-calendar-line"></i> Ver Cronograma
    </button>
    <button type="button" class="btn btn-success" onclick="verAvance(@Model.Id)">
        <i class="ri-bar-chart-line"></i> Ver Avance
    </button>
</div>
