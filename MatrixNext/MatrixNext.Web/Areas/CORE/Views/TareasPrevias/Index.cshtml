@model List<MatrixNext.Web.Models.CORE.TareaPrevía>

<h2>Tareas Previas</h2>

<p>
    <a href="#" class="btn btn-primary"
       data-modal-url="@Url.Action("CreateModal")"
       data-modal-title="Crear relación">Crear relación</a>
    <a class="btn btn-secondary" href="@Url.Action("Index","WorkFlow")">WorkFlow</a>
</p>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Id</th>
            <th>IdTarea</th>
            <th>IdTareaPreviaRequerida</th>
            <th>Orden</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.IdTarea</td>
                <td>@item.IdTareaPreviaRequerida</td>
                <td>@item.Orden</td>
            </tr>
        }
    </tbody>
</table>
