@model MatrixNext.Web.Models.CORE.TareaPrevía

<form asp-action="Create" method="post" data-ajax="true">
    <div class="row g-3">
        <div class="col-sm-6">
            <label class="form-label">IdTarea</label>
            <input asp-for="IdTarea" class="form-control" />
        </div>
        <div class="col-sm-6">
            <label class="form-label">IdTareaPreviaRequerida</label>
            <input asp-for="IdTareaPreviaRequerida" class="form-control" />
        </div>
        <div class="col-sm-6">
            <label class="form-label">Orden</label>
            <input asp-for="Orden" class="form-control" />
        </div>
        <div class="col-12 text-danger" asp-validation-summary="ModelOnly"></div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
    </div>
</form>
