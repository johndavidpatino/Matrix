@model MatrixNext.Web.Models.CORE.TareaPrevía

<form asp-action="Create" method="post" data-ajax="true">
    <div class="row g-3">
        <div class="col-sm-6">
            <label class="form-label">IdTarea</label>
            <select asp-for="IdTarea" class="form-select lookup-tarea" data-lookup-url="@Url.Action("Lookup", "Tareas", new { area = "CORE" })">
                @if (Model.IdTarea != 0)
                {
                    <option value="@Model.IdTarea" selected>Tarea #@Model.IdTarea</option>
                }
                else
                {
                    <option value="">-- Seleccionar --</option>
                }
            </select>
            <small class="text-muted">Tarea que depende de otra</small>
        </div>
        <div class="col-sm-6">
            <label class="form-label">IdTareaPreviaRequerida</label>
            <select asp-for="IdTareaPreviaRequerida" class="form-select lookup-tarea" data-lookup-url="@Url.Action("Lookup", "Tareas", new { area = "CORE" })">
                @if (Model.IdTareaPreviaRequerida != 0)
                {
                    <option value="@Model.IdTareaPreviaRequerida" selected>Tarea #@Model.IdTareaPreviaRequerida</option>
                }
                else
                {
                    <option value="">-- Seleccionar --</option>
                }
            </select>
            <small class="text-muted">Tarea previa requerida</small>
        </div>
        <div class="col-sm-6">
            <label class="form-label">Orden</label>
            <input asp-for="Orden" class="form-control" />
        </div>
        <div class="col-12 text-danger" asp-validation-summary="ModelOnly"></div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
    </div>
</form>
