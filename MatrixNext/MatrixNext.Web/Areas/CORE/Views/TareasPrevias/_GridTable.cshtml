@model List<MatrixNext.Web.Models.CORE.TareaPrevía>

<table class="table table-striped table-sm mb-2">
    <thead>
        <tr>
            <th>Id</th>
            <th>IdTarea</th>
            <th>IdTareaPreviaRequerida</th>
            <th>Orden</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.IdTarea</td>
                <td>@item.IdTareaPreviaRequerida</td>
                <td>@item.Orden</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No hay relaciones de precedencia registradas.</p>
}
