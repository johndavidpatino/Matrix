@model PaginationResultVM<Tarea>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th style="width: 5%">Orden</th>
                <th style="width: 30%">Nombre</th>
                <th style="width: 10%">Tiempo Prom.</th>
                <th style="width: 12%">Unidad Ejecuta</th>
                <th style="width: 12%">Rol Ejecuta</th>
                <th style="width: 8%">Estimación</th>
                <th style="width: 8%">Visible</th>
                <th style="width: 15%" class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Any())
            {
                @foreach (var tarea in Model.Items)
                {
                    <tr>
                        <td>@tarea.Orden</td>
                        <td>
                            <strong>@tarea.Nombre</strong>
                            @if (tarea.NoEmpiezaAntesDe.HasValue || tarea.NoTerminaAntesDe.HasValue)
                            {
                                <br />
                                <small class="text-muted">
                                    @if (tarea.NoEmpiezaAntesDe.HasValue)
                                    {
                                        <span>Inicia: +@tarea.NoEmpiezaAntesDe días</span>
                                    }
                                    @if (tarea.NoTerminaAntesDe.HasValue)
                                    {
                                        <span>Termina: +@tarea.NoTerminaAntesDe días</span>
                                    }
                                </small>
                            }
                        </td>
                        <td>
                            @if (tarea.TiempoPromedioDias.HasValue)
                            {
                                <span>@tarea.TiempoPromedioDias días</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (tarea.UnidadEjecuta.HasValue)
                            {
                                <span>Unidad @tarea.UnidadEjecuta</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (tarea.RolEjecuta.HasValue)
                            {
                                <span>Rol @tarea.RolEjecuta</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (tarea.RequiereEstimacion == true)
                            {
                                <span class="badge bg-info">Sí</span>
                                @if (tarea.RolEstima.HasValue)
                                {
                                    <br /><small>Rol @tarea.RolEstima</small>
                                }
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </td>
                        <td>
                            @if (tarea.Visible == true)
                            {
                                <span class="badge bg-success">Sí</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">No</span>
                            }
                        </td>
                        <td class="text-end">
                            <button type="button" 
                                    class="btn btn-sm btn-outline-primary" 
                                    data-ajax-modal-url="@Url.Action("EditModal", "TareasConfig", new { area = "CORE", id = tarea.Id })"
                                    data-ajax-modal-title="Editar Tarea">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button type="button" 
                                    class="btn btn-sm btn-outline-danger"
                                    onclick="eliminarTarea(@tarea.Id, '@tarea.Nombre')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        No se encontraron tareas
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Paginación -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="Paginación">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link" href="?pageNumber=@(Model.PageNumber - 1)">Anterior</a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="?pageNumber=@i">@i</a>
                </li>
            }

            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="?pageNumber=@(Model.PageNumber + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>

    <p class="text-center text-muted">
        Mostrando @Model.Items.Count() de @Model.TotalCount registros (Página @Model.PageNumber de @Model.TotalPages)
    </p>
}

<script>
function eliminarTarea(id, nombre) {
    if (!confirm(`¿Está seguro de eliminar la tarea "${nombre}"?\n\nEsta acción no se puede deshacer.`)) {
        return;
    }

    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '@Url.Action("Delete", "TareasConfig", new { area = "CORE" })';
    
    const inputId = document.createElement('input');
    inputId.type = 'hidden';
    inputId.name = 'id';
    inputId.value = id;
    form.appendChild(inputId);

    const token = document.querySelector('input[name="__RequestVerificationToken"]');
    if (token) {
        form.appendChild(token.cloneNode());
    }

    document.body.appendChild(form);

    fetch(form.action, {
        method: 'POST',
        body: new FormData(form)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showToast(data.message, 'success');
            refreshGrid();
        } else {
            showToast(data.message, 'danger');
        }
        document.body.removeChild(form);
    })
    .catch(error => {
        showToast('Error al eliminar tarea: ' + error, 'danger');
        document.body.removeChild(form);
    });
}
</script>
