@model Tarea

<form method="post" data-ajax="true" data-ajax-success="onModalFormSuccess">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    <div class="row g-3">
        <!-- Nombre -->
        <div class="col-12">
            <label asp-for="Nombre" class="form-label">Nombre de la Tarea *</label>
            <input asp-for="Nombre" class="form-control" required maxlength="500" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <!-- Orden y Visible -->
        <div class="col-md-6">
            <label asp-for="Orden" class="form-label">Orden de Presentación</label>
            <input asp-for="Orden" type="number" class="form-control" min="0" />
            <span asp-validation-for="Orden" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label">Estado</label>
            <div class="form-check form-switch">
                <input asp-for="Visible" class="form-check-input" type="checkbox" role="switch" />
                <label asp-for="Visible" class="form-check-label">Visible en listados</label>
            </div>
        </div>

        <!-- Tiempos -->
        <div class="col-md-4">
            <label asp-for="NoEmpiezaAntesDe" class="form-label">No empieza antes de (días)</label>
            <input asp-for="NoEmpiezaAntesDe" type="number" class="form-control" min="0" />
            <small class="text-muted">Días desde inicio del hilo</small>
        </div>

        <div class="col-md-4">
            <label asp-for="NoTerminaAntesDe" class="form-label">No termina antes de (días)</label>
            <input asp-for="NoTerminaAntesDe" type="number" class="form-control" min="0" />
            <small class="text-muted">Días desde inicio del hilo</small>
        </div>

        <div class="col-md-4">
            <label asp-for="TiempoPromedioDias" class="form-label">Tiempo Promedio (días)</label>
            <input asp-for="TiempoPromedioDias" type="number" class="form-control" min="0" />
            <small class="text-muted">Duración estimada</small>
        </div>

        <!-- Estimación -->
        <div class="col-md-6">
            <label class="form-label">Estimación</label>
            <div class="form-check form-switch">
                <input asp-for="RequiereEstimacion" class="form-check-input" type="checkbox" role="switch" />
                <label asp-for="RequiereEstimacion" class="form-check-label">Requiere estimación de tiempo</label>
            </div>
        </div>

        <div class="col-md-6">
            <label asp-for="RolEstima" class="form-label">Rol que Estima</label>
            <input asp-for="RolEstima" type="number" class="form-control" min="0" />
            <small class="text-muted">ID del rol responsable de estimar</small>
        </div>

        <!-- Unidades y Roles -->
        <div class="col-md-6">
            <label asp-for="UnidadEjecuta" class="form-label">Unidad que Ejecuta</label>
            <input asp-for="UnidadEjecuta" type="number" class="form-control" min="0" />
            <small class="text-muted">ID de la unidad responsable</small>
        </div>

        <div class="col-md-6">
            <label asp-for="UnidadRecibe" class="form-label">Unidad que Recibe</label>
            <input asp-for="UnidadRecibe" type="number" class="form-control" min="0" />
            <small class="text-muted">ID de la unidad destinataria</small>
        </div>

        <div class="col-md-6">
            <label asp-for="RolEjecuta" class="form-label">Rol que Ejecuta</label>
            <input asp-for="RolEjecuta" type="number" class="form-control" min="0" />
            <small class="text-muted">ID del rol ejecutor</small>
        </div>

        <!-- Botones -->
        <div class="col-12">
            <hr />
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
