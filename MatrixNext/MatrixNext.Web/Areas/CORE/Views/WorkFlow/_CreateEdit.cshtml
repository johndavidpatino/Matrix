@model MatrixNext.Web.Models.CORE.WorkFlow

<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post" data-ajax="true">
    @if (Model.Id != 0) { <input type="hidden" asp-for="Id" /> }
    <div class="row g-3">
        <div class="col-sm-6">
            <label class="form-label">IdTrabajo</label>
            <select asp-for="IdTrabajo" class="form-select lookup-trabajo" data-lookup-url="@Url.Action("Lookup", "Trabajos", new { area = "PY" })">
                @if (Model.IdTrabajo != 0)
                {
                    <option value="@Model.IdTrabajo" selected>Trabajo #@Model.IdTrabajo</option>
                }
                else
                {
                    <option value="">-- Seleccionar --</option>
                }
            </select>
            <small class="text-muted">Buscar por JobBook o nombre</small>
        </div>
        <div class="col-sm-6">
            <label class="form-label">IdTarea</label>
            <select asp-for="IdTarea" class="form-select lookup-tarea" data-lookup-url="@Url.Action("Lookup", "Tareas", new { area = "CORE" })">
                @if (Model.IdTarea != 0)
                {
                    <option value="@Model.IdTarea" selected>Tarea #@Model.IdTarea</option>
                }
                else
                {
                    <option value="">-- Seleccionar --</option>
                }
            </select>
            <small class="text-muted">Buscar por ID o nombre</small>
        </div>
        <div class="col-sm-6">
            <label class="form-label">Estado</label>
            <input asp-for="Estado" class="form-control" />
        </div>
        <div class="col-sm-6">
            <label class="form-label">Prioridad</label>
            <input asp-for="Prioridad" class="form-control" />
        </div>
        <div class="col-12 text-danger" asp-validation-summary="ModelOnly"></div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
    </div>
</form>
