@using MatrixNext.Web.ViewModels
@model PaginationResultVM<MatrixNext.Web.Models.CORE.WorkFlow>

@{
    ViewBag.Title = "WorkFlow";
}

<h2>WorkFlow</h2>

<p>
    <a class="btn btn-primary" href="@Url.Action("Create")">Crear</a>
    <a class="btn btn-secondary" href="@Url.Action("Index","TareasPrevias")">Tareas Previas</a>
    </p>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Id</th>
            <th>IdTrabajo</th>
            <th>IdTarea</th>
            <th>Estado</th>
            <th>Prioridad</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.IdTrabajo</td>
            <td>@item.IdTarea</td>
            <td>@item.Estado</td>
            <td>@item.Prioridad</td>
            <td>
                <a class="btn btn-link" href="@Url.Action("Edit", new { id = item.Id })">Editar</a>
            </td>
        </tr>
    }
    </tbody>
</table>

<nav>
    <ul class="pagination">
        @if (Model.HasPreviousPage)
        {
            <li class="page-item"><a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber - 1, size = Model.PageSize })">Anterior</a></li>
        }
        <li class="page-item disabled"><span class="page-link">Página @Model.PageNumber de @Model.TotalPages</span></li>
        @if (Model.HasNextPage)
        {
            <li class="page-item"><a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber + 1, size = Model.PageSize })">Siguiente</a></li>
        }
    </ul>
    <span class="text-muted">Total: @Model.TotalRecords</span>
</nav>
