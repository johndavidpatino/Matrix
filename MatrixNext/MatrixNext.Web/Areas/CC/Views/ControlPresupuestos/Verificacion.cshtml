@model IEnumerable<MatrixNext.Data.Modules.CC.DTOs.ControlPresupuestos.VerificacionPresupuestoDto>
@{
    ViewData["Title"] = "Verificación de Presupuestos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h3>Verificación: Presupuesto vs. Realizado</h3>
        </div>
        <div class="col-md-4 text-end">
            <button class="btn btn-sm btn-secondary" id="btn-exportar-verificacion">
                <i class="fas fa-download"></i> Exportar
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <!-- Resumen -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <h6 class="card-title">Total Presupuesto</h6>
                            <h4 id="total-presupuesto">$ 0</h4>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-info text-white">
                        <div class="card-body">
                            <h6 class="card-title">Total Realizado</h6>
                            <h4 id="total-realizado">$ 0</h4>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-warning text-white">
                        <div class="card-body">
                            <h6 class="card-title">Total Varianza</h6>
                            <h4 id="total-varianza">$ 0</h4>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body">
                            <h6 class="card-title">% Promedio Varianza</h6>
                            <h4 id="promedio-varianza">0%</h4>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tabla -->
            <div class="table-responsive">
                <table class="table table-hover table-striped" id="grid-verificacion">
                    <thead class="table-light">
                        <tr>
                            <th>Período</th>
                            <th>Trabajo</th>
                            <th class="text-end">Presupuesto</th>
                            <th class="text-end">Realizado</th>
                            <th class="text-end">Varianza</th>
                            <th class="text-end">% Varianza</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-verificacion">
                        @foreach (var item in Model ?? Enumerable.Empty<MatrixNext.Data.Modules.CC.DTOs.ControlPresupuestos.VerificacionPresupuestoDto>())
                        {
                            <tr>
                                <td>@item.Periodo</td>
                                <td>@item.NombreTrabajo</td>
                                <td class="text-end">@item.MontoPresupuesto.ToString("C0")</td>
                                <td class="text-end">@item.MontoRealizado.ToString("C0")</td>
                                <td class="text-end @(item.Varianza > 0 ? "text-danger" : "text-success")">
                                    @item.Varianza.ToString("C0")
                                </td>
                                <td class="text-end @(item.PorcentajeVarianza > 0 ? "text-danger" : "text-success")">
                                    @item.PorcentajeVarianza.ToString("0.00")%
                                </td>
                                <td><span class="badge bg-secondary">@item.Estado</span></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" onclick="verDetalles('@item.IdPresupuesto')">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            calcularTotales();
        });

        function calcularTotales() {
            let totalPresupuesto = 0;
            let totalRealizado = 0;
            let totalVarianza = 0;
            let cantidadRegistros = 0;

            $('#tbody-verificacion tr').each(function () {
                const presupuesto = parseFloat($(this).find('td').eq(2).text().replace(/[^0-9.-]/g, ''));
                const realizado = parseFloat($(this).find('td').eq(3).text().replace(/[^0-9.-]/g, ''));
                const varianza = parseFloat($(this).find('td').eq(4).text().replace(/[^0-9.-]/g, ''));

                totalPresupuesto += presupuesto;
                totalRealizado += realizado;
                totalVarianza += varianza;
                cantidadRegistros++;
            });

            $('#total-presupuesto').text(formatCurrency(totalPresupuesto));
            $('#total-realizado').text(formatCurrency(totalRealizado));
            $('#total-varianza').text(formatCurrency(totalVarianza));
            $('#promedio-varianza').text((totalVarianza / (totalPresupuesto || 1) * 100).toFixed(2) + '%');
        }

        function formatCurrency(value) {
            return new Intl.NumberFormat('es-CO', {
                style: 'currency',
                currency: 'COP',
                minimumFractionDigits: 0
            }).format(value);
        }

        function verDetalles(id) {
            window.location.href = `/CC/ControlPresupuestos?id=${id}`;
        }
    </script>
}
