@{
    ViewData["Title"] = "Revisar Bonificación";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-4">
    <h1><i class="fas fa-check-double mr-2"></i>Revisar Generación de Bonificación</h1>
    
    <div class="row mb-4 mt-3">
        <div class="col-md-3">
            <div class="card metric-card" style="border-left: 4px solid #4472C4;">
                <div class="card-body text-center">
                    <h6>Por Revisar</h6>
                    <h3 id="m1" class="text-primary">0</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card metric-card" style="border-left: 4px solid #70AD47;">
                <div class="card-body text-center">
                    <h6>Aprobadas</h6>
                    <h3 id="m2" class="text-success">0</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card metric-card" style="border-left: 4px solid #FFC000;">
                <div class="card-body text-center">
                    <h6>Bonos Total</h6>
                    <h3 id="m3" class="text-warning">$0</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card metric-card" style="border-left: 4px solid #FF5050;">
                <div class="card-body text-center">
                    <h6>% Aprobación</h6>
                    <h3 id="m4" class="text-danger">0%</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-light">
            <h5><i class="fas fa-filter mr-2"></i>Filtros</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3"><label>Período</label><input type="month" id="p" class="form-control"></div>
                <div class="col-md-3"><label>Empleado</label><input type="number" id="e" class="form-control"></div>
                <div class="col-md-3"><label>Trabajo</label><input type="number" id="t" class="form-control"></div>
                <div class="col-md-3"><label>Estado</label><select id="s" class="form-control"><option value="">Todos</option><option value="1">No Aprobada</option><option value="0">Aprobada</option></select></div>
            </div>
            <button id="b" class="btn btn-primary mt-3" style="margin-right:5px;">Buscar</button>
            <button id="x" class="btn btn-success mt-3">Exportar</button>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <table id="tbl" class="table table-striped">
                <thead class="thead-dark">
                    <tr>
                        <th>ID</th><th>Período</th><th>Empleado</th><th>Salario</th><th>Producción</th>
                        <th>Bono C.</th><th>Bono F.</th><th>Generación</th><th>Revisión</th><th>Aprobada</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function() {
            const t = $('#tbl').DataTable({
                language:{url:'//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'},pageLength:10,
                columns:[{data:'idBonificacion'},{data:'periodo'},{data:'nombreEmpleado'},
                {data:'salarioBase',render:$.fn.dataTable.render.number(',','.',2,'$')},
                {data:'produccionTotal',render:$.fn.dataTable.render.number(',','.',2,'$')},
                {data:'bonoCalculado',render:$.fn.dataTable.render.number(',','.',2,'$')},
                {data:'bonoFinal',render:$.fn.dataTable.render.number(',','.',2,'$')},
                {data:'fechaGeneracion',render:(d)=>new Date(d).toLocaleDateString('es-CO')},
                {data:'fechaRevision',render:(d)=>d?new Date(d).toLocaleDateString('es-CO'):'--'},
                {data:'aprobada',render:(d)=>d?'<span class="badge badge-success">Sí</span>':'<span class="badge badge-danger">No</span>'}]
            });

            $('#b').click(()=>{
                $.ajax({type:'POST',url:'@Url.Action("ObtenerBonificaciones","RevisarGeneracionBonificacion")',
                contentType:'application/json',
                data:JSON.stringify({periodo:$('#p').val()?parseInt($('#p').val().replace('-','')):null,idEmpleado:$('#e').val()?parseInt($('#e').val()):null,idTrabajo:$('#t').val()?parseInt($('#t').val()):null,aprobada:$('#s').val()?($('#s').val()=='1'?false:true):null}),
                success:r=>{if(r.success){t.clear().rows.add(r.data).draw();const apb=r.data.filter(x=>x.aprobada).length;const tot=r.data.reduce((s,x)=>s+(x.bonoFinal||0),0);$('#m1').text(r.data.length-apb);$('#m2').text(apb);$('#m3').text('$'+tot.toLocaleString('es-CO',{minimumFractionDigits:2}));$('#m4').text((r.data.length>0?(apb/r.data.length*100):0).toFixed(1)+'%');}}});
            });

            $('#x').click(()=>{const p=new URLSearchParams();if($('#p').val())p.append('periodo',parseInt($('#p').val().replace('-','')));if($('#e').val())p.append('idEmpleado',$('#e').val());if($('#t').val())p.append('idTrabajo',$('#t').val());if($('#s').val())p.append('aprobada',$('#s').val()=='0');window.location='@Url.Action("Exportar","RevisarGeneracionBonificacion")?' + p;});
        });
    </script>
}
