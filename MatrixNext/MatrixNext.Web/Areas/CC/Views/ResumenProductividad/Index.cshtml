@{
    ViewData["Title"] = "Resumen de Productividad";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold text-primary">
                <i class="bi bi-bar-chart-line"></i> Resumen de Productividad
            </h2>
            <p class="text-muted">Análisis de productividad por trabajo y actividad</p>
        </div>
    </div>

    <!-- Cards de Métricas Globales -->
    <div class="row mb-4" id="metricsContainer">
        <div class="col-md-2">
            <div class="card shadow-sm bg-primary text-white">
                <div class="card-body">
                    <h6 class="card-title">Trabajos</h6>
                    <h4 class="mb-0" id="metricTrabajos">0</h4>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm bg-success text-white">
                <div class="card-body">
                    <h6 class="card-title">Total Unidades</h6>
                    <h4 class="mb-0" id="metricUnidades">0</h4>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm bg-info text-white">
                <div class="card-body">
                    <h6 class="card-title">Total Horas</h6>
                    <h4 class="mb-0" id="metricHoras">0</h4>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm bg-warning text-dark">
                <div class="card-body">
                    <h6 class="card-title">Prod. Global</h6>
                    <h4 class="mb-0" id="metricProductividad">0.00</h4>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm bg-danger text-white">
                <div class="card-body">
                    <h6 class="card-title">Costo Total</h6>
                    <h4 class="mb-0" id="metricCosto">$0</h4>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm bg-secondary text-white">
                <div class="card-body">
                    <h6 class="card-title">Empleados</h6>
                    <h4 class="mb-0" id="metricEmpleados">0</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <i class="bi bi-funnel"></i> Filtros de Búsqueda
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-2">
                    <label for="filtroPeriodo" class="form-label">Período</label>
                    <input type="number" class="form-control" id="filtroPeriodo" placeholder="2025" />
                </div>
                <div class="col-md-3">
                    <label for="filtroFechaInicio" class="form-label">Fecha Inicio</label>
                    <input type="date" class="form-control" id="filtroFechaInicio" />
                </div>
                <div class="col-md-3">
                    <label for="filtroFechaFin" class="form-label">Fecha Fin</label>
                    <input type="date" class="form-control" id="filtroFechaFin" />
                </div>
                <div class="col-md-2">
                    <label for="filtroActividad" class="form-label">Actividad</label>
                    <input type="text" class="form-control" id="filtroActividad" placeholder="Código" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-primary me-2" id="btnBuscar">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="btnLimpiar">
                        <i class="bi bi-x-circle"></i> Limpiar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Botón Exportar -->
    <div class="mb-3">
        <button type="button" class="btn btn-success" id="btnExportar">
            <i class="bi bi-file-excel"></i> Exportar a Excel
        </button>
    </div>

    <!-- Grid de Productividad -->
    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table id="tableProductividad" class="table table-hover table-striped w-100">
                    <thead class="table-dark">
                        <tr>
                            <th>Período</th>
                            <th>Código Trabajo</th>
                            <th>Nombre Trabajo</th>
                            <th>Actividad</th>
                            <th>Total Unidades</th>
                            <th>Total Horas</th>
                            <th>Productividad</th>
                            <th>Costo Total</th>
                            <th>Costo Unit.</th>
                            <th>Empleados</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let table;

            // Inicializar DataTable
            function initDataTable() {
                if ($.fn.DataTable.isDataTable('#tableProductividad')) {
                    $('#tableProductividad').DataTable().destroy();
                }

                table = $('#tableProductividad').DataTable({
                    language: {
                        url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                    },
                    data: [],
                    columns: [
                        { data: 'periodo' },
                        { data: 'codigoTrabajo' },
                        { data: 'nombreTrabajo' },
                        { 
                            data: null,
                            render: function(data, type, row) {
                                return `${row.codigoActividad || '-'} - ${row.nombreActividad || '-'}`;
                            }
                        },
                        {
                            data: 'totalUnidades',
                            render: function (data) {
                                return parseFloat(data).toLocaleString('es-CO');
                            }
                        },
                        {
                            data: 'totalHoras',
                            render: function (data) {
                                return parseFloat(data).toLocaleString('es-CO');
                            }
                        },
                        {
                            data: 'productividadPromedio',
                            render: function (data) {
                                const prod = parseFloat(data);
                                let colorClass = '';
                                if (prod < 5) colorClass = 'text-danger fw-bold';
                                else if (prod >= 10) colorClass = 'text-success fw-bold';
                                else colorClass = 'text-warning fw-bold';
                                
                                return `<span class="${colorClass}">${prod.toFixed(2)}</span>`;
                            }
                        },
                        {
                            data: 'costoTotal',
                            render: function (data) {
                                return '$' + parseFloat(data).toLocaleString('es-CO', { minimumFractionDigits: 2 });
                            }
                        },
                        {
                            data: 'costoUnitario',
                            render: function (data) {
                                return '$' + parseFloat(data).toLocaleString('es-CO', { minimumFractionDigits: 2 });
                            }
                        },
                        { data: 'numeroEmpleados' }
                    ],
                    order: [[0, 'desc']],
                    pageLength: 25,
                    responsive: true
                });
            }

            // Cargar datos
            function cargarProductividad() {
                const filtros = {
                    periodo: $('#filtroPeriodo').val() ? parseInt($('#filtroPeriodo').val()) : null,
                    fechaInicio: $('#filtroFechaInicio').val() || null,
                    fechaFin: $('#filtroFechaFin').val() || null,
                    codigoActividad: $('#filtroActividad').val() || null
                };

                $.ajax({
                    url: '@Url.Action("ObtenerResumen")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(filtros)
                })
                    .done(function (response) {
                        if (response.success) {
                            table.clear().rows.add(response.data).draw();
                            actualizarMetricas(response.data);
                        } else {
                            toastr.error(response.message || 'Error cargando productividad');
                        }
                    })
                    .fail(function () {
                        toastr.error('Error de comunicación con el servidor');
                    });
            }

            // Actualizar cards de métricas
            function actualizarMetricas(data) {
                const trabajosUnicos = new Set(data.map(item => item.idTrabajo)).size;
                const totalUnidades = data.reduce((sum, item) => sum + item.totalUnidades, 0);
                const totalHoras = data.reduce((sum, item) => sum + item.totalHoras, 0);
                const totalCosto = data.reduce((sum, item) => sum + item.costoTotal, 0);
                const empleadosUnicos = data.reduce((max, item) => Math.max(max, item.numeroEmpleados), 0);
                const prodGlobal = totalHoras > 0 ? (totalUnidades / totalHoras).toFixed(2) : '0.00';

                $('#metricTrabajos').text(trabajosUnicos);
                $('#metricUnidades').text(totalUnidades.toLocaleString('es-CO'));
                $('#metricHoras').text(totalHoras.toLocaleString('es-CO'));
                $('#metricProductividad').text(prodGlobal);
                $('#metricCosto').text('$' + totalCosto.toLocaleString('es-CO', { minimumFractionDigits: 0 }));
                $('#metricEmpleados').text(empleadosUnicos);
            }

            // Botón Buscar
            $('#btnBuscar').click(function () {
                cargarProductividad();
            });

            // Botón Limpiar
            $('#btnLimpiar').click(function () {
                $('#filtroPeriodo, #filtroFechaInicio, #filtroFechaFin, #filtroActividad').val('');
                cargarProductividad();
            });

            // Exportar a Excel
            $('#btnExportar').click(function () {
                const periodo = $('#filtroPeriodo').val() || '';
                const fechaInicio = $('#filtroFechaInicio').val() || '';
                const fechaFin = $('#filtroFechaFin').val() || '';
                const actividad = $('#filtroActividad').val() || '';
                
                window.location.href = `@Url.Action("Exportar")?periodo=${periodo}&fechaInicio=${fechaInicio}&fechaFin=${fechaFin}&codigoActividad=${actividad}`;
            });

            // Cargar inicial
            initDataTable();
            cargarProductividad();
        });
    </script>

    <style>
        .card {
            transition: transform 0.2s;
        }
        .card:hover {
            transform: translateY(-2px);
        }
    </style>
}
