@{
    ViewData["Title"] = "Anulación de Liquidaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-4">
    <h1><i class="fas fa-ban mr-2"></i>Anulación de Liquidaciones</h1>
    
    <div class="row mb-4 mt-3">
        <div class="col-md-3">
            <div class="card metric-card" style="border-left: 4px solid #4472C4;">
                <div class="card-body text-center">
                    <h6>Anulaciones</h6>
                    <h3 id="m1" class="text-primary">0</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card metric-card" style="border-left: 4px solid #70AD47;">
                <div class="card-body text-center">
                    <h6>Valor Anulado</h6>
                    <h3 id="m2" class="text-success">$0</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card metric-card" style="border-left: 4px solid #FFC000;">
                <div class="card-body text-center">
                    <h6>Promedio Anulado</h6>
                    <h3 id="m3" class="text-warning">$0</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card metric-card" style="border-left: 4px solid #FF5050;">
                <div class="card-body text-center">
                    <h6>Última Anulación</h6>
                    <h3 id="m4" class="text-danger" style="font-size:14px;">--</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-light">
            <h5><i class="fas fa-filter mr-2"></i>Filtros</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-2"><label>Período</label><input type="month" id="p" class="form-control"></div>
                <div class="col-md-2"><label>Empleado</label><input type="number" id="e" class="form-control"></div>
                <div class="col-md-2"><label>Trabajo</label><input type="number" id="t" class="form-control"></div>
                <div class="col-md-3"><label>Desde</label><input type="date" id="fi" class="form-control"></div>
                <div class="col-md-3"><label>Hasta</label><input type="date" id="ff" class="form-control"></div>
            </div>
            <button id="b" class="btn btn-primary mt-3" style="margin-right:5px;">Buscar</button>
            <button id="x" class="btn btn-success mt-3">Exportar</button>
            <button id="c" class="btn btn-secondary mt-3" style="margin-left:5px;">Limpiar</button>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <table id="tbl" class="table table-striped">
                <thead class="thead-dark">
                    <tr>
                        <th>ID</th><th>Período</th><th>Empleado</th><th>Trabajo</th><th>Valor</th>
                        <th>Estado</th><th>Liquidación</th><th>Motivo</th><th>Anulación</th><th>Usuario</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function() {
            const t = $('#tbl').DataTable({
                language:{url:'//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'},pageLength:10,
                columns:[{data:'idLiquidacion'},{data:'periodo'},{data:'nombreEmpleado'},{data:'nombreTrabajo'},
                {data:'valorLiquidado',render:$.fn.dataTable.render.number(',','.',2,'$')},
                {data:'estadoActualNombre'},{data:'fechaLiquidacion',render:(d)=>new Date(d).toLocaleDateString('es-CO')},
                {data:'motivoanulacion'},{data:'fechaAnulacion',render:(d)=>new Date(d).toLocaleDateString('es-CO')},{data:'usuarioAnulacion'}]
            });

            $('#b').click(()=>{
                $.ajax({type:'POST',url:'@Url.Action("ObtenerAnulaciones","AnulacionLiquidaciones")',
                contentType:'application/json',
                data:JSON.stringify({periodo:$('#p').val()?parseInt($('#p').val().replace('-','')):null,idEmpleado:$('#e').val()?parseInt($('#e').val()):null,idTrabajo:$('#t').val()?parseInt($('#t').val()):null,fechaInicio:$('#fi').val()||null,fechaFin:$('#ff').val()||null}),
                success:r=>{if(r.success){t.clear().rows.add(r.data).draw();const tot=r.data.reduce((s,x)=>s+(x.valorLiquidado||0),0);const ult=r.data.length>0?r.data[r.data.length-1].fechaAnulacion:'';$('#m1').text(r.data.length);$('#m2').text('$'+tot.toLocaleString('es-CO',{minimumFractionDigits:2}));$('#m3').text('$'+(r.data.length>0?tot/r.data.length:0).toLocaleString('es-CO',{minimumFractionDigits:2}));$('#m4').text(ult?new Date(ult).toLocaleDateString('es-CO'):'--');}}});
            });

            $('#x').click(()=>{const p=new URLSearchParams();if($('#p').val())p.append('periodo',parseInt($('#p').val().replace('-','')));if($('#e').val())p.append('idEmpleado',$('#e').val());if($('#t').val())p.append('idTrabajo',$('#t').val());if($('#fi').val())p.append('fechaInicio',$('#fi').val());if($('#ff').val())p.append('fechaFin',$('#ff').val());window.location='@Url.Action("Exportar","AnulacionLiquidaciones")?' + p;});

            $('#c').click(()=>{$('#p').val('');$('#e').val('');$('#t').val('');$('#fi').val('');$('#ff').val('');t.clear().draw();$('#m1').text('0');$('#m2').text('$0');$('#m3').text('$0');$('#m4').text('--');});
        });
    </script>
}
