@{
    ViewData["Title"] = "Contabilización PST";
}

<div class="container-fluid py-3">
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold text-info mb-0">
                <i class="bi bi-bank2"></i> Contabilización PST
            </h2>
            <p class="text-muted">Controles de contabilización por PST y trabajo</p>
        </div>
        <div class="col-md-4 text-md-end">
            <button class="btn btn-success" id="btnExportar">
                <i class="bi bi-file-earmark-excel"></i> Exportar Excel
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100" style="background: linear-gradient(135deg, #0dcaf0, #5dd4f5);">
                <div class="card-body text-white">
                    <div class="small text-uppercase">Registros</div>
                    <h4 class="mb-0" id="metricRegistros">0</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100" style="background: linear-gradient(135deg, #fd7e14, #f9b17a);">
                <div class="card-body text-white">
                    <div class="small text-uppercase">Valor Contabilizado</div>
                    <h4 class="mb-0" id="metricValor">$0</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100" style="background: linear-gradient(135deg, #6f42c1, #b490ff);">
                <div class="card-body text-white">
                    <div class="small text-uppercase">Última Fecha</div>
                    <h4 class="mb-0" id="metricFecha">-</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <span><i class="bi bi-funnel"></i> Filtros</span>
            <div>
                <button class="btn btn-sm btn-outline-light me-2" id="btnBuscar"><i class="bi bi-search"></i> Buscar</button>
                <button class="btn btn-sm btn-outline-light" id="btnLimpiar"><i class="bi bi-eraser"></i> Limpiar</button>
            </div>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Período</label>
                    <input type="number" class="form-control" id="filtroPeriodo" placeholder="2025" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Id Trabajo</label>
                    <input type="number" class="form-control" id="filtroTrabajo" placeholder="Ej: 1203" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fecha Inicio</label>
                    <input type="date" class="form-control" id="filtroFechaInicio" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fecha Fin</label>
                    <input type="date" class="form-control" id="filtroFechaFin" />
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped" id="tablePst">
                    <thead class="table-info">
                        <tr>
                            <th>Período</th>
                            <th>Código Trabajo</th>
                            <th>Trabajo</th>
                            <th>Código PST</th>
                            <th>Valor Contabilizado</th>
                            <th>Fecha</th>
                            <th>Usuario</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            let table;

            function initTable() {
                if ($.fn.DataTable.isDataTable('#tablePst')) {
                    $('#tablePst').DataTable().destroy();
                }

                table = $('#tablePst').DataTable({
                    language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' },
                    data: [],
                    columns: [
                        { data: 'periodo' },
                        { data: 'codigoTrabajo', defaultContent: '-' },
                        { data: 'nombreTrabajo', defaultContent: '-' },
                        { data: 'codigoPst', defaultContent: '-' },
                        {
                            data: 'valorContabilizado',
                            render: function (data) {
                                return '$' + parseFloat(data || 0).toLocaleString('es-CO', { minimumFractionDigits: 2 });
                            }
                        },
                        {
                            data: 'fechaContabilizacion',
                            render: function (data) {
                                return data ? new Date(data).toLocaleDateString('es-CO') : '-';
                            }
                        },
                        { data: 'usuarioContabiliza', defaultContent: '-' },
                        { data: 'estado', defaultContent: '-' }
                    ],
                    order: [[5, 'desc']],
                    pageLength: 25
                });
            }

            function buildFilters() {
                return {
                    periodo: $('#filtroPeriodo').val() ? parseInt($('#filtroPeriodo').val()) : null,
                    idTrabajo: $('#filtroTrabajo').val() ? parseInt($('#filtroTrabajo').val()) : null,
                    fechaInicio: $('#filtroFechaInicio').val() || null,
                    fechaFin: $('#filtroFechaFin').val() || null
                };
            }

            function actualizarMetricas(rows) {
                const total = rows.reduce((acc, x) => acc + (x.valorContabilizado || 0), 0);
                const fechas = rows.map(x => x.fechaContabilizacion ? new Date(x.fechaContabilizacion) : null).filter(Boolean);
                const ultima = fechas.length ? new Date(Math.max.apply(null, fechas)) : null;
                $('#metricRegistros').text(rows.length);
                $('#metricValor').text('$' + total.toLocaleString('es-CO', { minimumFractionDigits: 2 }));
                $('#metricFecha').text(ultima ? ultima.toLocaleDateString('es-CO') : '-');
            }

            function cargarDatos() {
                const filtros = buildFilters();
                $.ajax({
                    url: '@Url.Action("ObtenerContabilizaciones")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(filtros)
                }).done(function (response) {
                    if (response.success) {
                        table.clear().rows.add(response.data).draw();
                        actualizarMetricas(response.data);
                    } else {
                        toastr.error(response.message || 'No fue posible obtener la información');
                    }
                }).fail(function () {
                    toastr.error('Error de comunicación con el servidor');
                });
            }

            function limpiar() {
                $('#filtroPeriodo, #filtroTrabajo').val('');
                $('#filtroFechaInicio, #filtroFechaFin').val('');
                cargarDatos();
            }

            function exportar() {
                const filtros = buildFilters();
                const clean = {};
                Object.entries(filtros).forEach(([key, value]) => {
                    if (value !== null && value !== '') clean[key] = value;
                });
                const query = $.param(clean);
                const url = '@Url.Action("Exportar")' + (query ? `?${query}` : '');
                window.location = url;
            }

            $('#btnBuscar').on('click', cargarDatos);
            $('#btnLimpiar').on('click', limpiar);
            $('#btnExportar').on('click', exportar);

            initTable();
            cargarDatos();
        });
    </script>
}
