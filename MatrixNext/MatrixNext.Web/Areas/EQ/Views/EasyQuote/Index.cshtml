
@model MatrixNext.Web.Areas.EQ.Models.EasyQuoteViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "EasyQuote";
    var initialJson = JsonSerializer.Serialize(Model ?? new MatrixNext.Web.Areas.EQ.Models.EasyQuoteViewModel(), new JsonSerializerOptions { PropertyNamingPolicy = null });
}

<div class="container-fluid">
    <div id="alert-container" style="position: fixed; top: 20px; right: 20px; max-width: 400px; z-index: 9999;"></div>
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h1 class="h3 mb-0">
                EasyQuote (Área EQ)
                <partial name="~/Views/Shared/_HelpTooltip.cshtml" model='new { Text = "Sistema de cotización rápida con cálculo automático de costos", Type = "info" }' />
            </h1>
            <small class="text-muted">Grid editable estilo Excel con cálculo en backend; todo persiste vía TVP/SP.</small>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary position-relative" type="button" id="btn-calcular">
                <span class="spinner-border spinner-border-sm d-none me-2" id="spinner-calcular" role="status" aria-hidden="true"></span>
                Calcular
            </button>
            <button class="btn btn-primary" type="button" id="btn-guardar">Guardar</button>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <!-- Alerta informativa sobre el flujo -->
    <partial name="~/Views/Shared/_InfoAlert.cshtml" model='new { Type = "tip", Message = "Complete los datos generales primero, luego configure muestra y logística. Use Calcular para actualizar costos antes de Guardar.", Dismissible = true }' />

    <div class="alert alert-info py-2">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <strong>Resumen rápido:</strong>
            <span id="badge-aot" class="badge bg-primary">AOT: 0</span>
            <span id="badge-op" class="badge bg-success">OP: 0</span>
            <span id="badge-pct" class="badge bg-dark">%OP: 0%</span>
            <span id="badge-ciudades" class="badge bg-secondary">Ciudades activas: 0</span>
        </div>
    </div>

    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-datos" type="button" role="tab">Datos generales</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-cuestionario" type="button" role="tab">Cuestionario/Procesos</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-muestra" type="button" role="tab">Muestra y logística</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-mystery" type="button" role="tab">Mystery/Shopper</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-staff" type="button" role="tab">Staff SL</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-resumen" type="button" role="tab">Resumen</button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="tab-datos" role="tabpanel">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Nombre propuesta</label>
                    <input class="form-control" id="Nombre" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Grupo objetivo</label>
                    <input class="form-control" id="GrupoObjetivo" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Cliente</label>
                    <input class="form-control" id="Cliente" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fecha aprobación estimada</label>
                    <input class="form-control" type="date" id="FechaAprobacionEstimada" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fecha campo</label>
                    <input class="form-control" type="date" id="FechaCampo" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Prob. aprobación</label>
                    <select class="form-select" id="ProbAprobacion">
                        <option>Alta</option>
                        <option>Media</option>
                        <option>Baja</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">SL</label>
                    <input class="form-control" id="SL" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Metodología SL</label>
                    <input class="form-control" id="MetodologiaSL" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Record detail</label>
                    <input class="form-control" id="RecordDetail" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Categoría / Producto</label>
                    <input class="form-control" id="CategoriaProducto" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Proveedor externo (campo)</label>
                    <input class="form-control" type="number" id="ValorProveedorExterno" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Proveedor internacional</label>
                    <input class="form-control" type="number" id="ValorProveedorInternacional" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">GMU</label>
                    <input class="form-control" type="number" id="ValorGMU" />
                </div>
            </div>

            <hr class="my-4" />

            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Metodología recolección</label>
                    <input class="form-control" id="MetodologiaRecoleccion" placeholder="F2F/CATI/ONLINE/MYSTERY" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Técnica 1</label>
                    <input class="form-control" id="Tecnica1" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Técnica 2</label>
                    <input class="form-control" id="Tecnica2" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Técnica 3</label>
                    <input class="form-control" id="Tecnica3" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Base de datos</label>
                    <select class="form-select" id="BaseDatos">
                        <option value="">No requiere</option>
                        <option>Cliente</option>
                        <option>Comprar</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Incidencia label</label>
                    <input class="form-control" id="IncidenciaLabel" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Incidencia valor</label>
                    <input class="form-control" type="number" step="0.01" id="IncidenciaValor" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Sobre-muestra %</label>
                    <input class="form-control" type="number" step="0.01" id="SobreMuestraPct" />
                </div>
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="EnvioCiudades" />
                        <label class="form-check-label" for="EnvioCiudades">Envío a ciudades</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Peso producto (gr)</label>
                    <input class="form-control" type="number" id="PesoProductoGr" />
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-cuestionario" role="tabpanel">
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">
                        Duración (min)
                        <i class="bi bi-question-circle-fill" data-bs-toggle="tooltip" title="Tiempo aproximado por entrevista. Rango válido: 5-60 minutos"></i>
                    </label>
                    <input class="form-control" type="number" id="DuracionMin" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">
                        Penetración
                        <i class="bi bi-question-circle-fill" data-bs-toggle="tooltip" title="Porcentaje de población que cumple criterios de estudio. Afecta tarifas de reclutamiento"></i>
                    </label>
                    <select class="form-select" id="PenetracionCodigo">
                        <option value="MAS82">Mas 82%</option>
                        <option value="75_82">75%-82%</option>
                        <option value="67_74">67%-74%</option>
                        <option value="55_66">55%-66%</option>
                        <option value="46_54">46%-54%</option>
                        <option value="37_45">37%-45%</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Preguntas abiertas</label>
                    <input class="form-control" type="number" id="PregAbiertas" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Abiertas múltiples</label>
                    <input class="form-control" type="number" id="PregAbiertasMult" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Procesamientos</label>
                    <input class="form-control" type="number" id="NumProcesamientos" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">
                        Clase de prueba
                        <i class="bi bi-question-circle-fill" data-bs-toggle="tooltip" title="Tipo de producto a evaluar (Monódica/Secuencial). Afecta costos de reclutamiento y material"></i>
                    </label>
                    <input class="form-control" id="ClasePrueba" placeholder="Monódica / Secuencial / N/A" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Tipo etiquetado/blind</label>
                    <input class="form-control" id="EtiquetadoTipo" placeholder="Blind/Ciego/Simple" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Productos a testear</label>
                    <input class="form-control" type="number" id="ProductosTestear" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Productos por respondiente</label>
                    <input class="form-control" type="number" id="ProductosPorResp" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Patinadores por ciudad</label>
                    <input class="form-control" type="number" id="PatinadoresCiudad" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Compra producto</label>
                    <input class="form-control" type="number" id="CompraProducto" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check me-3">
                        <input class="form-check-input" type="checkbox" id="TopLine" />
                        <label class="form-check-label" for="TopLine">Top Line</label>
                    </div>
                    <div class="form-check me-3">
                        <input class="form-check-input" type="checkbox" id="ASCIIFlag" />
                        <label class="form-check-label" for="ASCIIFlag">ASCII</label>
                    </div>
                    <div class="form-check me-3">
                        <input class="form-check-input" type="checkbox" id="ScriptReclutamiento" />
                        <label class="form-check-label" for="ScriptReclutamiento">Script reclutamiento</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="Siembra" />
                        <label class="form-check-label" for="Siembra">Siembra</label>
                    </div>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check me-3">
                        <input class="form-check-input" type="checkbox" id="Scripting" />
                        <label class="form-check-label" for="Scripting">Scripting</label>
                    </div>
                    <div class="form-check me-3">
                        <input class="form-check-input" type="checkbox" id="Codificacion" />
                        <label class="form-check-label" for="Codificacion">Codificación</label>
                    </div>
                    <div class="form-check me-3">
                        <input class="form-check-input" type="checkbox" id="Procesamiento" />
                        <label class="form-check-label" for="Procesamiento">Procesamiento</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="ProcesoEstadistico" />
                        <label class="form-check-label" for="ProcesoEstadistico">Proc. estadístico</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Tipo de script</label>
                    <select class="form-select" id="ScriptingTipo">
                        <option>Nuevo</option>
                        <option>Duplicado</option>
                        <option>Reutilizacion</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Data Cleaning</label>
                    <select class="form-select" id="DataCleaning">
                        <option>Total</option>
                        <option>Parcial</option>
                        <option>No</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check me-3">
                        <input class="form-check-input" type="checkbox" id="Refrigeracion" />
                        <label class="form-check-label" for="Refrigeracion">Refrigeración</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="Embalaje" />
                        <label class="form-check-label" for="Embalaje">Embalaje</label>
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check me-3">
                        <input class="form-check-input" type="checkbox" id="Harmoni" />
                        <label class="form-check-label" for="Harmoni">Harmoni</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="Graficacion" />
                        <label class="form-check-label" for="Graficacion">Graficación</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Otros costos</label>
                    <input class="form-control" type="number" step="0.01" id="OtrosCostos" />
                </div>
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="tab-muestra" role="tabpanel">
            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <label class="form-label">Penetración (label)</label>
                    <input class="form-control" id="IncidenciaLabelAlias" placeholder="Solo informativo" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Muestra total (solo lectura)</label>
                    <input class="form-control" id="TotalMuestra" disabled />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Sobre-muestra %</label>
                    <input class="form-control" type="number" step="0.01" id="SobreMuestraPctAlias" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Peso producto (gr)</label>
                    <input class="form-control" type="number" id="PesoProductoGrAlias" />
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0">
                    Ciudades y NSE
                    <i class="bi bi-question-circle-fill" data-bs-toggle="tooltip" title="Nivel Socioeconómico (1-6). Afecta tarifas y disponibilidad de participantes. La suma de NSE debe igualar el total por ciudad"></i>
                </h6>
                <button class="btn btn-sm btn-outline-primary" type="button" id="btn-add-city">+ Ciudad</button>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-sm align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Activa</th>
                            <th>Ciudad</th>
                            <th>Total</th>
                            <th>NSE1</th>
                            <th>NSE2</th>
                            <th>NSE3</th>
                            <th>NSE4</th>
                            <th>NSE5</th>
                            <th>NSE6</th>
                        </tr>
                    </thead>
                    <tbody id="sample-body"></tbody>
                    <tfoot class="table-secondary">
                        <tr>
                            <th colspan="2">Totales activos</th>
                            <th id="sample-total" class="text-end">0</th>
                            <th id="sample-n1" class="text-end">0</th>
                            <th id="sample-n2" class="text-end">0</th>
                            <th id="sample-n3" class="text-end">0</th>
                            <th id="sample-n4" class="text-end">0</th>
                            <th id="sample-n5" class="text-end">0</th>
                            <th id="sample-n6" class="text-end">0</th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <h6 class="mt-4 mb-2">
                Logística operativa
                <i class="bi bi-question-circle-fill" data-bs-toggle="tooltip" title="Parámetros logísticos que afectan el costo final y viabilidad del estudio"></i>
            </h6>
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">Días setup</label>
                    <input class="form-control" type="number" id="DiasSetup" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Días campo</label>
                    <input class="form-control" type="number" id="DiasCampo" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Número de olas</label>
                    <input class="form-control" type="number" id="NumOlas" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Apoyo reclutamiento</label>
                    <select class="form-select" id="ApoyoReclutamientoTipo">
                        <option value="">Sin apoyo</option>
                        <option value="Telefonica">Telefónica</option>
                        <option value="Presencial">Presencial</option>
                        <option value="Mixta">Mixta</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check me-3">
                        <input class="form-check-input" type="checkbox" id="TaxiParticipantes" />
                        <label class="form-check-label" for="TaxiParticipantes">Taxi participantes</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="EstudioNinos" />
                        <label class="form-check-label" for="EstudioNinos">Estudio niños</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">
                        Reprografía (páginas)
                        <i class="bi bi-question-circle-fill" data-bs-toggle="tooltip" title="Número de páginas a imprimir del material de estudio. Se multiplica por cantidad de participantes"></i>
                    </label>
                    <input class="form-control" type="number" id="ReprografiaPaginas" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">
                        Viáticos campo (override)
                        <i class="bi bi-question-circle-fill" data-bs-toggle="tooltip" title="Transporte y alimentación del personal en campo (por día). Si está vacío usa valor default del sistema"></i>
                    </label>
                    <input class="form-control" type="number" step="0.01" id="ViaticasCampoOverride" placeholder="Opcional" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Otros incentivos</label>
                    <input class="form-control" type="number" step="0.01" id="OtrosIncentivos" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Dimensiones (cm) - Largo</label>
                    <input class="form-control" type="number" step="0.1" id="DimensionLargoCm" placeholder="Para envío volumétrico" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Ancho (cm)</label>
                    <input class="form-control" type="number" step="0.1" id="DimensionAnchoCm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Alto (cm)</label>
                    <input class="form-control" type="number" step="0.1" id="DimensionAltoCm" />
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-mystery" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0">Visitas Mystery / Shopper</h6>
                <button class="btn btn-sm btn-outline-primary" type="button" id="btn-add-mystery">+ Visita</button>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Tipo visita</th>
                            <th>Complejidad</th>
                            <th>Olas</th>
                            <th>Desplazamientos</th>
                            <th>Tanqueos</th>
                            <th>Alertas</th>
                            <th>Edición</th>
                            <th>Alquiler equipos</th>
                            <th>Compra disp.</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="mystery-body"></tbody>
                </table>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-staff" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0">Staff SL (L4-L7)</h6>
                <button class="btn btn-sm btn-outline-primary" type="button" id="btn-add-staff">+ Fila</button>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Nivel</th>
                            <th>Horas mín</th>
                            <th>Horas presup.</th>
                            <th>Tarifa</th>
                            <th>Valor</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="staff-body"></tbody>
                    <tfoot class="table-secondary">
                        <tr>
                            <th colspan="4">Total</th>
                            <th id="staff-total" class="text-end">0</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-resumen" role="tabpanel">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-header">Costos por rubro</div>
                        <div class="card-body">
                            <ul class="list-group list-group-flush small">
                                <li class="list-group-item d-flex justify-content-between"><span>Campo + Mystery</span><span id="sum-campo">0</span></li>
                                <li class="list-group-item d-flex justify-content-between"><span>Viáticos</span><span id="sum-viaticos">0</span></li>
                                <li class="list-group-item d-flex justify-content-between"><span>Incentivos</span><span id="sum-incentivos">0</span></li>
                                <li class="list-group-item d-flex justify-content-between"><span>Insumos</span><span id="sum-insumos">0</span></li>
                                <li class="list-group-item d-flex justify-content-between"><span>Staff OPS</span><span id="sum-ops">0</span></li>
                                <li class="list-group-item d-flex justify-content-between"><span>Staff SL</span><span id="sum-sl">0</span></li>
                                <li class="list-group-item d-flex justify-content-between"><span>Compra producto</span><span id="sum-compra">0</span></li>
                                <li class="list-group-item d-flex justify-content-between"><span>Tablets</span><span id="sum-tablets">0</span></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-header">Margen</div>
                        <div class="card-body">
                            <ul class="list-group list-group-flush small">
                                <li class="list-group-item d-flex justify-content-between"><span>Direct cost OPS</span><span id="sum-direct">0</span></li>
                                <li class="list-group-item d-flex justify-content-between"><span>GM</span><span id="sum-gm">0</span></li>
                                <li class="list-group-item d-flex justify-content-between"><span>PB + RMF</span><span id="sum-pb">0</span></li>
                                <li class="list-group-item d-flex justify-content-between"><span>Prof Time</span><span id="sum-prof">0</span></li>
                                <li class="list-group-item d-flex justify-content-between"><strong>OP</strong><strong id="sum-op">0</strong></li>
                                <li class="list-group-item d-flex justify-content-between"><strong>AOT</strong><strong id="sum-aot">0</strong></li>
                                <li class="list-group-item d-flex justify-content-between"><span>% OP</span><span id="sum-pct">0%</span></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-header">Acciones</div>
                        <div class="card-body">
                            <p class="small text-muted">Usa Calcular para ver el breakdown; Guardar persiste cabecera y detalle (ciudades, mystery, staff) via TVP.</p>
                            <button class="btn btn-outline-secondary w-100 mb-2" type="button" id="btn-calcular-2">Calcular</button>
                            <button class="btn btn-primary w-100" type="button" id="btn-guardar-2">Guardar</button>
                            <div class="alert alert-secondary small mt-3 mb-0" id="status-box">Pendiente de cálculo.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
<script>
    const initialState = @Html.Raw(initialJson);
    const state = JSON.parse(JSON.stringify(initialState));
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const urls = {
        calc: '@Url.Action("Calcular")',
        save: '@Url.Action("Guardar")'
    };

    const $ = (id) => document.getElementById(id);
    const toNumber = (val) => {
        const n = parseFloat(val);
        return isNaN(n) ? 0 : n;
    };
    const fmt = (val) => (val ?? 0).toLocaleString('es-CO', { maximumFractionDigits: 0 });

    function loadPrimitives() {
        const h = state.Header || {};
        $('Nombre').value = h.Nombre || '';
        $('GrupoObjetivo').value = h.GrupoObjetivo || '';
        $('Cliente').value = h.Cliente || '';
        $('FechaAprobacionEstimada').value = h.FechaAprobacionEstimada ? h.FechaAprobacionEstimada.substring(0, 10) : '';
        $('FechaCampo').value = h.FechaCampo ? h.FechaCampo.substring(0, 10) : '';
        $('ProbAprobacion').value = h.ProbAprobacion || 'Alta';
        $('SL').value = h.SL || '';
        $('MetodologiaSL').value = h.MetodologiaSL || '';
        $('RecordDetail').value = h.RecordDetail || '';
        $('CategoriaProducto').value = h.CategoriaProducto || '';
        $('ValorProveedorExterno').value = h.ValorProveedorExterno || '';
        $('ValorProveedorInternacional').value = h.ValorProveedorInternacional || '';
        $('ValorGMU').value = h.ValorGMU || '';

        const m = state.Methodology || {};
        $('MetodologiaRecoleccion').value = m.MetodologiaRecoleccion || '';
        $('Tecnica1').value = m.Tecnica1 || '';
        $('Tecnica2').value = m.Tecnica2 || '';
        $('Tecnica3').value = m.Tecnica3 || '';
        $('BaseDatos').value = m.BaseDatos || '';
        $('IncidenciaLabel').value = m.IncidenciaLabel || '';
        $('IncidenciaValor').value = m.IncidenciaValor || '';
        $('SobreMuestraPct').value = m.SobreMuestraPct || '';
        $('EnvioCiudades').checked = !!m.EnvioCiudades;
        $('PesoProductoGr').value = m.PesoProductoGr || '';
        $('SobreMuestraPctAlias').value = m.SobreMuestraPct || '';
        $('PesoProductoGrAlias').value = m.PesoProductoGr || '';
        $('IncidenciaLabelAlias').value = m.IncidenciaLabel || '';

        const q = state.Questionnaire || {};
        $('DuracionMin').value = q.DuracionMin || '';
        $('PenetracionCodigo').value = q.PenetracionCodigo || 'MAS82';
        $('PregAbiertas').value = q.PregAbiertas || '';
        $('PregAbiertasMult').value = q.PregAbiertasMult || '';
        $('NumProcesamientos').value = q.NumProcesamientos || 1;
        $('ClasePrueba').value = q.ClasePrueba || '';
        $('EtiquetadoTipo').value = q.EtiquetadoTipo || '';
        $('ProductosTestear').value = q.ProductosTestear || 1;
        $('ProductosPorResp').value = q.ProductosPorResp || 1;
        $('PatinadoresCiudad').value = q.PatinadoresCiudad || 0;
        $('CompraProducto').value = q.CompraProducto || 0;
        $('TopLine').checked = !!q.TopLine;
        $('DataCleaning').value = q.DataCleaning || 'Total';
        $('ASCIIFlag').checked = !!q.ASCIIFlag;
        $('ScriptReclutamiento').checked = !!q.ScriptReclutamiento;
        $('Scripting').checked = !!q.Scripting;
        $('ScriptingTipo').value = q.ScriptingTipo || 'Nuevo';
        $('Codificacion').checked = !!q.Codificacion;
        $('Procesamiento').checked = !!q.Procesamiento;
        $('ProcesoEstadistico').checked = !!q.ProcesoEstadistico;
        $('Refrigeracion').checked = !!q.Refrigeracion;
        $('Embalaje').checked = !!q.Embalaje;
        $('Siembra').checked = !!q.Siembra;
    }

    function renderSample() {
        state.SampleCities = state.SampleCities || [];
        const tbody = $('sample-body');
        tbody.innerHTML = '';
        state.SampleCities.forEach((c, idx) => {
            const tr = document.createElement('tr');
            tr.dataset.index = idx;
            tr.innerHTML = `
                <td class="text-center"><input type="checkbox" data-field="Activa" ${c.Activa ? 'checked' : ''} /></td>
                <td><input class="form-control form-control-sm" data-field="Ciudad" value="${c.Ciudad || ''}" /></td>
                <td><input class="form-control form-control-sm text-end" type="number" data-field="MuestraTotal" value="${c.MuestraTotal || 0}" /></td>
                <td><input class="form-control form-control-sm text-end" type="number" data-field="NSE1" value="${c.NSE1 || 0}" /></td>
                <td><input class="form-control form-control-sm text-end" type="number" data-field="NSE2" value="${c.NSE2 || 0}" /></td>
                <td><input class="form-control form-control-sm text-end" type="number" data-field="NSE3" value="${c.NSE3 || 0}" /></td>
                <td><input class="form-control form-control-sm text-end" type="number" data-field="NSE4" value="${c.NSE4 || 0}" /></td>
                <td><input class="form-control form-control-sm text-end" type="number" data-field="NSE5" value="${c.NSE5 || 0}" /></td>
                <td><input class="form-control form-control-sm text-end" type="number" data-field="NSE6" value="${c.NSE6 || 0}" /></td>
            `;
            tbody.appendChild(tr);
        });
        updateSampleTotals();
    }

    function updateSampleTotals() {
        const active = (state.SampleCities || []).filter(c => c.Activa);
        const sum = (field) => active.reduce((a, b) => a + toNumber(b[field] || 0), 0);
        $('sample-total').textContent = fmt(sum('MuestraTotal'));
        $('sample-n1').textContent = fmt(sum('NSE1'));
        $('sample-n2').textContent = fmt(sum('NSE2'));
        $('sample-n3').textContent = fmt(sum('NSE3'));
        $('sample-n4').textContent = fmt(sum('NSE4'));
        $('sample-n5').textContent = fmt(sum('NSE5'));
        $('sample-n6').textContent = fmt(sum('NSE6'));
        $('TotalMuestra').value = fmt(sum('MuestraTotal'));
        $('badge-ciudades').textContent = `Ciudades activas: ${active.length}`;
        
        // T2.3.2: Validación visual - NSE sums must equal total per city
        document.querySelectorAll('#sample-body tr').forEach((row, idx) => {
            const city = state.SampleCities[idx];
            if (!city) return;
            
            const nseSum = toNumber(city.NSE1 || 0) + toNumber(city.NSE2 || 0) + 
                          toNumber(city.NSE3 || 0) + toNumber(city.NSE4 || 0) + 
                          toNumber(city.NSE5 || 0) + toNumber(city.NSE6 || 0);
            const total = toNumber(city.MuestraTotal || 0);
            
            // Check if sum matches total (allow 0.5 tolerance for rounding)
            if (total > 0 && Math.abs(nseSum - total) > 0.5) {
                row.classList.add('table-danger');
                row.style.borderLeft = '4px solid #dc3545';
                // Remove old error message if exists
                const oldError = row.querySelector('.validation-error');
                if (oldError) oldError.remove();
                // Add new error message
                const errorCell = document.createElement('div');
                errorCell.className = 'validation-error';
                errorCell.style.cssText = 'color: #dc3545; font-size: 0.75em; white-space: nowrap; margin-top: 2px;';
                errorCell.textContent = `⚠️ Suma: ${nseSum.toFixed(0)} vs Total: ${total.toFixed(0)}`;
                row.appendChild(errorCell);
            } else {
                row.classList.remove('table-danger');
                row.style.borderLeft = '';
                const errorCell = row.querySelector('.validation-error');
                if (errorCell) errorCell.remove();
            }
        });
    }

    function renderMystery() {
        state.MysteryVisits = state.MysteryVisits || [];
        const tbody = $('mystery-body');
        tbody.innerHTML = '';
        state.MysteryVisits.forEach((m, idx) => {
            const tr = document.createElement('tr');
            tr.dataset.index = idx;
            tr.innerHTML = `
                <td><input class="form-control form-control-sm" data-field="TipoVisita" value="${m.TipoVisita || ''}" /></td>
                <td><input class="form-control form-control-sm" data-field="Complejidad" value="${m.Complejidad || ''}" /></td>
                <td><input class="form-control form-control-sm text-end" type="number" data-field="NumOlas" value="${m.NumOlas || 1}" /></td>
                <td><input class="form-control form-control-sm text-end" type="number" data-field="Desplazamientos" value="${m.Desplazamientos || 0}" /></td>
                <td><input class="form-control form-control-sm text-end" type="number" data-field="Tanqueos" value="${m.Tanqueos || 0}" /></td>
                <td><input class="form-control form-control-sm text-end" type="number" data-field="Alertas" value="${m.Alertas || 0}" /></td>
                <td><input class="form-control form-control-sm text-end" type="number" data-field="Edicion" value="${m.Edicion || 0}" /></td>
                <td><input class="form-control form-control-sm text-end" type="number" data-field="AlquilerEquipos" value="${m.AlquilerEquipos || 0}" /></td>
                <td><input class="form-control form-control-sm text-end" type="number" data-field="CompraDispositivos" value="${m.CompraDispositivos || 0}" /></td>
                <td class="text-center"><button class="btn btn-sm btn-link text-danger" data-action="del">?</button></td>
            `;
            tbody.appendChild(tr);
        });
    }

    function renderStaff() {
        state.StaffSL = state.StaffSL || [];
        const tbody = $('staff-body');
        tbody.innerHTML = '';
        let total = 0;
        state.StaffSL.forEach((s, idx) => {
            const valor = toNumber(s.HorasPresup) * toNumber(s.Tarifa);
            total += valor;
            const tr = document.createElement('tr');
            tr.dataset.index = idx;
            tr.innerHTML = `
                <td><input class="form-control form-control-sm" data-field="Nivel" value="${s.Nivel || ''}" /></td>
                <td><input class="form-control form-control-sm text-end" type="number" data-field="HorasMinimas" value="${s.HorasMinimas || 0}" /></td>
                <td><input class="form-control form-control-sm text-end" type="number" data-field="HorasPresup" value="${s.HorasPresup || 0}" /></td>
                <td><input class="form-control form-control-sm text-end" type="number" data-field="Tarifa" value="${s.Tarifa || 0}" /></td>
                <td class="text-end fw-bold">${fmt(valor)}</td>
                <td class="text-center"><button class="btn btn-sm btn-link text-danger" data-action="del">?</button></td>
            `;
            tbody.appendChild(tr);
        });
        $('staff-total').textContent = fmt(total);
    }
    function syncPrimitivesToState() {
        const h = state.Header || {};
        h.Nombre = $('Nombre').value || '';
        h.GrupoObjetivo = $('GrupoObjetivo').value || '';
        h.Cliente = $('Cliente').value || '';
        h.FechaAprobacionEstimada = $('FechaAprobacionEstimada').value || null;
        h.FechaCampo = $('FechaCampo').value || null;
        h.ProbAprobacion = $('ProbAprobacion').value || 'Alta';
        h.SL = $('SL').value || '';
        h.MetodologiaSL = $('MetodologiaSL').value || '';
        h.RecordDetail = $('RecordDetail').value || '';
        h.CategoriaProducto = $('CategoriaProducto').value || '';
        h.ValorProveedorExterno = toNumber($('ValorProveedorExterno').value);
        h.ValorProveedorInternacional = toNumber($('ValorProveedorInternacional').value);
        h.ValorGMU = toNumber($('ValorGMU').value);
        state.Header = h;

        const m = state.Methodology || {};
        m.MetodologiaRecoleccion = $('MetodologiaRecoleccion').value || '';
        m.Tecnica1 = $('Tecnica1').value || '';
        m.Tecnica2 = $('Tecnica2').value || '';
        m.Tecnica3 = $('Tecnica3').value || '';
        m.BaseDatos = $('BaseDatos').value || '';
        m.IncidenciaLabel = $('IncidenciaLabel').value || '';
        m.IncidenciaValor = $('IncidenciaValor').value ? toNumber($('IncidenciaValor').value) : null;
        m.SobreMuestraPct = toNumber($('SobreMuestraPct').value || $('SobreMuestraPctAlias').value);
        m.EnvioCiudades = $('EnvioCiudades').checked;
        m.PesoProductoGr = toNumber($('PesoProductoGr').value || $('PesoProductoGrAlias').value);
        state.Methodology = m;

        const q = state.Questionnaire || {};
        q.DuracionMin = parseInt($('DuracionMin').value || '0');
        q.PenetracionCodigo = $('PenetracionCodigo').value || 'MAS82';
        q.PregAbiertas = parseInt($('PregAbiertas').value || '0');
        q.PregAbiertasMult = parseInt($('PregAbiertasMult').value || '0');
        q.NumProcesamientos = parseInt($('NumProcesamientos').value || '1');
        q.ClasePrueba = $('ClasePrueba').value || '';
        q.EtiquetadoTipo = $('EtiquetadoTipo').value || '';
        q.ProductosTestear = parseInt($('ProductosTestear').value || '1');
        q.ProductosPorResp = parseInt($('ProductosPorResp').value || '1');
        q.PatinadoresCiudad = parseInt($('PatinadoresCiudad').value || '0');
        q.CompraProducto = toNumber($('CompraProducto').value || 0);
        q.TopLine = $('TopLine').checked;
        q.DataCleaning = $('DataCleaning').value || 'Total';
        q.ASCIIFlag = $('ASCIIFlag').checked;
        q.ScriptReclutamiento = $('ScriptReclutamiento').checked;
        q.Scripting = $('Scripting').checked;
        q.ScriptingTipo = $('ScriptingTipo').value || 'Nuevo';
        q.Codificacion = $('Codificacion').checked;
        q.Procesamiento = $('Procesamiento').checked;
        q.ProcesoEstadistico = $('ProcesoEstadistico').checked;
        q.Refrigeracion = $('Refrigeracion').checked;
        q.Embalaje = $('Embalaje').checked;
        q.Siembra = $('Siembra').checked;
        state.Questionnaire = q;
    }

    function syncTablesToState() {
        const sampleRows = document.querySelectorAll('#sample-body tr');
        state.SampleCities = Array.from(sampleRows).map(r => {
            const get = (field) => {
                const input = r.querySelector(`[data-field="${field}"]`);
                if (!input) return null;
                if (input.type === 'checkbox') return input.checked;
                if (field === 'Ciudad') return input.value || '';
                return toNumber(input.value);
            };
            return {
                Ciudad: get('Ciudad'),
                Activa: !!get('Activa'),
                MuestraTotal: get('MuestraTotal'),
                NSE1: get('NSE1'),
                NSE2: get('NSE2'),
                NSE3: get('NSE3'),
                NSE4: get('NSE4'),
                NSE5: get('NSE5'),
                NSE6: get('NSE6')
            };
        });

        const mysRows = document.querySelectorAll('#mystery-body tr');
        state.MysteryVisits = Array.from(mysRows).map(r => {
            const get = (field) => {
                const input = r.querySelector(`[data-field="${field}"]`);
                if (!input) return null;
                if (input.type === 'checkbox') return input.checked;
                if (['TipoVisita', 'Complejidad'].includes(field)) return input.value || '';
                return toNumber(input.value);
            };
            return {
                TipoVisita: get('TipoVisita'),
                Complejidad: get('Complejidad'),
                NumOlas: get('NumOlas'),
                Desplazamientos: get('Desplazamientos'),
                Tanqueos: get('Tanqueos'),
                Alertas: get('Alertas'),
                Edicion: get('Edicion'),
                AlquilerEquipos: get('AlquilerEquipos'),
                CompraDispositivos: get('CompraDispositivos')
            };
        });

        const staffRows = document.querySelectorAll('#staff-body tr');
        state.StaffSL = Array.from(staffRows).map(r => {
            const get = (field) => {
                const input = r.querySelector(`[data-field="${field}"]`);
                if (!input) return null;
                if (['Nivel'].includes(field)) return input.value || '';
                return toNumber(input.value);
            };
            return {
                Nivel: get('Nivel'),
                HorasMinimas: get('HorasMinimas'),
                HorasPresup: get('HorasPresup'),
                Tarifa: get('Tarifa')
            };
        });
    }

    function renderSummary(summary) {
        const s = summary || state.Summary || {};
        $('sum-campo').textContent = fmt(s.CostoCampo);
        $('sum-viaticos').textContent = fmt(s.Viaticos);
        $('sum-incentivos').textContent = fmt(s.Incentivos);
        $('sum-insumos').textContent = fmt(s.Insumos);
        $('sum-ops').textContent = fmt(s.StaffOps);
        $('sum-sl').textContent = fmt(s.StaffSL);
        $('sum-compra').textContent = fmt(s.CompraProducto);
        $('sum-tablets').textContent = fmt(s.Tablets);
        $('sum-direct').textContent = fmt(s.DirectCostOps);
        $('sum-gm').textContent = fmt(s.GM);
        $('sum-pb').textContent = fmt(s.PB_RMF);
        $('sum-prof').textContent = fmt(s.ProfTime);
        $('sum-op').textContent = fmt(s.OP);
        $('sum-aot').textContent = fmt(s.AOT);
        $('sum-pct').textContent = `${((s.PorcOP || 0) * 100).toFixed(2)}%`;
        $('badge-aot').textContent = `AOT: ${fmt(s.AOT)}`;
        $('badge-op').textContent = `OP: ${fmt(s.OP)}`;
        $('badge-pct').textContent = `%OP: ${((s.PorcOP || 0) * 100).toFixed(2)}%`;
    }

    // T2.3.4: Mejorados mensajes de error con alertas Bootstrap y auto-dismiss
    function showStatus(msg, ok = true) {
        const container = $('alert-container');
        if (!container) return;
        
        // Crear alerta
        const alertDiv = document.createElement('div');
        const alertType = ok ? 'success' : 'danger';
        const icon = ok ? '✓' : '⚠️';
        alertDiv.className = `alert alert-${alertType} alert-dismissible fade show mb-2`;
        alertDiv.innerHTML = `
            <span>${icon} ${msg}</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        
        container.appendChild(alertDiv);
        
        // Auto-dismiss después de 5 segundos (solo si es success)
        if (ok) {
            setTimeout(() => {
                alertDiv.classList.remove('show');
                setTimeout(() => alertDiv.remove(), 150);
            }, 5000);
        }
    }

    async function callApi(url, payload) {
        const res = await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify(payload)
        });
        if (!res.ok) throw new Error('Error de red');
        return await res.json();
    }

    async function calcular() {
        syncPrimitivesToState();
        syncTablesToState();
        
        // T2.3.3: Show spinner and disable button
        const btn = $('btn-calcular');
        const spinner = $('spinner-calcular');
        btn.disabled = true;
        spinner.classList.remove('d-none');
        
        try {
            const result = await callApi(urls.calc, state);
            state.Summary = result;
            renderSummary(result);
            showStatus('Cálculo actualizado.', true);
        } catch (e) {
            console.error(e);
            showStatus('Error al calcular', false);
        } finally {
            // Hide spinner and enable button
            spinner.classList.add('d-none');
            btn.disabled = false;
        }
    }

    async function guardar() {
        syncPrimitivesToState();
        syncTablesToState();
        try {
            const result = await callApi(urls.save, state);
            if (result && result.success) {
                state.Id = result.id;
                state.Summary = result.summary;
                renderSummary(result.summary);
                showStatus(`Guardado OK. ID: ${result.id}`, true);
            } else {
                showStatus(result?.message || 'Error al guardar', false);
            }
        } catch (e) {
            console.error(e);
            showStatus('Error al guardar', false);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        loadPrimitives();
        renderSample();
        renderMystery();
        renderStaff();
        renderSummary(state.Summary);
        
        // T2.3.1: Inicializar tooltips Bootstrap
        const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
    });

    $('btn-add-city').addEventListener('click', () => {
        state.SampleCities.push({ Ciudad: 'Nueva', Activa: true, MuestraTotal: 0, NSE1: 0, NSE2: 0, NSE3: 0, NSE4: 0, NSE5: 0, NSE6: 0 });
        renderSample();
    });

    $('btn-add-mystery').addEventListener('click', () => {
        state.MysteryVisits.push({ TipoVisita: 'TIPO VISITA 1', Complejidad: 'Básica', NumOlas: 1 });
        renderMystery();
    });

    $('btn-add-staff').addEventListener('click', () => {
        state.StaffSL.push({ Nivel: 'L6', HorasMinimas: 0, HorasPresup: 0, Tarifa: 0 });
        renderStaff();
    });

    $('sample-body').addEventListener('input', (e) => {
        const field = e.target.dataset.field;
        if (!field) return;
        const idx = parseInt(e.target.closest('tr').dataset.index);
        const row = state.SampleCities[idx];
        if (!row) return;
        if (e.target.type === 'checkbox') row[field] = e.target.checked;
        else if (field === 'Ciudad') row[field] = e.target.value;
        else row[field] = toNumber(e.target.value);
        updateSampleTotals();
    });

    $('mystery-body').addEventListener('input', (e) => {
        const field = e.target.dataset.field;
        if (!field) return;
        const idx = parseInt(e.target.closest('tr').dataset.index);
        const row = state.MysteryVisits[idx];
        if (!row) return;
        if (['TipoVisita', 'Complejidad'].includes(field)) row[field] = e.target.value;
        else row[field] = toNumber(e.target.value);
    });
    $('mystery-body').addEventListener('click', (e) => {
        if (e.target.dataset.action === 'del') {
            const idx = parseInt(e.target.closest('tr').dataset.index);
            state.MysteryVisits.splice(idx, 1);
            renderMystery();
        }
    });

    $('staff-body').addEventListener('input', (e) => {
        const field = e.target.dataset.field;
        if (!field) return;
        const idx = parseInt(e.target.closest('tr').dataset.index);
        const row = state.StaffSL[idx];
        if (!row) return;
        if (field === 'Nivel') row[field] = e.target.value;
        else row[field] = toNumber(e.target.value);
        renderStaff();
    });
    $('staff-body').addEventListener('click', (e) => {
        if (e.target.dataset.action === 'del') {
            const idx = parseInt(e.target.closest('tr').dataset.index);
            state.StaffSL.splice(idx, 1);
            renderStaff();
        }
    });

    const calcButtons = ['btn-calcular', 'btn-calcular-2'];
    calcButtons.forEach(id => $(id).addEventListener('click', calcular));
    const saveButtons = ['btn-guardar', 'btn-guardar-2'];
    saveButtons.forEach(id => $(id)?.addEventListener('click', guardar));
</script>

