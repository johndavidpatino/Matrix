@model IEnumerable<MatrixNext.Data.Modules.US.GruposPermisos.Models.GrupoPermisoDto>

@{
    ViewData["Title"] = "Grupos de Permisos";
}

<div class="container mt-4">
    <h3>Grupos de Permisos</h3>
    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between mb-3">
                <div class="input-group" style="max-width: 300px;">
                    <input type="text" id="txtFiltro" class="form-control" placeholder="Buscar..." />
                    <button id="btnBuscar" class="btn btn-outline-secondary" type="button">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
                <button id="btnNuevo" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-lg"></i> Nuevo Grupo
                </button>
            </div>

            <div id="listaContainer">
                @await Html.PartialAsync("_Lista", Model)
            </div>
        </div>
    </div>
</div>

<!-- Modal Container -->
<div id="modalContainer"></div>

@section Scripts {
    <script>
        // Nuevo grupo
        document.getElementById('btnNuevo')?.addEventListener('click', function() {
            fetch('@Url.Action("CreateModal", "GruposPermisos", new { area = "US" })')
                .then(r => r.text())
                .then(html => {
                    document.getElementById('modalContainer').innerHTML = html;
                    var modalEl = document.getElementById('modalCreateEdit');
                    var modal = new bootstrap.Modal(modalEl);
                    modal.show();
                });
        });

        // Buscar
        document.getElementById('btnBuscar')?.addEventListener('click', function() {
            buscar();
        });

        document.getElementById('txtFiltro')?.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                buscar();
            }
        });

        function buscar() {
            var filtro = document.getElementById('txtFiltro').value;
            fetch('@Url.Action("Lista", "GruposPermisos", new { area = "US" })' + '?filtro=' + encodeURIComponent(filtro))
                .then(r => r.text())
                .then(html => {
                    document.getElementById('listaContainer').innerHTML = html;
                    enlazarBotones();
                });
        }

        function enlazarBotones() {
            // Editar
            document.querySelectorAll('.btn-edit').forEach(btn => {
                btn.addEventListener('click', function() {
                    var id = this.getAttribute('data-id');
                    fetch('@Url.Action("EditModal", "GruposPermisos", new { area = "US" })/' + id)
                        .then(r => r.text())
                        .then(html => {
                            document.getElementById('modalContainer').innerHTML = html;
                            var modalEl = document.getElementById('modalCreateEdit');
                            var modal = new bootstrap.Modal(modalEl);
                            modal.show();
                        });
                });
            });

            // Eliminar
            document.querySelectorAll('.btn-delete').forEach(btn => {
                btn.addEventListener('click', function() {
                    var id = this.getAttribute('data-id');
                    fetch('@Url.Action("DeleteModal", "GruposPermisos", new { area = "US" })/' + id)
                        .then(r => r.text())
                        .then(html => {
                            document.getElementById('modalContainer').innerHTML = html;
                            var modalEl = document.getElementById('modalDelete');
                            var modal = new bootstrap.Modal(modalEl);
                            modal.show();
                        });
                });
            });
        }

        // Enlazar botones al cargar
        document.addEventListener('DOMContentLoaded', enlazarBotones);
    </script>
}
