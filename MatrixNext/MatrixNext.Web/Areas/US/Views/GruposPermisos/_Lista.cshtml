@model IEnumerable<MatrixNext.Data.Modules.US.GruposPermisos.Models.GrupoPermisoDto>

@if (Model != null && Model.Any())
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th style="width: 80px;">Id</th>
                <th>Nombre del Grupo</th>
                <th style="width: 120px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.GrupoPermisos</td>
                    <td>
                        <button data-id="@item.Id" class="btn btn-sm btn-warning btn-edit" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button data-id="@item.Id" class="btn btn-sm btn-danger btn-delete" title="Eliminar">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No hay grupos de permisos definidos.</div>
}
