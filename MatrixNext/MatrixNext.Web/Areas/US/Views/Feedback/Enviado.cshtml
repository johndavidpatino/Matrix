@{
    ViewData["Title"] = "Feedback Enviado";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-success">
                <div class="card-body text-center py-5">
                    <div class="mb-4">
                        <i class="fas fa-check-circle text-success" style="font-size: 5rem;"></i>
                    </div>
                    <h3 class="text-success mb-3">¡Feedback enviado exitosamente!</h3>
                    <p class="text-muted mb-4">
                        Gracias por compartir su opinión. Su feedback ha sido recibido y será 
                        revisado por nuestro equipo. Le notificaremos cuando tengamos una respuesta.
                    </p>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <a href="@Url.Action("Index")" class="btn btn-outline-primary">
                            <i class="fas fa-comment-dots me-1"></i>Enviar otro Feedback
                        </a>
                        <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-primary">
                            <i class="fas fa-home me-1"></i>Ir al Inicio
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
