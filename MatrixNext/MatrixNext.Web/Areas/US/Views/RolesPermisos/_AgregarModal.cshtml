@model MatrixNext.Data.Modules.US.RolesPermisos.Models.RolPermisoCreateDto

<div class="modal-header bg-primary text-white">
    <h5 class="modal-title">
        <i class="fas fa-plus me-2"></i>Agregar Rol al Permiso
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
</div>

<form id="formAgregar" asp-action="Guardar" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="PermisoId" />

    <div class="modal-body">
        <div class="mb-3">
            <label asp-for="RolId" class="form-label">
                <i class="fas fa-user-tag me-1"></i>Rol <span class="text-danger">*</span>
            </label>
            <select asp-for="RolId" asp-items="@ViewBag.Roles" class="form-select">
                <option value="">-- Seleccione un rol --</option>
            </select>
            <span asp-validation-for="RolId" class="text-danger"></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="fas fa-times me-1"></i>Cancelar
        </button>
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save me-1"></i>Guardar
        </button>
    </div>
</form>
