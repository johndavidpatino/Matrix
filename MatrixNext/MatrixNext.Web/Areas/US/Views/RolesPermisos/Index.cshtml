@model IEnumerable<MatrixNext.Data.Modules.US.RolesPermisos.Models.RolPermisoDto>
@{
    ViewData["Title"] = "Roles del Permiso";
    var permisoId = ViewBag.PermisoId;
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-user-lock me-2"></i>Roles asignados al Permiso #@permisoId
                    </h5>
                    <button type="button" class="btn btn-light btn-sm" onclick="abrirAgregar()">
                        <i class="fas fa-plus me-1"></i>Agregar Rol
                    </button>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div id="listaRoles">
                        <partial name="_Lista" model="Model" />
                    </div>
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("Index", "Permisos")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Volver a Permisos
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal container -->
<div class="modal fade" id="modalRolPermiso" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="modalContent">
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var permisoId = @permisoId;

        function abrirAgregar() {
            $.get('@Url.Action("Agregar")'.replace('Agregar', permisoId + '/Agregar'), function (html) {
                $('#modalContent').html(html);
                var modal = new bootstrap.Modal(document.getElementById('modalRolPermiso'));
                modal.show();
            });
        }

        function confirmarEliminar(rolId) {
            $.get('@Url.Action("Eliminar", new { permisoId = 0, rolId = 0 })'.replace('/0/', '/' + permisoId + '/').replace('/0', '/' + rolId), function (html) {
                $('#modalContent').html(html);
                var modal = new bootstrap.Modal(document.getElementById('modalRolPermiso'));
                modal.show();
            });
        }

        function refrescarLista() {
            $.get('@Url.Action("Lista")'.replace('Lista', permisoId + '/Lista'), function (html) {
                $('#listaRoles').html(html);
            });
        }

        $(document).on('submit', '#formAgregar, #formEliminar', function (e) {
            e.preventDefault();
            var form = $(this);
            
            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                success: function (response) {
                    if (response.success) {
                        bootstrap.Modal.getInstance(document.getElementById('modalRolPermiso')).hide();
                        refrescarLista();
                        toastr.success(response.message);
                    } else {
                        toastr.error(response.message);
                    }
                },
                error: function () {
                    toastr.error('Error al procesar la solicitud');
                }
            });
        });
    </script>
}
