@model IEnumerable<MatrixNext.Data.Modules.US.RolesPermisos.Models.RolPermisoDto>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>No hay roles asignados a este permiso.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-striped">
            <thead class="table-light">
                <tr>
                    <th style="width: 80px">ID</th>
                    <th>Rol</th>
                    <th style="width: 100px">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.RolId</td>
                        <td>@item.NombreRol</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-danger" 
                                    onclick="confirmarEliminar(@item.RolId)" title="Eliminar asignación">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
