@model MatrixNext.Data.DTOs.INV.MantenimientoEquipoDto

@{
    var isEdit = Model.IdMantenimiento > 0;
    var title = isEdit ? "Editar Mantenimiento" : "Nuevo Mantenimiento";
}

<div class="modal fade" id="modalMantenimiento" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" data-ajax-form id="formMantenimiento">
                @Html.AntiForgeryToken()
                @if (isEdit)
                {
                    <input type="hidden" asp-for="IdMantenimiento" />
                }
                
                <div class="modal-header bg-primary">
                    <h5 class="modal-title">
                        <i class="fas fa-wrench"></i> @title
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal">
                        <span>&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none;"></div>

                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group">
                                <label asp-for="IdActivoFijo" class="required">Activo Fijo</label>
                                <select asp-for="IdActivoFijo" class="form-control select2" required @(isEdit ? "disabled" : "")>
                                    <option value="">Seleccione un activo...</option>
                                    @* TODO: Cargar desde ViewBag.ActivosFijos *@
                                </select>
                                @if (isEdit)
                                {
                                    <input type="hidden" asp-for="IdActivoFijo" />
                                }
                                <span asp-validation-for="IdActivoFijo" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Fecha" class="required">Fecha Mantenimiento</label>
                                <input asp-for="Fecha" type="date" class="form-control" required />
                                <span asp-validation-for="Fecha" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label asp-for="Observaciones" class="required">Observaciones</label>
                                <textarea asp-for="Observaciones" class="form-control" rows="5" maxlength="1000" required
                                          placeholder="Descripción detallada del mantenimiento: problema detectado, acciones realizadas, repuestos cambiados, recomendaciones..."></textarea>
                                <span asp-validation-for="Observaciones" class="text-danger"></span>
                                <small class="form-text text-muted">Mínimo 10 caracteres</small>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        <strong>Nota:</strong> El registro de mantenimiento ayuda a mantener el historial del equipo y programar futuros servicios.
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
