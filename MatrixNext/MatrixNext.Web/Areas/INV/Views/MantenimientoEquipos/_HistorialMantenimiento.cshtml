@model IEnumerable<MatrixNext.Data.DTOs.INV.MantenimientoEquipoDto>

@{
    var idActivo = ViewBag.IdActivo;
}

<div class="card">
    <div class="card-header bg-info">
        <h5 class="mb-0">
            <i class="fas fa-history"></i> Historial de Mantenimientos
        </h5>
    </div>
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="timeline">
                @foreach (var mant in Model.OrderByDescending(m => m.Fecha))
                {
                    <div class="time-label">
                        <span class="bg-info">@mant.Fecha.ToString("dd MMM yyyy")</span>
                    </div>
                    <div>
                        <i class="fas fa-wrench bg-primary"></i>
                        <div class="timeline-item">
                            <span class="time">
                                <i class="fas fa-clock"></i> @mant.Fecha.ToString("HH:mm")
                            </span>
                            <h3 class="timeline-header">
                                Mantenimiento registrado por @mant.NombreRegistrador
                            </h3>
                            <div class="timeline-body">
                                @mant.Observaciones
                            </div>
                            @if (!string.IsNullOrEmpty(mant.MarcaModelo))
                            {
                                <div class="timeline-footer">
                                    <small class="text-muted">
                                        Equipo: @mant.PlacaActivo - @mant.MarcaModelo
                                    </small>
                                </div>
                            }
                        </div>
                    </div>
                }
                <div>
                    <i class="fas fa-clock bg-gray"></i>
                </div>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-toolbox fa-3x mb-3"></i>
                <p>No hay registros de mantenimiento para este equipo</p>
                <button type="button" 
                        class="btn btn-primary" 
                        data-ajax-modal 
                        data-url="@Url.Action("Create", new { idActivo = idActivo })">
                    <i class="fas fa-plus"></i> Registrar Primer Mantenimiento
                </button>
            </div>
        }
    </div>
</div>

<style>
.timeline {
    position: relative;
    margin: 0 0 30px;
    padding: 0;
    list-style: none;
}

.timeline:before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 4px;
    background: #ddd;
    left: 31px;
    margin: 0;
    border-radius: 2px;
}

.timeline > div {
    margin-right: 10px;
    position: relative;
}

.timeline > div > .timeline-item {
    box-shadow: 0 1px 1px rgba(0,0,0,0.1);
    border-radius: 3px;
    margin-top: 0;
    background: #fff;
    color: #444;
    margin-left: 60px;
    margin-right: 15px;
    padding: 0;
    position: relative;
}

.timeline > div > .fa,
.timeline > div > .fas,
.timeline > div > .far,
.timeline > div > .fab,
.timeline > div > .ion {
    width: 30px;
    height: 30px;
    font-size: 15px;
    line-height: 30px;
    position: absolute;
    color: #666;
    background: #d2d6de;
    border-radius: 50%;
    text-align: center;
    left: 18px;
    top: 0;
}

.timeline > .time-label > span {
    font-weight: 600;
    padding: 5px;
    display: inline-block;
    background-color: #fff;
    border-radius: 4px;
}

.timeline-header {
    margin: 0;
    color: #555;
    border-bottom: 1px solid #f4f4f4;
    padding: 10px;
    font-size: 16px;
    line-height: 1.1;
}

.timeline-body {
    padding: 10px;
}

.timeline-footer {
    padding: 10px;
    background: #f4f4f4;
    border-top: 1px solid #ddd;
}

.time {
    color: #999;
    float: right;
    padding: 10px;
    font-size: 12px;
}
</style>
