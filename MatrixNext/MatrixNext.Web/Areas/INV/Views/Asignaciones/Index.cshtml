@model IEnumerable<MatrixNext.Data.DTOs.INV.AsignacionListDto>

@{
    ViewData["Title"] = "Asignaciones de Activos - Inventario";
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0">Asignaciones de Activos</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home", new { area = "" })">Inicio</a></li>
                        <li class="breadcrumb-item">Inventario</li>
                        <li class="breadcrumb-item active">Asignaciones</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-8">
                            <h3 class="card-title">Listado de Asignaciones</h3>
                        </div>
                        <div class="col-md-4 text-right">
                            <button type="button" class="btn btn-primary" data-ajax-modal data-url="@Url.Action("Create")">
                                <i class="fas fa-user-plus"></i> Nueva Asignación
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Filtros -->
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <input type="text" id="filtroTexto" class="form-control" placeholder="Buscar por placa, usuario...">
                        </div>
                        <div class="col-md-3">
                            <input type="date" id="filtroFechaDesde" class="form-control" placeholder="Desde">
                        </div>
                        <div class="col-md-3">
                            <input type="date" id="filtroFechaHasta" class="form-control" placeholder="Hasta">
                        </div>
                        <div class="col-md-3">
                            <button type="button" id="btnFiltrar" class="btn btn-info btn-block">
                                <i class="fas fa-search"></i> Filtrar
                            </button>
                        </div>
                    </div>

                    <!-- Grid -->
                    <div id="gridContainer" data-grid-url="@Url.Action("Index")">
                        @Html.Partial("_AsignacionesGrid", Model)
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Modal Container -->
<div id="modalContainer"></div>

@section Scripts {
    <script src="~/js/inventario/asignaciones.js"></script>
}
