@{
    ViewData["Title"] = "Reporte de Remanente";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var tiposArticulo = ViewBag.TiposArticulo as IEnumerable<(long Id, string Nombre)> ?? Enumerable.Empty<(long, string)>();
    var tiposProducto = ViewBag.TiposProducto as IEnumerable<(long Id, string Nombre)> ?? Enumerable.Empty<(long, string)>();
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <h3><i class="fas fa-boxes"></i> Reporte de Remanente</h3>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-area="INV" asp-controller="RegistroArticulos" asp-action="Index">Inventario</a></li>
                    <li class="breadcrumb-item active">Reporte Remanente</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card mb-3">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-filter"></i> Filtros de Búsqueda
        </div>
        <div class="card-body">
            <form id="formFiltros">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="articulo">Tipo Artículo</label>
                            <select class="form-control" id="articulo" name="articulo">
                                <option value="">-- Todos --</option>
                                @foreach (var tipo in tiposArticulo)
                                {
                                    <option value="@tipo.Id">@tipo.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3" id="divTipoProducto" style="display:none;">
                        <div class="form-group">
                            <label for="tipoProducto">Tipo Producto</label>
                            <select class="form-control" id="tipoProducto" name="tipoProducto">
                                <option value="">-- Todos --</option>
                                @foreach (var tipo in tiposProducto)
                                {
                                    <option value="@tipo.Id">@tipo.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="jobBook">JobBook</label>
                            <input type="text" class="form-control" id="jobBook" name="jobBook" placeholder="Código o nombre">
                        </div>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <div class="form-group mb-0">
                            <button type="button" class="btn btn-primary" id="btnBuscar">
                                <i class="fas fa-search"></i> Buscar
                            </button>
                            <button type="button" class="btn btn-success" id="btnExportar" disabled>
                                <i class="fas fa-file-excel"></i> Exportar
                            </button>
                            <button type="button" class="btn btn-secondary" id="btnLimpiar">
                                <i class="fas fa-eraser"></i> Limpiar
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Resultados -->
    <div class="card">
        <div class="card-header">
            <i class="fas fa-table"></i> Resultados
            <span id="totalRegistros" class="badge bg-info float-end"></span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="tblRemanente" class="table table-striped table-bordered table-sm">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Artículo</th>
                            <th>Tipo Producto</th>
                            <th>Producto</th>
                            <th>Tipo Obsequio</th>
                            <th>Estado</th>
                            <th>Tipo Bono</th>
                            <th>Fecha</th>
                            <th>JobBook</th>
                            <th>Total</th>
                            <th>Disponible</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyRemanente">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Mostrar/ocultar tipo producto según artículo
            $('#articulo').change(function() {
                if ($(this).val() == '7') { // Obsequios
                    $('#divTipoProducto').show();
                } else {
                    $('#divTipoProducto').hide();
                    $('#tipoProducto').val('');
                }
            });

            // Buscar
            $('#btnBuscar').click(function() {
                buscarRemanente();
            });

            // Exportar
            $('#btnExportar').click(function() {
                exportarExcel();
            });

            // Limpiar
            $('#btnLimpiar').click(function() {
                $('#formFiltros')[0].reset();
                $('#divTipoProducto').hide();
                $('#tbodyRemanente').html('');
                $('#totalRegistros').text('');
                $('#btnExportar').prop('disabled', true);
            });
        });

        function buscarRemanente() {
            const filtros = {
                articulo: $('#articulo').val() || null,
                tipoProducto: $('#tipoProducto').val() || null,
                jobBook: $('#jobBook').val() || null
            };

            $('#btnBuscar').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Buscando...');

            $.ajax({
                url: '@Url.Action("BuscarRemanente", "Reportes", new { area = "INV" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(filtros),
                success: function(response) {
                    if (response.success) {
                        renderizarTabla(response.data);
                        $('#totalRegistros').text(`${response.data.length} registros`);
                        $('#btnExportar').prop('disabled', response.data.length === 0);
                    } else {
                        toastr.error(response.message || 'Error al buscar');
                    }
                },
                error: function() {
                    toastr.error('Error de conexión');
                },
                complete: function() {
                    $('#btnBuscar').prop('disabled', false).html('<i class="fas fa-search"></i> Buscar');
                }
            });
        }

        function renderizarTabla(datos) {
            let html = '';
            datos.forEach(item => {
                html += `<tr>
                    <td>${item.idConsumible || ''}</td>
                    <td>${item.articulo || ''}</td>
                    <td>${item.tipoProducto || ''}</td>
                    <td>${item.producto || ''}</td>
                    <td>${item.tipoObsequio || ''}</td>
                    <td>${item.estadoProducto || ''}</td>
                    <td>${item.tipoBono || ''}</td>
                    <td>${item.fecha ? new Date(item.fecha).toLocaleDateString('es-CO') : ''}</td>
                    <td>${item.jobBookCodigo || ''} - ${item.jobBookNombre || ''}</td>
                    <td class="text-end">${item.total || 0}</td>
                    <td class="text-end"><strong>${item.disponible || 0}</strong></td>
                </tr>`;
            });
            $('#tbodyRemanente').html(html || '<tr><td colspan="11" class="text-center">No se encontraron registros</td></tr>');
        }

        function exportarExcel() {
            const filtros = {
                articulo: $('#articulo').val() || null,
                tipoProducto: $('#tipoProducto').val() || null,
                jobBook: $('#jobBook').val() || null
            };

            $('#btnExportar').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Exportando...');

            $.ajax({
                url: '@Url.Action("ExportarRemanente", "Reportes", new { area = "INV" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(filtros),
                xhrFields: { responseType: 'blob' },
                success: function(blob) {
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `ReporteRemanente_${new Date().toISOString().slice(0,10)}.xlsx`;
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    toastr.success('Archivo exportado correctamente');
                },
                error: function() {
                    toastr.error('Error al exportar');
                },
                complete: function() {
                    $('#btnExportar').prop('disabled', false).html('<i class="fas fa-file-excel"></i> Exportar');
                }
            });
        }
    </script>
}
