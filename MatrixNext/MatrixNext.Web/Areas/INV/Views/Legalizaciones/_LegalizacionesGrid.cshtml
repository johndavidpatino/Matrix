@model IEnumerable<MatrixNext.Data.DTOs.INV.LegalizacionDto>

<div class="table-responsive">
    <table class="table table-bordered table-striped table-hover">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Usuario</th>
                <th class="text-right">Valor</th>
                <th class="text-right">Firmas</th>
                <th class="text-right">Devoluciones</th>
                <th class="text-right">Notas Créd.</th>
                <th class="text-right">Desc. Nómina</th>
                <th class="text-right">Pendiente</th>
                <th>Estado</th>
                <th width="100">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var leg in Model)
                {
                    <tr class="@(leg.Verificado ? "table-success" : "")">
                        <td>@leg.FechaLegalizacion.ToString("dd/MM/yyyy")</td>
                        <td>@leg.NombreUsuario</td>
                        <td class="text-right">@(leg.ValorLegalizado?.ToString("C0") ?? "-")</td>
                        <td class="text-right">@((leg.Firmas ?? 0).ToString("C0"))</td>
                        <td class="text-right">@((leg.Devoluciones ?? 0).ToString("C0"))</td>
                        <td class="text-right">@((leg.NotasCredito ?? 0).ToString("C0"))</td>
                        <td class="text-right">@((leg.DescuentoNomina ?? 0).ToString("C0"))</td>
                        <td class="text-right">
                            <strong class="@((leg.Pendiente ?? 0) > 0 ? "text-danger" : "text-success")">
                                @(leg.Pendiente?.ToString("C0") ?? "-")
                            </strong>
                        </td>
                        <td>
                            @if (leg.Verificado)
                            {
                                <span class="badge badge-success">
                                    <i class="fas fa-check-circle"></i> Verificada
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-warning">
                                    <i class="fas fa-clock"></i> Pendiente
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group" role="group">
                                @if (!leg.Verificado)
                                {
                                    <button type="button" 
                                            class="btn btn-sm btn-warning" 
                                            data-ajax-modal 
                                            data-url="@Url.Action("Edit", new { id = leg.IdLegalizacion })"
                                            title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button type="button" 
                                            class="btn btn-sm btn-success" 
                                            data-verificar-legalizacion 
                                            data-id="@leg.IdLegalizacion"
                                            title="Verificar">
                                        <i class="fas fa-check"></i>
                                    </button>
                                    <button type="button" 
                                            class="btn btn-sm btn-danger" 
                                            data-delete-legalizacion 
                                            data-id="@leg.IdLegalizacion"
                                            title="Eliminar">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-secondary" disabled title="No se puede modificar (verificada)">
                                        <i class="fas fa-lock"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" class="text-center text-muted py-4">
                        <i class="fas fa-inbox fa-3x mb-3"></i>
                        <p>No se encontraron legalizaciones</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
