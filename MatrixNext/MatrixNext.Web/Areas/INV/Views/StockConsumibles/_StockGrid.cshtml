@model IEnumerable<MatrixNext.Data.DTOs.INV.StockConsumibleListDto>

<div class="table-responsive">
    <table class="table table-bordered table-striped table-hover">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Consumible</th>
                <th>Tipo Movimiento</th>
                <th class="text-right">Cantidad</th>
                <th class="text-right">Total ($)</th>
                <th class="text-right">Disponible</th>
                <th>Usuario</th>
                <th>Observaciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var mov in Model)
                {
                    <tr>
                        <td>@mov.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@mov.NombreConsumible</td>
                        <td>
                            @if (mov.TipoMovimiento == 1)
                            {
                                <span class="badge badge-success">
                                    <i class="fas fa-arrow-down"></i> Entrada
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-danger">
                                    <i class="fas fa-arrow-up"></i> Salida
                                </span>
                            }
                        </td>
                        <td class="text-right">@mov.Cantidad</td>
                        <td class="text-right">
                            @if (mov.Total.HasValue)
                            {
                                @mov.Total.Value.ToString("C0")
                            }
                            else
                            {
                                <text>-</text>
                            }
                        </td>
                        <td class="text-right">
                            @if (mov.Disponible.HasValue)
                            {
                                <strong class="@(mov.Disponible.Value < 10 ? "text-danger" : "text-success")">
                                    @mov.Disponible.Value
                                </strong>
                            }
                            else
                            {
                                <text>-</text>
                            }
                        </td>
                        <td>@mov.NombreUsuario</td>
                        <td>
                            @if (!string.IsNullOrEmpty(mov.Observaciones))
                            {
                                var preview = mov.Observaciones.Length > 40 
                                    ? mov.Observaciones.Substring(0, 40) + "..." 
                                    : mov.Observaciones;
                                <text>@preview</text>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        <i class="fas fa-inbox fa-3x mb-3"></i>
                        <p>No se encontraron movimientos</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
