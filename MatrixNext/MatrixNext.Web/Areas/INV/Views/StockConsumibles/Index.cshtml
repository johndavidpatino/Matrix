@model IEnumerable<MatrixNext.Data.DTOs.INV.StockConsumibleListDto>

@{
    ViewData["Title"] = "Stock de Consumibles - Inventario";
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0">Stock de Consumibles</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home", new { area = "" })">Inicio</a></li>
                        <li class="breadcrumb-item">Inventario</li>
                        <li class="breadcrumb-item active">Stock Consumibles</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-8">
                            <h3 class="card-title">Movimientos de Stock</h3>
                        </div>
                        <div class="col-md-4 text-right">
                            <a href="@Url.Action("PorLegalizar")" class="btn btn-warning mr-2">
                                <i class="fas fa-clipboard-list"></i> Por Legalizar
                            </a>
                            <button type="button" class="btn btn-primary" data-ajax-modal data-url="@Url.Action("Create")">
                                <i class="fas fa-plus"></i> Nuevo Movimiento
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Filtros -->
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <select id="filtroConsumible" class="form-control">
                                <option value="">Todos los consumibles</option>
                                @if (ViewBag.Consumibles != null)
                                {
                                    foreach (var consumible in ViewBag.Consumibles)
                                    {
                                        <option value="@consumible.Id">@consumible.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select id="filtroTipoMovimiento" class="form-control">
                                <option value="">Todos los movimientos</option>
                                <option value="1">Entrada</option>
                                <option value="2">Salida</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <input type="date" id="filtroFechaDesde" class="form-control" placeholder="Desde">
                        </div>
                        <div class="col-md-2">
                            <input type="date" id="filtroFechaHasta" class="form-control" placeholder="Hasta">
                        </div>
                        <div class="col-md-2">
                            <button type="button" id="btnFiltrar" class="btn btn-info btn-block">
                                <i class="fas fa-search"></i> Filtrar
                            </button>
                        </div>
                    </div>

                    <!-- Grid -->
                    <div id="gridContainer" data-grid-url="@Url.Action("Index")">
                        @await Html.PartialAsync("_StockGrid", Model)
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Modal Container -->
<div id="modalContainer"></div>

@section Scripts {
    <script src="~/js/inventario/stock-consumibles.js"></script>
}
