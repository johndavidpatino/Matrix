@model List<MatrixNext.Web.Models.OP.EstimacionCiudadListItemVM>
@{
    ViewData["Title"] = "Estimación de Producción";
    var trabajoId = ViewBag.TrabajoId;
    var trabajoNombre = ViewBag.TrabajoNombre;
    var jobBook = ViewBag.JobBook;
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-3">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Portal OP</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Trabajos" asp-action="Index">Trabajos</a></li>
                    <li class="breadcrumb-item active">Estimación de Producción</li>
                </ol>
            </nav>
            <h2>Estimación de Producción</h2>
            <p class="text-muted">
                <strong>Trabajo:</strong> @trabajoNombre (@jobBook) | <strong>ID:</strong> @trabajoId
            </p>
        </div>
    </div>

    <!-- Botón Crear Nueva Estimación -->
    <div class="row mb-3">
        <div class="col-12">
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevaEstimacion">
                <i class="bi bi-plus-circle"></i> Nueva Estimación
            </button>
            <a asp-controller="Trabajos" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver a Trabajos
            </a>
        </div>
    </div>

    <!-- Grid de Estimaciones -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Estimaciones Creadas</h5>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <table class="table table-hover table-striped" id="tblEstimaciones">
                            <thead class="table-dark">
                                <tr>
                                    <th>Ciudad</th>
                                    <th>Fecha Estimación</th>
                                    <th>Realizado por</th>
                                    <th>Observaciones</th>
                                    <th>Activa</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var estimacion in Model)
                                {
                                    <tr data-id="@estimacion.Id">
                                        <td>@estimacion.Ciudad</td>
                                        <td>@estimacion.FechaEstimacion?.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@estimacion.UsuarioNombre</td>
                                        <td>@(estimacion.Observaciones ?? "-")</td>
                                        <td>
                                            @if (estimacion.Activa)
                                            {
                                                <span class="badge bg-success">Activa</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactiva</span>
                                            }
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-info btn-ver-planeacion"
                                                    data-id="@estimacion.Id">
                                                <i class="bi bi-calendar3"></i> Ver Planeación
                                            </button>
                                            @if (!estimacion.Activa && !estimacion.Bloqueada)
                                            {
                                                <button type="button" class="btn btn-sm btn-success btn-activar"
                                                        data-id="@estimacion.Id">
                                                    <i class="bi bi-check-circle"></i> Activar
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> No hay estimaciones creadas para este trabajo.
                            Haga clic en "Nueva Estimación" para comenzar.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Placeholder para Planeación Detallada -->
    <div class="row mt-4" id="divPlaneacion" style="display:none;">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Planeación Diaria</h5>
                </div>
                <div class="card-body" id="planeacionContent">
                    <!-- Se carga via AJAX -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Nueva Estimación -->
<div class="modal fade" id="modalNuevaEstimacion" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TrabajoId" value="@trabajoId" />

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Nueva Estimación de Producción</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="CiudadId" class="form-label">Ciudad <span class="text-danger">*</span></label>
                        <select name="CiudadId" id="CiudadId" class="form-select" required>
                            <option value="">-- Seleccione Ciudad --</option>
                            <option value="11001">Bogotá</option>
                            <option value="5001">Medellín</option>
                            <option value="76001">Cali</option>
                            <option value="8001">Barranquilla</option>
                            <option value="68001">Bucaramanga</option>
                            <option value="13001">Cartagena</option>
                            <option value="17001">Manizales</option>
                            <option value="66001">Pereira</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Días Incluidos en Planeación</label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Lunes" id="chkLunes" checked />
                            <label class="form-check-label" for="chkLunes">Lunes</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Martes" id="chkMartes" checked />
                            <label class="form-check-label" for="chkMartes">Martes</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Miercoles" id="chkMiercoles" checked />
                            <label class="form-check-label" for="chkMiercoles">Miércoles</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Jueves" id="chkJueves" checked />
                            <label class="form-check-label" for="chkJueves">Jueves</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Viernes" id="chkViernes" checked />
                            <label class="form-check-label" for="chkViernes">Viernes</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Sabado" id="chkSabado" />
                            <label class="form-check-label" for="chkSabado">Sábado</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Domingo" id="chkDomingo" />
                            <label class="form-check-label" for="chkDomingo">Domingo</label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="ExcluirFestivos" id="chkFestivos" checked />
                            <label class="form-check-label" for="chkFestivos">
                                Excluir días festivos de la planeación
                            </label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="Observaciones" class="form-label">Observaciones</label>
                        <textarea name="Observaciones" id="Observaciones" class="form-control" rows="3" maxlength="500"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Crear Estimación</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Activar Estimación -->
<div class="modal fade" id="modalActivarEstimacion" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formActivar" asp-action="Activar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="activarId" />
                <input type="hidden" name="trabajoId" value="@trabajoId" />

                <div class="modal-header bg-warning">
                    <h5 class="modal-title">Confirmar Activación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro de activar esta estimación?</p>
                    <p class="text-muted">Se desactivarán otras estimaciones de la misma ciudad.</p>
                    <div id="validacionActivar" class="mt-3"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning" id="btnConfirmarActivar">Activar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Ver planeación (AJAX)
            $('.btn-ver-planeacion').on('click', function () {
                const estimacionId = $(this).data('id');
                $('#planeacionContent').html('<div class="text-center"><div class="spinner-border" role="status"></div></div>');
                $('#divPlaneacion').show();

                $.get('@Url.Action("Detalle")?id=' + estimacionId, function (html) {
                    $('#planeacionContent').html(html);
                    $('html, body').animate({ scrollTop: $('#divPlaneacion').offset().top }, 500);
                }).fail(function () {
                    toastr.error('Error al cargar la planeación');
                    $('#divPlaneacion').hide();
                });
            });

            // Activar estimación
            $('.btn-activar').on('click', function () {
                const estimacionId = $(this).data('id');
                $('#activarId').val(estimacionId);
                $('#validacionActivar').html('<div class="text-center"><div class="spinner-border spinner-border-sm" role="status"></div> Validando...</div>');

                // Validar antes de mostrar modal
                $.get('@Url.Action("Validar")?id=' + estimacionId, function (result) {
                    if (result.esValido) {
                        $('#validacionActivar').html('<div class="alert alert-success"><i class="bi bi-check-circle"></i> ' + result.mensaje + '</div>');
                        $('#btnConfirmarActivar').prop('disabled', false);
                    } else {
                        $('#validacionActivar').html('<div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> ' + result.mensaje + '</div>');
                        $('#btnConfirmarActivar').prop('disabled', true);
                    }
                }).fail(function () {
                    $('#validacionActivar').html('<div class="alert alert-danger">Error al validar la estimación</div>');
                    $('#btnConfirmarActivar').prop('disabled', true);
                });

                $('#modalActivarEstimacion').modal('show');
            });
        });
    </script>
}
