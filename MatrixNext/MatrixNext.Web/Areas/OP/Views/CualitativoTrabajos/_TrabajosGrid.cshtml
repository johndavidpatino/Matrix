@model List<MatrixNext.Web.Services.OP.Models.TrabajoCualitativoVm>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Unidad</th>
            <th>COE</th>
            <th>Tipo</th>
            <th>Estado</th>
            <th>Inicio Campo</th>
            <th>Fin Campo</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr>
                <td colspan="9" class="text-center text-muted">No hay trabajos para los filtros seleccionados.</td>
            </tr>
        }
        else
        {
            foreach (var t in Model)
            {
                <tr>
                    <td>@t.Id</td>
                    <td>@t.Nombre</td>
                    <td>@t.UnidadNegocio</td>
                    <td>@t.CoeNombre</td>
                    <td>@t.TipoDescripcion</td>
                    <td>@t.Estado</td>
                    <td>@(t.FechaInicioCampo?.ToString("yyyy-MM-dd") ?? "")</td>
                    <td>@(t.FechaFinCampo?.ToString("yyyy-MM-dd") ?? "")</td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-primary" title="Configurar" onclick="abrirModalConfiguracion(@t.Id)">
                                <i class="bi bi-gear"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary" title="Ficha Entrevista" onclick="navigateTo(@t.Id, 'FichaEntrevista')">
                                <i class="bi bi-file-text"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary" title="Ficha Sesión" onclick="navigateTo(@t.Id, 'FichaSesion')">
                                <i class="bi bi-people"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary" title="Ficha Observación" onclick="navigateTo(@t.Id, 'FichaObservacion')">
                                <i class="bi bi-eye"></i>
                            </button>
                            <button type="button" class="btn btn-outline-info" title="Muestra" onclick="navigateTo(@t.Id, 'Muestra')">
                                <i class="bi bi-diagram-3"></i>
                            </button>
                            <button type="button" class="btn btn-outline-success" title="Filtro Reclutamiento" onclick="navigateTo(@t.Id, 'FiltroReclutamiento')">
                                <i class="bi bi-filter"></i>
                            </button>
                            <button type="button" class="btn btn-outline-success" title="Filtro Asistencia" onclick="navigateTo(@t.Id, 'FiltroAsistencia')">
                                <i class="bi bi-filter-square"></i>
                            </button>
                            <button type="button" class="btn btn-outline-warning" title="Campo" onclick="navigateTo(@t.Id, 'Campo')">
                                <i class="bi bi-clipboard-check"></i>
                            </button>
                            <button type="button" class="btn btn-outline-warning" title="Programación" onclick="navigateTo(@t.Id, 'Programacion')">
                                <i class="bi bi-calendar2-event"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
