@model IEnumerable<MatrixNext.Web.Services.OP.Models.TrabajoCualitativoVm>
@{
    ViewData["Title"] = "Trabajos Cualitativos";
    var esCoordinador = ViewBag.EsCoordinador ?? false;
    var coeId = ViewBag.CoeId ?? (long?)null;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>
        <div class="btn-group">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Nuevo Trabajo
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <form method="get" asp-action="Index" id="filterForm">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label for="coeId" class="form-label">COE</label>
                        <input type="number" name="coeId" id="coeId" class="form-control" value="@coeId" placeholder="ID Coordinador" />
                    </div>
                    <div class="col-md-3">
                        <label for="nombre" class="form-label">Nombre Trabajo</label>
                        <input type="text" name="nombre" id="nombre" class="form-control" placeholder="Buscar por nombre..." />
                    </div>
                    <div class="col-md-3">
                        <label for="estado" class="form-label">Estado</label>
                        <select name="estado" id="estado" class="form-select">
                            <option value="">Todos</option>
                            <option value="Activo">Activo</option>
                            <option value="En Progreso">En Progreso</option>
                            <option value="Finalizado">Finalizado</option>
                            <option value="Cancelado">Cancelado</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary flex-fill">
                            <i class="bi bi-x-circle"></i> Limpiar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            @if (Model?.Any() == true)
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="trabajosTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Unidad Negocio</th>
                                <th>COE</th>
                                <th>Tipo</th>
                                <th>Estado</th>
                                <th>Fecha Campo</th>
                                <th>Tipo Recolección</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var trabajo in Model)
                            {
                                <tr>
                                    <td>@trabajo.Id</td>
                                    <td>@trabajo.Nombre</td>
                                    <td>@trabajo.UnidadNegocio</td>
                                    <td>@trabajo.CoeNombre</td>
                                    <td>@trabajo.TipoDescripcion</td>
                                    <td>
                                        <span class="badge bg-@(trabajo.Estado == "Activo" ? "success" : trabajo.Estado == "Finalizado" ? "secondary" : "primary")">
                                            @trabajo.Estado
                                        </span>
                                    </td>
                                    <td>
                                        @if (trabajo.FechaInicioCampo.HasValue)
                                        {
                                            @trabajo.FechaInicioCampo.Value.ToString("dd/MM/yyyy")
                                        }
                                    </td>
                                    <td>@trabajo.TipoRecoleccionDescripcion</td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@trabajo.Id" class="btn btn-info" title="Ver detalle">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@trabajo.Id" class="btn btn-warning" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-secondary" title="Configurar" onclick="abrirModalConfiguracion(@trabajo.Id)">
                                                <i class="bi bi-gear"></i>
                                            </button>
                                            <div class="btn-group btn-group-sm">
                                                <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" title="Navegar a...">
                                                    <i class="bi bi-box-arrow-up-right"></i>
                                                </button>
                                                <ul class="dropdown-menu">
                                                    @if (trabajo.TieneFichaEntrevista)
                                                    {
                                                        <li><a class="dropdown-item" asp-action="NavigateTo" asp-route-trabajoId="@trabajo.Id" asp-route-destination="FichaEntrevista">Ficha Entrevista</a></li>
                                                    }
                                                    @if (trabajo.TieneFichaSesion)
                                                    {
                                                        <li><a class="dropdown-item" asp-action="NavigateTo" asp-route-trabajoId="@trabajo.Id" asp-route-destination="FichaSesion">Ficha Sesión</a></li>
                                                    }
                                                    @if (trabajo.TieneFichaObservacion)
                                                    {
                                                        <li><a class="dropdown-item" asp-action="NavigateTo" asp-route-trabajoId="@trabajo.Id" asp-route-destination="FichaObservacion">Ficha Observación</a></li>
                                                    }
                                                    @if (trabajo.TieneMuestra)
                                                    {
                                                        <li><a class="dropdown-item" asp-action="NavigateTo" asp-route-trabajoId="@trabajo.Id" asp-route-destination="Muestra">Muestra</a></li>
                                                    }
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li><a class="dropdown-item" asp-action="NavigateTo" asp-route-trabajoId="@trabajo.Id" asp-route-destination="FiltroReclutamiento">Filtro Reclutamiento</a></li>
                                                    <li><a class="dropdown-item" asp-action="NavigateTo" asp-route-trabajoId="@trabajo.Id" asp-route-destination="FiltroAsistencia">Filtro Asistencia</a></li>
                                                    <li><a class="dropdown-item" asp-action="NavigateTo" asp-route-trabajoId="@trabajo.Id" asp-route-destination="Campo">Campo</a></li>
                                                    <li><a class="dropdown-item" asp-action="NavigateTo" asp-route-trabajoId="@trabajo.Id" asp-route-destination="Programacion">Programación</a></li>
                                                </ul>
                                            </div>
                                            <button type="button" class="btn btn-danger" title="Eliminar" onclick="eliminarTrabajo(@trabajo.Id, '@trabajo.Nombre')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No se encontraron trabajos cualitativos.
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal de Configuración -->
<div class="modal fade" id="modalConfiguracion" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Configurar Trabajo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formConfiguracion">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="configTrabajoId" name="trabajoId" />
                    
                    <div class="mb-3">
                        <label for="fechaInicioCampo" class="form-label">Fecha Inicio Campo</label>
                        <input type="date" class="form-control" id="fechaInicioCampo" name="fechaInicioCampo" />
                    </div>
                    
                    <div class="mb-3">
                        <label for="fechaFinCampo" class="form-label">Fecha Fin Campo</label>
                        <input type="date" class="form-control" id="fechaFinCampo" name="fechaFinCampo" />
                    </div>
                    
                    <div class="mb-3">
                        <label for="tipoRecoleccion" class="form-label">Tipo Recolección</label>
                        <select class="form-select" id="tipoRecoleccion" name="tipoRecoleccion">
                            <option value="1">Presencial</option>
                            <option value="2">Telefónica</option>
                            <option value="3">Online</option>
                            <option value="4">Mixta</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="guardarConfiguracion()">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let modalConfiguracion;

        $(document).ready(function() {
            modalConfiguracion = new bootstrap.Modal(document.getElementById('modalConfiguracion'));

            $('#trabajosTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
                },
                pageLength: 25,
                order: [[0, 'desc']],
                columnDefs: [
                    { orderable: false, targets: -1 }
                ]
            });
        });

        function abrirModalConfiguracion(trabajoId) {
            $.ajax({
                url: '@Url.Action("GetConfiguration")',
                type: 'GET',
                data: { trabajoId: trabajoId },
                success: function(response) {
                    if (response.success) {
                        $('#configTrabajoId').val(response.data.trabajoId);
                        $('#fechaInicioCampo').val(response.data.fechaInicioCampo ? response.data.fechaInicioCampo.split('T')[0] : '');
                        $('#fechaFinCampo').val(response.data.fechaFinCampo ? response.data.fechaFinCampo.split('T')[0] : '');
                        $('#tipoRecoleccion').val(response.data.tipoRecoleccion || 1);
                        modalConfiguracion.show();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function() {
                    alert('Error obteniendo configuración');
                }
            });
        }

        function guardarConfiguracion() {
            const data = {
                trabajoId: parseInt($('#configTrabajoId').val()),
                fechaInicioCampo: $('#fechaInicioCampo').val() || null,
                fechaFinCampo: $('#fechaFinCampo').val() || null,
                tipoRecoleccion: parseInt($('#tipoRecoleccion').val())
            };

            $.ajax({
                url: '@Url.Action("SaveConfiguration")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        modalConfiguracion.hide();
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function() {
                    alert('Error guardando configuración');
                }
            });
        }

        function eliminarTrabajo(id, nombre) {
            if (!confirm(`¿Está seguro que desea eliminar el trabajo "${nombre}"?\n\nEsta acción no se puede deshacer.`)) {
                return;
            }

            $.ajax({
                url: '@Url.Action("Delete")',
                type: 'POST',
                data: { id: id },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function() {
                    alert('Error eliminando trabajo');
                }
            });
        }
    </script>
}
