@model MatrixNext.Web.Services.OP.Models.TrabajoCualitativoVm
@{
    ViewData["Title"] = "Detalle Trabajo";
    var navegacion = ViewBag.Navegacion as MatrixNext.Web.Services.OP.Models.NavigacionTrabajoVm;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]: @Model.Nombre</h2>
        <div class="btn-group">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="bi bi-pencil"></i> Editar
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Volver al Listado
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="mb-0">Información General</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <strong>ID:</strong> @Model.Id
                        </div>
                        <div class="col-md-6">
                            <strong>Estado:</strong>
                            <span class="badge bg-@(Model.Estado == "Activo" ? "success" : Model.Estado == "Finalizado" ? "secondary" : "primary")">
                                @Model.Estado
                            </span>
                        </div>
                        <div class="col-md-12">
                            <strong>Nombre:</strong> @Model.Nombre
                        </div>
                        <div class="col-md-6">
                            <strong>Unidad de Negocio:</strong> @Model.UnidadNegocio
                        </div>
                        <div class="col-md-6">
                            <strong>Coordinador (COE):</strong> @Model.CoeNombre (ID: @Model.CoeId)
                        </div>
                        <div class="col-md-6">
                            <strong>Metodología:</strong> @Model.TipoDescripcion
                        </div>
                        <div class="col-md-6">
                            <strong>Tipo Recolección:</strong> @Model.TipoRecoleccionDescripcion
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="mb-0">Fechas</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <strong>Fecha Inicio:</strong>
                            @if (Model.FechaInicio.HasValue)
                            {
                                @Model.FechaInicio.Value.ToString("dd/MM/yyyy")
                            }
                            else
                            {
                                <span class="text-muted">No definida</span>
                            }
                        </div>
                        <div class="col-md-6">
                            <strong>Fecha Terminación:</strong>
                            @if (Model.FechaTerminacion.HasValue)
                            {
                                @Model.FechaTerminacion.Value.ToString("dd/MM/yyyy")
                            }
                            else
                            {
                                <span class="text-muted">No definida</span>
                            }
                        </div>
                        <div class="col-md-6">
                            <strong>Fecha Inicio Campo:</strong>
                            @if (Model.FechaInicioCampo.HasValue)
                            {
                                @Model.FechaInicioCampo.Value.ToString("dd/MM/yyyy")
                            }
                            else
                            {
                                <span class="text-muted">No configurada</span>
                            }
                        </div>
                        <div class="col-md-6">
                            <strong>Fecha Fin Campo:</strong>
                            @if (Model.FechaFinCampo.HasValue)
                            {
                                @Model.FechaFinCampo.Value.ToString("dd/MM/yyyy")
                            }
                            else
                            {
                                <span class="text-muted">No configurada</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Módulos Asociados</h5>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" disabled @(Model.TieneFichaEntrevista ? "checked" : "")>
                                <label class="form-check-label">Ficha Entrevista</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" disabled @(Model.TieneFichaSesion ? "checked" : "")>
                                <label class="form-check-label">Ficha Sesión</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" disabled @(Model.TieneFichaObservacion ? "checked" : "")>
                                <label class="form-check-label">Ficha Observación</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" disabled @(Model.TieneMuestra ? "checked" : "")>
                                <label class="form-check-label">Muestra</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" disabled @(Model.TieneFiltroReclutamiento ? "checked" : "")>
                                <label class="form-check-label">Filtro Reclutamiento</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" disabled @(Model.TieneFiltroAsistencia ? "checked" : "")>
                                <label class="form-check-label">Filtro Asistencia</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Acciones Rápidas</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        @if (navegacion != null)
                        {
                            @if (navegacion.PuedeIrAFichaEntrevista)
                            {
                                <a asp-action="NavigateTo" asp-route-trabajoId="@Model.Id" asp-route-destination="FichaEntrevista" class="btn btn-outline-primary">
                                    <i class="bi bi-file-text"></i> Ir a Ficha Entrevista
                                </a>
                            }
                            @if (navegacion.PuedeIrAFichaSesion)
                            {
                                <a asp-action="NavigateTo" asp-route-trabajoId="@Model.Id" asp-route-destination="FichaSesion" class="btn btn-outline-primary">
                                    <i class="bi bi-file-text"></i> Ir a Ficha Sesión
                                </a>
                            }
                            @if (navegacion.PuedeIrAFichaObservacion)
                            {
                                <a asp-action="NavigateTo" asp-route-trabajoId="@Model.Id" asp-route-destination="FichaObservacion" class="btn btn-outline-primary">
                                    <i class="bi bi-file-text"></i> Ir a Ficha Observación
                                </a>
                            }
                            @if (navegacion.PuedeIrAMuestra)
                            {
                                <a asp-action="NavigateTo" asp-route-trabajoId="@Model.Id" asp-route-destination="Muestra" class="btn btn-outline-success">
                                    <i class="bi bi-people"></i> Ir a Muestra
                                </a>
                            }
                        }
                        
                        <hr/>
                        
                        <a asp-action="NavigateTo" asp-route-trabajoId="@Model.Id" asp-route-destination="FiltroReclutamiento" class="btn btn-outline-info">
                            <i class="bi bi-funnel"></i> Filtro Reclutamiento
                        </a>
                        <a asp-action="NavigateTo" asp-route-trabajoId="@Model.Id" asp-route-destination="FiltroAsistencia" class="btn btn-outline-info">
                            <i class="bi bi-funnel"></i> Filtro Asistencia
                        </a>
                        <a asp-action="NavigateTo" asp-route-trabajoId="@Model.Id" asp-route-destination="Campo" class="btn btn-outline-warning">
                            <i class="bi bi-calendar-event"></i> Campo
                        </a>
                        <a asp-action="NavigateTo" asp-route-trabajoId="@Model.Id" asp-route-destination="Programacion" class="btn btn-outline-secondary">
                            <i class="bi bi-calendar-check"></i> Programación
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
