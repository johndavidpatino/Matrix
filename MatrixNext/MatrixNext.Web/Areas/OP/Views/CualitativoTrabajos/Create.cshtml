@model MatrixNext.Web.Services.OP.Models.TrabajoCualitativoVm
@{
    ViewData["Title"] = "Nuevo Trabajo Cualitativo";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver al Listado
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label">Nombre Trabajo <span class="text-danger">*</span></label>
                        <input asp-for="Nombre" class="form-control" required maxlength="200" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="CoeId" class="form-label">COE (Coordinador) <span class="text-danger">*</span></label>
                        <input asp-for="CoeId" type="number" class="form-control" required />
                        <span asp-validation-for="CoeId" class="text-danger"></span>
                        <small class="text-muted">ID del coordinador de campo</small>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Tipo" class="form-label">Metodología</label>
                        <select asp-for="Tipo" class="form-select">
                            <option value="">Seleccione...</option>
                            <option value="1">Entrevista Individual</option>
                            <option value="2">Grupo Focal</option>
                            <option value="3">Observación</option>
                            <option value="4">Etnografía</option>
                            <option value="5">Otra</option>
                        </select>
                        <span asp-validation-for="Tipo" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="FechaInicio" class="form-label">Fecha Inicio</label>
                        <input asp-for="FechaInicio" type="date" class="form-control" />
                        <span asp-validation-for="FechaInicio" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="FechaTerminacion" class="form-label">Fecha Terminación</label>
                        <input asp-for="FechaTerminacion" type="date" class="form-control" />
                        <span asp-validation-for="FechaTerminacion" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="TipoRecoleccion" class="form-label">Tipo Recolección</label>
                        <select asp-for="TipoRecoleccion" class="form-select">
                            <option value="1">Presencial</option>
                            <option value="2">Telefónica</option>
                            <option value="3">Online</option>
                            <option value="4">Mixta</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FechaInicioCampo" class="form-label">Fecha Inicio Campo</label>
                        <input asp-for="FechaInicioCampo" type="date" class="form-control" />
                        <span asp-validation-for="FechaInicioCampo" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FechaFinCampo" class="form-label">Fecha Fin Campo</label>
                        <input asp-for="FechaFinCampo" type="date" class="form-control" />
                        <span asp-validation-for="FechaFinCampo" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Crear Trabajo
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
