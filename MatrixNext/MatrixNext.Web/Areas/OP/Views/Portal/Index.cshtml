@using System.Linq
@model MatrixNext.Web.ViewModels.OP.OpPortalViewModel

@{
    ViewData["Title"] = "Portal COE - OP_Cuantitativo";
    var estados = new Dictionary<int, string>
    {
        { 1, "Nuevo" },
        { 2, "Enviado" },
        { 3, "Cerrado" },
        { 11, "Anulado" }
    };
}

<section class="container py-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1>Portal COE - OP Cuantitativo</h1>
            <p class="text-muted mb-0">
                Visualiza trabajos clave y navega a los flujos documentados en
                <a href="/docs/OP/OP_CUANTITATIVO_AVANCE.md" target="_blank">OP_CUANTITATIVO_AVANCE.md</a>.
            </p>
            <div class="mt-2 d-flex gap-2 flex-wrap">
                @if (Model.TienePermiso100)
                {
                    <span class="badge bg-success">Permiso 100 confirmado</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">Permiso 100 requerido</span>
                }
                @if (Model.TienePermisoSupervision)
                {
                    <span class="badge bg-info text-dark">Permiso 157 (Supervisión)</span>
                }
                else
                {
                    <span class="badge bg-danger">Permiso 157 requerido</span>
                }
            </div>
        </div>
        <div class="text-end">
            <small class="text-muted">Plan base documentado en ANALISIS_OP_CUANTITATIVO.md / DIRECTRICES_MIGRACION.md</small>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-3 mt-4">
        <div class="col">
            <div class="card h-100 border-primary">
                <div class="card-body">
                    <h5 class="card-title">Cargas masivas</h5>
                    <p class="card-text">Importar planillas y CATI con validaciones limpias y reuso de CoreProject.</p>
                    <a class="btn btn-outline-primary btn-sm" href="/OP/Avances">Ver estado</a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-success">
                <div class="card-body">
                    <h5 class="card-title">Planillas y productividad</h5>
                    <p class="card-text">Aprobar planillas, revisar productividad por roles y controlar IPS.</p>
                    <a class="btn btn-outline-success btn-sm" href="/docs/OP/OP_CUANTITATIVO_AVANCE.md" target="_blank">Ir al backlog</a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-warning">
                <div class="card-body">
                    <h5 class="card-title">Navegación operativa</h5>
                    <p class="card-text">Sincroniza sesiones, credenciales y cierres con GD/WorkFlow.</p>
                    <a class="btn btn-outline-warning btn-sm" href="/OP/Avances">Documentación</a>
                </div>
            </div>
        </div>
    </div>

    <form method="get" class="row g-3 align-items-end my-4">
        <div class="col-md-4">
            <label class="form-label" for="Busqueda">Búsqueda</label>
            <input type="search" class="form-control" id="Busqueda" name="Busqueda" value="@Model.Filtros.Busqueda" placeholder="Nombre, JobBook">
        </div>
        <div class="col-md-3">
            <label class="form-label" for="Estado">Estado</label>
            <select class="form-select" name="Estado" id="Estado">
                <option value="-1" selected>Todos</option>
                <option value="1" selected="@(Model.Filtros.Estado == 1 ? "selected" : null)">Nuevo</option>
                <option value="2" selected="@(Model.Filtros.Estado == 2 ? "selected" : null)">Enviado</option>
                <option value="3" selected="@(Model.Filtros.Estado == 3 ? "selected" : null)">Cerrado</option>
                <option value="11" selected="@(Model.Filtros.Estado == 11 ? "selected" : null)">Anulado</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">&nbsp;</label>
            <button type="submit" class="btn btn-primary w-100">Filtrar</button>
        </div>
    </form>

    @if (Model.Snapshot?.Supervision is { } supervision)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card text-dark bg-light">
                    <div class="card-body">
                        <h6 class="card-title text-uppercase">Supervisiones</h6>
                        <p class="display-6 mb-1">@supervision.TotalRegistros</p>
                        <small class="text-muted">Registros totales</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-dark bg-light">
                    <div class="card-body">
                        <h6 class="card-title text-uppercase">Hoy</h6>
                        <p class="display-6 mb-1">@supervision.RegistrosHoy</p>
                        <small class="text-muted">Registradas hoy</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white @(supervision.Alertas > 0 ? "bg-danger" : "bg-success")">
                    <div class="card-body">
                        <h6 class="card-title text-uppercase">Alertas</h6>
                        <p class="display-6 mb-1">@supervision.Alertas</p>
                        <small>@(supervision.Alertas > 0 ? "Requieren atención" : "Sin alertas pendientes")</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 border-info">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h6 class="card-title text-uppercase">Supervisión</h6>
                            <p class="card-text small text-muted">Control telefónico y checklist</p>
                        </div>
                        <div class="mt-3">
                            <a class="btn btn-outline-info btn-sm w-100" href="/OP/Supervision">Ir al checklist</a>
                            @if (!Model.TienePermisoSupervision)
                            {
                                <p class="text-warning small mt-2 mb-0">Solicita permiso 157 para registrar supervisiones.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (Model.Produccion is { } produccion)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card text-dark bg-light">
                    <div class="card-body">
                        <h6 class="card-title text-uppercase">Producción</h6>
                        <p class="display-6 mb-1">@produccion.TotalRegistros</p>
                        <small class="text-muted">Registros totales</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-dark bg-light">
                    <div class="card-body">
                        <h6 class="card-title text-uppercase">Hoy</h6>
                        <p class="display-6 mb-1">@produccion.RegistrosHoy</p>
                        <small class="text-muted">Registrados hoy</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-dark bg-light">
                    <div class="card-body">
                        <h6 class="card-title text-uppercase">Última actualización</h6>
                        <p class="display-6 mb-1">@((produccion.UltimaActualizacion.HasValue ? produccion.UltimaActualizacion.Value.ToLocalTime().ToString("g") : "Sin registros"))</p>
                        <small class="text-muted">Fecha registrada</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 border-info">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h6 class="card-title text-uppercase">Registro</h6>
                            <p class="card-text small text-muted">Historial y captura de actividades</p>
                        </div>
                        <div class="mt-3">
                            <a class="btn btn-outline-info btn-sm w-100" href="/OP/Produccion">Ir a producción</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (Model.PresupuestoNotificaciones.Any())
    {
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Solicitudes de presupuesto recientes</span>
                <small class="text-muted">@Model.PresupuestoNotificaciones.Count elementos</small>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var registro in Model.PresupuestoNotificaciones)
                {
                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-start" href="/OP/Presupuestos?trabajoId=@registro.TrabajoId">
                        <div class="flex-grow-1 me-3">
                            <div class="fw-bold">Trabajo @registro.TrabajoId <span class="badge bg-secondary">@registro.Tipo</span></div>
                            <small class="text-muted">@registro.Usuario</small>
                            <div class="text-truncate small" style="max-width: 420px;">@(string.IsNullOrWhiteSpace(registro.Observacion) ? "Sin observación" : registro.Observacion)</div>
                        </div>
                        <div class="text-end">
                            <small class="text-muted">@registro.Fecha.ToLocalTime():g</small>
                        </div>
                    </a>
                }
            </div>
        </div>
    }

    @if (!Model.HasData)
    {
        <div class="alert alert-info">Cargando datos del portal OP...</div>
    }
    else
    {
        var snapshot = Model.Snapshot!;
        <div class="row g-3 mb-4">
            @foreach (var estado in snapshot.EstadoCounts.OrderByDescending(e => e.Value))
            {
                <div class="col-md-3">
                    <div class="card text-center">
                        <div class="card-body">
                            <div class="fs-4 fw-bold">@estado.Value</div>
                            <div class="text-muted">@estados.GetValueOrDefault(estado.Key, $"Estado {estado.Key}")</div>
                        </div>
                    </div>
                </div>
            }
            <div class="col-md-3">
                <div class="card text-center border-secondary">
                    <div class="card-body">
                        <div class="fs-4 fw-bold">@snapshot.Trabajos.TotalCount</div>
                        <div class="text-muted">Total de trabajos</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Trabajo</th>
                        <th>JobBook</th>
                        <th>Proyecto</th>
                        <th>Metodología</th>
                        <th>Estado</th>
                        <th>Última actualización</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (snapshot.Trabajos.Items.Any())
                    {
                        foreach (var item in snapshot.Trabajos.Items)
                        {
                            <tr>
                                <td>@item.Nombre</td>
                                <td>@item.JobBook</td>
                                <td>@item.IdProyecto</td>
                                <td>@snapshot.MetodologiasMap.GetValueOrDefault(item.IdMetodologia, item.IdMetodologia.ToString())</td>
                                <td>@estados.GetValueOrDefault(item.Estado, item.Estado.ToString())</td>
                                <td>@item.FechaModificacion.ToString("g")</td>
                                <td class="text-center">
                                    <a class="btn btn-outline-secondary btn-sm" href="/OP/Trafico?trabajoId=@item.Id">Tráfico</a>
                                    <a class="btn btn-outline-primary btn-sm" href="/OP/Avances">Avances</a>
                                    <a class="btn btn-outline-info btn-sm" href="/OP/Encuestas">Encuestas</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">No hay trabajos que coincidan con el filtro.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between">
            <div class="text-muted">Vista actualizada: @snapshot.GeneratedAt.ToLocalTime():f</div>
            <div><a href="/OP/Avances" class="link-secondary">Documentación completa</a></div>
        </div>
    }
</section>
