@model MatrixNext.Web.Services.OP.Models.PlanillaModeracionVm
@{
    ViewData["Title"] = Model.IdPlanilla == 0 ? "Nueva Planilla de Moderación" : "Editar Planilla de Moderación";
    var tecnicas = ViewBag.Tecnicas as IEnumerable<MatrixNext.Web.Services.OP.Models.TecnicaVm> ?? new List<MatrixNext.Web.Services.OP.Models.TecnicaVm>();
    var moderadores = ViewBag.Moderadores as IEnumerable<MatrixNext.Web.Services.OP.Models.ModeradorVm> ?? new List<MatrixNext.Web.Services.OP.Models.ModeradorVm>();
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver al Listado
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <form asp-action="SaveModeracion" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdPlanilla" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="JobBook" class="form-label">JobBook *</label>
                        <div class="input-group">
                            <input type="text" asp-for="JobBook" class="form-control" id="JobBook" required 
                                   placeholder="Buscar JobBook..." autocomplete="off" />
                            <button class="btn btn-outline-secondary" type="button" id="btnBuscarJob">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                        <div id="jobBookResults" class="list-group position-absolute w-50" style="z-index: 1000; display: none;"></div>
                        <span asp-validation-for="JobBook" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label for="FechaPlanilla" class="form-label">Fecha Planilla *</label>
                        <input type="date" asp-for="FechaPlanilla" class="form-control" required 
                               value="@(Model.FechaPlanilla?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))" />
                        <span asp-validation-for="FechaPlanilla" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label for="IdTecnica" class="form-label">Técnica *</label>
                        <select asp-for="IdTecnica" class="form-select" required>
                            <option value="">Seleccione una técnica...</option>
                            @foreach (var tecnica in tecnicas)
                            {
                                <option value="@tecnica.IdTecnica">@tecnica.NombreTecnica</option>
                            }
                        </select>
                        <span asp-validation-for="IdTecnica" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label for="Muestra" class="form-label">Muestra *</label>
                        <input type="number" asp-for="Muestra" class="form-control" required min="1" />
                        <span asp-validation-for="Muestra" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label for="IdModerador" class="form-label">Moderador *</label>
                        <select asp-for="IdModerador" class="form-select" required>
                            <option value="">Seleccione un moderador...</option>
                            @foreach (var moderador in moderadores)
                            {
                                <option value="@moderador.IdModerador">@moderador.NombreModerador</option>
                            }
                        </select>
                        <span asp-validation-for="IdModerador" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label for="IdEstadoAprobacion" class="form-label">Estado Aprobación</label>
                        <select asp-for="IdEstadoAprobacion" class="form-select" disabled>
                            <option value="1" selected="@(Model.IdEstadoAprobacion == 1)">En Espera</option>
                            <option value="2" selected="@(Model.IdEstadoAprobacion == 2)">Aprobado</option>
                            <option value="3" selected="@(Model.IdEstadoAprobacion == 3)">No Aprobado</option>
                        </select>
                        <div class="form-text">El estado se actualiza mediante aprobación/rechazo en el listado</div>
                    </div>

                    <div class="col-md-12">
                        <label for="Observaciones" class="form-label">Observaciones</label>
                        <textarea asp-for="Observaciones" class="form-control" rows="4" 
                                  placeholder="Observaciones adicionales..."></textarea>
                        <span asp-validation-for="Observaciones" class="text-danger"></span>
                    </div>

                    @if (Model.IdPlanilla > 0)
                    {
                        <div class="col-md-6">
                            <label class="form-label">Usuario Creación</label>
                            <input type="text" class="form-control" value="@Model.UsuarioCreacion" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Fecha Creación</label>
                            <input type="text" class="form-control" value="@Model.FechaCreacion?.ToString("dd/MM/yyyy HH:mm")" disabled />
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Guardar Planilla
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        $(document).ready(function() {
            let jobBookTimeout = null;

            // JobBook autocomplete
            $('#JobBook').on('input', function() {
                clearTimeout(jobBookTimeout);
                const termino = $(this).val().trim();

                if (termino.length < 2) {
                    $('#jobBookResults').hide();
                    return;
                }

                jobBookTimeout = setTimeout(function() {
                    $.get('@Url.Action("BuscarJobBooks")', { termino: termino }, function(data) {
                        if (data && data.length > 0) {
                            let html = '';
                            data.forEach(function(job) {
                                html += `<a href="#" class="list-group-item list-group-item-action jobbook-item" 
                                           data-jobbook="${job.jobBook}">
                                           ${job.jobBook} - ${job.nombreTrabajo}
                                         </a>`;
                            });
                            $('#jobBookResults').html(html).show();
                        } else {
                            $('#jobBookResults').hide();
                        }
                    });
                }, 300);
            });

            // Click en resultado autocomplete
            $(document).on('click', '.jobbook-item', function(e) {
                e.preventDefault();
                const jobBook = $(this).data('jobbook');
                $('#JobBook').val(jobBook);
                $('#jobBookResults').hide();
            });

            // Ocultar resultados al hacer click fuera
            $(document).on('click', function(e) {
                if (!$(e.target).closest('#JobBook, #jobBookResults').length) {
                    $('#jobBookResults').hide();
                }
            });

            // Botón buscar JobBook
            $('#btnBuscarJob').on('click', function() {
                $('#JobBook').focus().trigger('input');
            });
        });
    </script>
}
