@model IEnumerable<MatrixNext.Web.Services.OP.Models.PlanillaListItemVm>
@{
    ViewData["Title"] = "Administración de Planillas Cualitativas";
    var pageIndex = ViewBag.PageIndex ?? 0;
    var pageSize = ViewBag.PageSize ?? 25;
    var totalRecords = ViewBag.TotalRecords ?? 0;
    var totalPages = ViewBag.TotalPages ?? 0;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>
        <div class="btn-group">
            <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown">
                <i class="bi bi-plus-circle"></i> Nueva Planilla
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" asp-action="EditModeracion">Planilla de Moderación</a></li>
                <li><a class="dropdown-item" asp-action="EditInforme">Planilla de Informes</a></li>
            </ul>
            <a asp-action="ExportExcel" asp-route-tipoPlantilla="@ViewBag.TipoPlantilla" asp-route-statusRegistro="@ViewBag.StatusRegistro" class="btn btn-success">
                <i class="bi bi-file-earmark-excel"></i> Exportar
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <form method="get" asp-action="Index" id="filterForm">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="tipoPlantilla" class="form-label">Tipo Planilla</label>
                        <select name="tipoPlantilla" id="tipoPlantilla" class="form-select">
                            <option value="">Todas</option>
                            <option value="Moderacion" selected="@(ViewBag.TipoPlantilla == "Moderacion")">Moderación</option>
                            <option value="Informes" selected="@(ViewBag.TipoPlantilla == "Informes")">Informes</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="statusRegistro" class="form-label">Estado Aprobación</label>
                        <select name="statusRegistro" id="statusRegistro" class="form-select">
                            <option value="">Todos</option>
                            <option value="1" selected="@(ViewBag.StatusRegistro == 1)">En Espera</option>
                            <option value="2" selected="@(ViewBag.StatusRegistro == 2)">Aprobado</option>
                            <option value="3" selected="@(ViewBag.StatusRegistro == 3)">No Aprobado</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <a href="@Url.Action("Index")" class="btn btn-secondary w-100">
                            <i class="bi bi-x-circle"></i> Limpiar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            @if (Model?.Any() == true)
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="planillasTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Tipo</th>
                                <th>JobBook</th>
                                <th>Fecha</th>
                                <th>Técnica</th>
                                <th>Muestra</th>
                                <th>Estado</th>
                                <th>Usuario Creación</th>
                                <th>Fecha Creación</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var planilla in Model)
                            {
                                <tr>
                                    <td>@planilla.IdPlanilla</td>
                                    <td>
                                        <span class="badge @(planilla.TipoPlantilla == "Moderacion" ? "bg-info" : "bg-primary")">
                                            @planilla.TipoPlantilla
                                        </span>
                                    </td>
                                    <td>@planilla.JobBook</td>
                                    <td>@planilla.Fecha?.ToString("dd/MM/yyyy")</td>
                                    <td>@planilla.Tecnica</td>
                                    <td>@planilla.Muestra</td>
                                    <td>
                                        @if (planilla.IdEstadoAprobacion == 1)
                                        {
                                            <span class="badge bg-warning text-dark">En Espera</span>
                                        }
                                        else if (planilla.IdEstadoAprobacion == 2)
                                        {
                                            <span class="badge bg-success">Aprobado</span>
                                        }
                                        else if (planilla.IdEstadoAprobacion == 3)
                                        {
                                            <span class="badge bg-danger">No Aprobado</span>
                                        }
                                    </td>
                                    <td>@planilla.UsuarioCreacion</td>
                                    <td>@planilla.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            @if (planilla.TipoPlantilla == "Moderacion")
                                            {
                                                <a asp-action="EditModeracion" asp-route-id="@planilla.IdPlanilla" class="btn btn-outline-primary" title="Editar">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-action="EditInforme" asp-route-id="@planilla.IdPlanilla" class="btn btn-outline-primary" title="Editar">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            }
                                            
                                            @if (planilla.IdEstadoAprobacion == 1)
                                            {
                                                <button type="button" class="btn btn-outline-success" onclick="aprobarPlanilla(@planilla.IdPlanilla, '@planilla.TipoPlantilla')" title="Aprobar">
                                                    <i class="bi bi-check-circle"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-danger" onclick="rechazarPlanilla(@planilla.IdPlanilla, '@planilla.TipoPlantilla')" title="Rechazar">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* Paginación *@
                @if (totalPages > 1)
                {
                    <nav aria-label="Paginación planillas" class="mt-3">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(pageIndex == 0 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { tipoPlantilla = ViewBag.TipoPlantilla, statusRegistro = ViewBag.StatusRegistro, pageIndex = pageIndex - 1, pageSize })">
                                    Anterior
                                </a>
                            </li>
                            
                            @for (int i = 0; i < totalPages; i++)
                            {
                                <li class="page-item @(i == pageIndex ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { tipoPlantilla = ViewBag.TipoPlantilla, statusRegistro = ViewBag.StatusRegistro, pageIndex = i, pageSize })">
                                        @(i + 1)
                                    </a>
                                </li>
                            }
                            
                            <li class="page-item @(pageIndex >= totalPages - 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { tipoPlantilla = ViewBag.TipoPlantilla, statusRegistro = ViewBag.StatusRegistro, pageIndex = pageIndex + 1, pageSize })">
                                    Siguiente
                                </a>
                            </li>
                        </ul>
                        <p class="text-center text-muted">
                            Mostrando @((pageIndex * pageSize) + 1) - @Math.Min((pageIndex + 1) * pageSize, totalRecords) de @totalRecords registros
                        </p>
                    </nav>
                }
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No se encontraron planillas con los criterios especificados.
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Rechazo -->
<div class="modal fade" id="modalRechazo" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Rechazar Planilla</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formRechazo">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="rechazoIdPlanilla" name="idPlanilla" />
                    <input type="hidden" id="rechazoTipoPlantilla" name="tipoPlantilla" />
                    <div class="mb-3">
                        <label for="rechazoObservaciones" class="form-label">Observaciones *</label>
                        <textarea id="rechazoObservaciones" name="observaciones" class="form-control" rows="4" required></textarea>
                        <div class="form-text">Las observaciones son requeridas para rechazar una planilla.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" onclick="confirmarRechazo()">
                    <i class="bi bi-x-circle"></i> Rechazar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function aprobarPlanilla(idPlanilla, tipoPlantilla) {
            if (!confirm('¿Está seguro que desea aprobar esta planilla?')) {
                return;
            }

            const formData = new FormData();
            formData.append('idPlanilla', idPlanilla);
            formData.append('tipoPlantilla', tipoPlantilla);
            formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());

            fetch('@Url.Action("AprobarPlanilla")', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message || 'Planilla aprobada exitosamente');
                    location.reload();
                } else {
                    alert('Error: ' + (data.error || 'No se pudo aprobar la planilla'));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error al aprobar la planilla');
            });
        }

        function rechazarPlanilla(idPlanilla, tipoPlantilla) {
            document.getElementById('rechazoIdPlanilla').value = idPlanilla;
            document.getElementById('rechazoTipoPlantilla').value = tipoPlantilla;
            document.getElementById('rechazoObservaciones').value = '';
            
            const modal = new bootstrap.Modal(document.getElementById('modalRechazo'));
            modal.show();
        }

        function confirmarRechazo() {
            const observaciones = document.getElementById('rechazoObservaciones').value.trim();
            
            if (!observaciones) {
                alert('Las observaciones son requeridas para rechazar la planilla');
                return;
            }

            const formData = new FormData(document.getElementById('formRechazo'));

            fetch('@Url.Action("RechazarPlanilla")', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message || 'Planilla rechazada exitosamente');
                    location.reload();
                } else {
                    alert('Error: ' + (data.error || 'No se pudo rechazar la planilla'));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error al rechazar la planilla');
            });
        }

        // DataTable initialization
        $(document).ready(function() {
            $('#planillasTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
                },
                order: [[0, 'desc']],
                pageLength: @pageSize,
                paging: false, // Paginación manual con parámetros URL
                searching: false, // Búsqueda manual con filtros
                info: false
            });
        });
    </script>
}
