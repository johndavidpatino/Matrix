@model IEnumerable<MatrixNext.Data.Models.OP.TrabajoActivoDashboardDto>

@if (Model.Any())
{
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead>
                    <tr class="bg-light">
                        <th>Trabajo</th>
                        <th>Proyecto</th>
                        <th style="width: 12%">Avance</th>
                        <th>Días Restantes</th>
                        <th>Coordinador</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var trabajo in Model)
                    {
                        var diasRestantes = (trabajo.FechaFinaProgramada - DateTime.Today).Days;
                        var alerta = trabajo.AvancePercentual < 50 ? "🔴 Avance" : "🟡 Vencimiento";

                        <tr class="table-danger">
                            <td>
                                <strong>@trabajo.NumeroTrabajo</strong>
                                <br />
                                <small>@alerta</small>
                            </td>
                            <td>
                                @trabajo.CodigoProyecto
                                <br />
                                <small class="text-muted">@Html.Truncate(trabajo.NombreProyecto, 20)</small>
                            </td>
                            <td>
                                <span class="badge badge-danger">@trabajo.AvancePercentual.ToString("F1")%</span>
                            </td>
                            <td>
                                @if (diasRestantes <= 0)
                                {
                                    <span class="badge badge-danger">VENCIDO</span>
                                }
                                else if (diasRestantes <= 7)
                                {
                                    <span class="badge badge-warning">@diasRestantes días</span>
                                }
                                else
                                {
                                    <span>@diasRestantes días</span>
                                }
                            </td>
                            <td>@trabajo.CoordinadorNombre</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-success m-3 mb-0">
        <i class="fas fa-check-circle"></i>
        <strong>¡Excelente!</strong> No hay trabajos en riesgo en este momento.
    </div>
}
