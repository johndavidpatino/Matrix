@model MatrixNext.Data.Models.OP.HomeRecoleccionDashboardDto

@{
    ViewData["Title"] = "Dashboard Recolección";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col">
            <h1>
                <i class="fas fa-chart-line"></i>
                Dashboard de Recolección
            </h1>
            <small class="text-muted">@Model.PeriodoReporte</small>
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-primary" onclick="refrescarDashboard()" title="Actualizar">
                <i class="fas fa-sync-alt"></i>
                Actualizar
            </button>
        </div>
    </div>

    <!-- Métricas KPI -->
    @if (Model.Metricas.Any())
    {
        <div class="row mb-4" id="metricas-container">
            @foreach (var metrica in Model.Metricas)
            {
                <div class="col-md-6 col-lg-3 mb-3">
                    <div class="card border-left-@metrica.Color h-100">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col">
                                    <div class="text-xs font-weight-bold text-@metrica.Color text-uppercase mb-1">
                                        @metrica.Etiqueta
                                    </div>
                                    <div class="h3 mb-0 text-gray-800">
                                        @metrica.Valor
                                    </div>
                                    @if (!string.IsNullOrEmpty(metrica.Descripcion))
                                    {
                                        <small class="text-muted d-block mt-1">@metrica.Descripcion</small>
                                    }
                                </div>
                                <div class="col-auto">
                                    <i class="@metrica.Icono fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Tabla de Trabajos Activos -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-list"></i>
                        Trabajos Activos
                    </h5>
                    <span class="badge badge-light">@Model.TrabajosActivos.Count()</span>
                </div>

                @if (Model.TrabajosActivos.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0">
                            <thead>
                                <tr class="bg-light">
                                    <th>Trabajo</th>
                                    <th>Proyecto</th>
                                    <th>Metodología</th>
                                    <th style="width: 15%">Avance</th>
                                    <th>Coordinador</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var trabajo in Model.TrabajosActivos)
                                {
                                    var progressClass = trabajo.AvancePercentual >= 75 ? "success" :
                                                       trabajo.AvancePercentual >= 50 ? "info" :
                                                       trabajo.AvancePercentual >= 25 ? "warning" : "danger";

                                    <tr>
                                        <td>
                                            <strong>@trabajo.NumeroTrabajo</strong>
                                            <br />
                                            <small class="text-muted">@trabajo.IdTrabajo</small>
                                        </td>
                                        <td>
                                            @trabajo.CodigoProyecto
                                            <br />
                                            <small>@Html.Truncate(trabajo.NombreProyecto, 25)</small>
                                        </td>
                                        <td>@trabajo.Metodologia</td>
                                        <td>
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar bg-@progressClass"
                                                     role="progressbar"
                                                     style="width: @trabajo.AvancePercentual%"
                                                     aria-valuenow="@trabajo.AvancePercentual"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100">
                                                    @trabajo.AvancePercentual.ToString("F1")%
                                                </div>
                                            </div>
                                            <small class="text-muted">@trabajo.EncuestasActuales / @trabajo.MetaEncuestas</small>
                                        </td>
                                        <td>@trabajo.CoordinadorNombre</td>
                                        <td>
                                            <span class="badge badge-success">@trabajo.Estado</span>
                                        </td>
                                        <td>
                                            <a href="@Url.Action("DetallesPorTarea", "IpsRevision", new { area = "OP", trabajoId = trabajo.IdTrabajo })" 
                                               class="btn btn-sm btn-info" 
                                               title="IPS">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (Model.TrabajosActivos.Count >= 10)
                    {
                        <div class="card-footer text-center">
                            <a href="@Url.Action("ObtenerTrabajosActivos", "HomeRecoleccion", new { area = "OP" })" 
                               class="btn btn-sm btn-outline-primary">
                                Ver todos los trabajos
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info m-3 mb-0">
                        <i class="fas fa-info-circle"></i>
                        No hay trabajos activos en este momento.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sección de Alertas (Trabajos en Riesgo) -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-left-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-exclamation-triangle"></i>
                        Trabajos en Riesgo
                    </h5>
                </div>
                <div id="trabajos-riesgo-container">
                    <div class="card-body text-center">
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        Cargando...
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráfico de Producción -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-line"></i>
                        Producción Diaria (Últimos 7 días)
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="graficoProduccion" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para trabajos en riesgo -->
<div class="modal fade" id="modalRiesgos" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Detalle de Trabajos en Riesgo</h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body" id="riesgos-content">
                <!-- Cargado vía AJAX -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script type="text/javascript">
        let graficoProduccionInstance = null;

        $(document).ready(function () {
            // Cargar trabajos en riesgo
            cargarTrabajosEnRiesgo();

            // Cargar gráfico de producción
            cargarGraficoProduccion();

            // Auto-refresh cada 5 minutos
            setInterval(function () {
                refrescarDashboard();
            }, 5 * 60 * 1000);
        });

        function cargarTrabajosEnRiesgo() {
            $.ajax({
                url: '@Url.Action("ObtenerTrabajosEnRiesgo", "HomeRecoleccion")',
                type: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function (html) {
                    $('#trabajos-riesgo-container').html(html);
                },
                error: function () {
                    $('#trabajos-riesgo-container').html('<div class="alert alert-warning m-3">Error al cargar trabajos en riesgo</div>');
                }
            });
        }

        function cargarGraficoProduccion() {
            $.ajax({
                url: '@Url.Action("ObtenerGraficoProduccion", "HomeRecoleccion")?diasAtras=7',
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    var ctx = document.getElementById('graficoProduccion').getContext('2d');

                    if (graficoProduccionInstance) {
                        graficoProduccionInstance.destroy();
                    }

                    graficoProduccionInstance = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: data.labels,
                            datasets: [
                                {
                                    label: 'Encuestas Planeadas',
                                    data: data.planeadas,
                                    borderColor: 'rgb(75, 192, 192)',
                                    backgroundColor: 'rgba(75, 192, 192, 0.1)',
                                    tension: 0.3
                                },
                                {
                                    label: 'Encuestas Ejecutadas',
                                    data: data.ejecutadas,
                                    borderColor: 'rgb(54, 162, 235)',
                                    backgroundColor: 'rgba(54, 162, 235, 0.1)',
                                    tension: 0.3
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: true,
                            plugins: {
                                legend: {
                                    position: 'top',
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true
                                }
                            }
                        }
                    });
                },
                error: function () {
                    console.error('Error cargando gráfico');
                }
            });
        }

        function refrescarDashboard() {
            $.ajax({
                url: '@Url.Action("ActualizarDashboard", "HomeRecoleccion")',
                type: 'POST',
                dataType: 'json',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function (response) {
                    if (response.success) {
                        // Actualizar métricas
                        if (response.metricas && response.metricas.length > 0) {
                            console.log('Métricas actualizadas:', response.metricas);
                            // Aquí se podría actualizar las métricas en tiempo real
                        }

                        // Mostrar notificación
                        showToast('Dashboard actualizado', 'success', 2000);
                    }
                },
                error: function () {
                    showToast('Error al actualizar dashboard', 'error');
                }
            });
        }

        function showToast(message, type = 'info', duration = 3000) {
            // Asumiendo que existe función global showToast en layout
            if (typeof showToast !== 'undefined') {
                showToast(message, type);
            }
        }
    </script>
}
