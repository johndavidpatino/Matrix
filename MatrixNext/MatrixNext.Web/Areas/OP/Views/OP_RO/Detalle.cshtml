@model MatrixNext.Data.Models.OP_RO.OP_ROReviewDTO

@{
    ViewData["Title"] = "Detalle de Revisión";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-clipboard-check"></i>
                        Revisión Operacional - Detalle
                    </h3>
                    <div class="card-tools">
                        <a href="@Url.Action("Index", "OP_RO")" class="btn btn-sm btn-secondary">
                            <i class="fas fa-arrow-left"></i> Volver
                        </a>
                        @if (Model.Estado == "Borrador")
                        {
                            <button type="button" class="btn btn-sm btn-primary" id="btnEnviarRevision">
                                <i class="fas fa-paper-plane"></i> Enviar a Revisión
                            </button>
                        }
                        @if (Model.Estado == "Revision")
                        {
                            <button type="button" class="btn btn-sm btn-success" id="btnAprobar">
                                <i class="fas fa-check"></i> Aprobar
                            </button>
                            <button type="button" class="btn btn-sm btn-danger" id="btnRechazar">
                                <i class="fas fa-times"></i> Rechazar
                            </button>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Tipo de Revisión:</dt>
                                <dd class="col-sm-8">@Model.TipoRevision</dd>

                                <dt class="col-sm-4">Documento:</dt>
                                <dd class="col-sm-8">@Model.NombreDocumento</dd>

                                <dt class="col-sm-4">Estado:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-@(Model.Estado == "Aprobado" ? "success" : Model.Estado == "Rechazado" ? "danger" : Model.Estado == "Revision" ? "warning" : "secondary")">
                                        @Model.Estado
                                    </span>
                                </dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Fecha Creación:</dt>
                                <dd class="col-sm-8">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>

                                <dt class="col-sm-4">Última Modificación:</dt>
                                <dd class="col-sm-8">@(Model.FechaUltimaModificacion?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</dd>

                                <dt class="col-sm-4">Usuario Creador:</dt>
                                <dd class="col-sm-8">@Model.UsuarioCreador</dd>

                                <dt class="col-sm-4">Estudio ID:</dt>
                                <dd class="col-sm-8">@Model.EstudoId</dd>

                                <dt class="col-sm-4">Descripción:</dt>
                                <dd class="col-sm-8">@(Model.Descripcion ?? "N/A")</dd>
                            </dl>
                        </div>
                    </div>

                    <hr>

                    <!-- Historial de cambios -->
                    <h5>Historial de Cambios</h5>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Usuario</th>
                                    <th>Acción</th>
                                    <th>Detalles</th>
                                    <th>Estado Anterior</th>
                                    <th>Estado Nuevo</th>
                                </tr>
                            </thead>
                            <tbody id="historialBody">
                                <!-- Cargar via AJAX -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Comentarios -->
<div class="modal fade" id="modalComentarios" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalComentariosTitle">Comentarios</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formComentarios">
                    <div class="mb-3">
                        <label for="comentarios" class="form-label">Comentarios *</label>
                        <textarea class="form-control" id="comentarios" name="comentarios" rows="4" required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnGuardarAccion">Confirmar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var reviewId = @Model.ReviewId;
        var accionActual = '';

        $(document).ready(function() {
            // Cargar historial
            cargarHistorial();

            // Enviar a revisión
            $('#btnEnviarRevision').click(function() {
                accionActual = 'enviar';
                $('#modalComentariosTitle').text('Enviar a Revisión');
                $('#modalComentarios').modal('show');
            });

            // Aprobar
            $('#btnAprobar').click(function() {
                accionActual = 'aprobar';
                $('#modalComentariosTitle').text('Aprobar Revisión');
                $('#modalComentarios').modal('show');
            });

            // Rechazar
            $('#btnRechazar').click(function() {
                accionActual = 'rechazar';
                $('#modalComentariosTitle').text('Rechazar Revisión');
                $('#modalComentarios').modal('show');
            });

            // Guardar acción
            $('#btnGuardarAccion').click(function() {
                var comentarios = $('#comentarios').val();
                if (!comentarios) {
                    toastr.error('Debe ingresar comentarios');
                    return;
                }

                var url = '';
                switch(accionActual) {
                    case 'enviar':
                        url = '@Url.Action("EnviarRevision", "OP_RO")';
                        break;
                    case 'aprobar':
                        url = '@Url.Action("AprobarRevision", "OP_RO")';
                        break;
                    case 'rechazar':
                        url = '@Url.Action("RechazarRevision", "OP_RO")';
                        break;
                }

                $.post(url, { reviewId: reviewId, comentarios: comentarios }, function(response) {
                    if (response.success) {
                        toastr.success('Acción realizada exitosamente');
                        $('#modalComentarios').modal('hide');
                        location.reload();
                    } else {
                        toastr.error(response.message || 'Error al procesar la acción');
                    }
                });
            });
        });

        function cargarHistorial() {
            $.get('@Url.Action("GetHistorial", "OP_RO")/' + reviewId, function(response) {
                if (response.success && response.data) {
                    var html = '';
                    $.each(response.data, function(i, item) {
                        html += `<tr>
                            <td>${new Date(item.fecha).toLocaleString()}</td>
                            <td>${item.usuario}</td>
                            <td>${item.accion}</td>
                            <td>${item.detalles || ''}</td>
                            <td>${item.estadoAnterior || ''}</td>
                            <td>${item.estadoNuevo || ''}</td>
                        </tr>`;
                    });
                    $('#historialBody').html(html || '<tr><td colspan="6" class="text-center">Sin historial</td></tr>');
                }
            });
        }
    </script>
}
