@{
    ViewData["Title"] = "Campo Cualitativo";
}

<div class="container">
    <h2>
        <i class="bi bi-clipboard-check"></i> Campo Cualitativo - Trabajo @ViewBag.TrabajoId
    </h2>

    <ul class="nav nav-tabs" id="campoTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="sesiones-tab" data-bs-toggle="tab" data-bs-target="#sesiones" type="button" role="tab">Sesiones</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="entrevistas-tab" data-bs-toggle="tab" data-bs-target="#entrevistas" type="button" role="tab">Entrevistas</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="observaciones-tab" data-bs-toggle="tab" data-bs-target="#observaciones" type="button" role="tab">Observaciones</button>
        </li>
    </ul>
    <div class="tab-content" id="campoTabsContent">
        <div class="tab-pane fade show active p-3" id="sesiones" role="tabpanel">
            <p class="text-muted">Listado de sesiones del trabajo (placeholder)</p>
        </div>
        <div class="tab-pane fade p-3" id="entrevistas" role="tabpanel">
            <p class="text-muted">Listado de entrevistas del trabajo (placeholder)</p>
        </div>
        <div class="tab-pane fade p-3" id="observaciones" role="tabpanel">
            <p class="text-muted">Listado de observaciones del trabajo (placeholder)</p>
        </div>
    </div>

    <div class="mt-3">
        <a class="btn btn-info" href="@Url.Action("ExportExcel", "CualitativoCampo", new { area = "OP", trabajoId = ViewBag.TrabajoId })">
            <i class="bi bi-file-earmark-excel"></i> Exportar Excel
        </a>
        <a class="btn btn-secondary" href="@Url.Action("ExportIcs", "CualitativoCampo", new { area = "OP", trabajoId = ViewBag.TrabajoId })">
            <i class="bi bi-calendar-event"></i> Exportar ICS
        </a>
        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "CualitativoTrabajos", new { area = "OP" })">
            <i class="bi bi-arrow-left"></i> Regresar a Trabajos
        </a>
    </div>
</div>
