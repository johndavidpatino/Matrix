@model List<MatrixNext.Web.Services.OP.Models.ProgramacionCampoVm>
@{
    ViewData["Title"] = "Campo Cualitativo";
    var trabajoId = ViewBag.TrabajoId ?? 0;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>
            <i class="bi bi-clipboard-check"></i> @ViewData["Title"] - Trabajo @trabajoId
        </h2>
        <div class="btn-group">
            <a asp-action="ExportExcel" asp-route-trabajoId="@trabajoId" class="btn btn-success">
                <i class="bi bi-file-earmark-excel"></i> Exportar Excel
            </a>
            <a asp-action="ExportIcs" asp-route-trabajoId="@trabajoId" class="btn btn-primary">
                <i class="bi bi-calendar-event"></i> Exportar ICS
            </a>
            <a asp-controller="CualitativoTrabajos" asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Volver a Trabajos
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Programaciones de Campo</h5>
        </div>
        <div class="card-body">
            @if (Model?.Any() == true)
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="programacionesTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Entrevistado</th>
                                <th>Teléfono</th>
                                <th>Fecha Programada</th>
                                <th>Hora</th>
                                <th>Lugar</th>
                                <th>Estado</th>
                                <th>Entrevistador</th>
                                <th>Observaciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prog in Model)
                            {
                                <tr>
                                    <td>@prog.Id</td>
                                    <td>@prog.EntrevistadoNombre</td>
                                    <td>@prog.EntrevistadoTelefono</td>
                                    <td>
                                        @if (prog.FechaProgramada.HasValue)
                                        {
                                            @prog.FechaProgramada.Value.ToString("dd/MM/yyyy")
                                        }
                                    </td>
                                    <td>
                                        @if (prog.HoraProgramada.HasValue)
                                        {
                                            @prog.HoraProgramada.Value.ToString(@"hh\:mm")
                                        }
                                    </td>
                                    <td>@prog.LugarCita</td>
                                    <td>
                                        <span class="badge bg-@(prog.Estado == 4 ? "success" : prog.Estado == 5 || prog.Estado == 6 ? "danger" : "primary")">
                                            @prog.EstadoDescripcion
                                        </span>
                                    </td>
                                    <td>@prog.EntrevistadorAsignadoNombre</td>
                                    <td>@prog.Observaciones</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No se encontraron programaciones de campo para este trabajo.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#programacionesTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
                },
                pageLength: 25,
                order: [[3, 'desc']], // Ordenar por fecha descendente
                columnDefs: [
                    { type: 'date', targets: 3 }
                ]
            });
        });
    </script>
}