@model MatrixNext.Web.Services.OP.Models.ProgramacionCampoVm
@{
    ViewData["Title"] = Model?.ProgramacionId > 0 ? "Editar Programación" : "Nueva Programación";
    var trabajos = (IEnumerable<dynamic>?)ViewData["Trabajos"] ?? Array.Empty<dynamic>();
    var entrevistados = (IEnumerable<dynamic>?)ViewData["EntrevistadosDisponibles"] ?? Array.Empty<dynamic>();
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>
        <a asp-action="Index" asp-route-trabajoId="@Model?.TrabajoId" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver al Listado
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Save" method="post" id="formProgramacion">
                @Html.AntiForgeryToken()
                
                <input type="hidden" asp-for="ProgramacionId" />
                <input type="hidden" asp-for="TrabajoId" />
                
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="TrabajoId" class="form-label">Trabajo</label>
                        <select asp-for="TrabajoId" class="form-select" disabled>
                            @foreach (var trabajo in trabajos)
                            {
                                <option value="@trabajo.TrabajoId" selected="@(trabajo.TrabajoId == (Model?.TrabajoId ?? 0))">
                                    @trabajo.TrabajoId - @trabajo.NombreTrabajo
                                </option>
                            }
                        </select>
                        <small class="text-muted">@Model?.NombreTrabajo</small>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EntrevistadoId" class="form-label">Entrevistado <span class="text-danger">*</span></label>
                        <select asp-for="EntrevistadoId" id="entrevistadoId" class="form-select" required multiple size="5">
                            @foreach (var entrevistado in entrevistados)
                            {
                                <option value="@entrevistado.Id" 
                                        data-telefono="@entrevistado.Telefono"
                                        data-direccion="@entrevistado.Direccion"
                                        selected="@(entrevistado.Id == (Model?.EntrevistadoId ?? 0))">
                                    @entrevistado.NombreCompleto - @entrevistado.Telefono
                                </option>
                            }
                        </select>
                        <span asp-validation-for="EntrevistadoId" class="text-danger"></span>
                        <button type="button" class="btn btn-sm btn-outline-primary mt-2" id="btnValidarParticipantes">
                            <i class="bi bi-check-circle"></i> Validar Participantes Seleccionados
                        </button>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="FechaProgramada" class="form-label">Fecha Programada <span class="text-danger">*</span></label>
                        <input asp-for="FechaProgramada" type="date" class="form-control" required />
                        <span asp-validation-for="FechaProgramada" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="HoraProgramada" class="form-label">Hora Programada</label>
                        <input asp-for="HoraProgramada" type="time" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="EstadoId" class="form-label">Estado</label>
                        <select asp-for="EstadoId" class="form-select">
                            <option value="1">Creado</option>
                            <option value="2">Asignado</option>
                            <option value="3">Confirmado</option>
                            <option value="4">Ejecutado</option>
                            <option value="5">Cancelado</option>
                            <option value="6">No Asistió</option>
                            <option value="7">Reprogramado</option>
                        </select>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Observaciones" class="form-label">Observaciones</label>
                        <textarea asp-for="Observaciones" class="form-control" rows="3" maxlength="500"></textarea>
                        <small class="text-muted">Máximo 500 caracteres</small>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MedioProgramacion" class="form-label">Medio de Programación</label>
                        <select asp-for="MedioProgramacion" class="form-select">
                            <option value="">Seleccione...</option>
                            <option value="Teléfono">Teléfono</option>
                            <option value="Email">Email</option>
                            <option value="WhatsApp">WhatsApp</option>
                            <option value="SMS">SMS</option>
                            <option value="Presencial">Presencial</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DuracionEstimada" class="form-label">Duración Estimada (minutos)</label>
                        <input asp-for="DuracionEstimada" type="number" class="form-control" min="1" max="480" />
                    </div>

                    <div class="col-12" id="infoEntrevistado" style="display: none;">
                        <div class="alert alert-info">
                            <strong>Información de Contacto:</strong><br/>
                            <span id="infoTelefono"></span><br/>
                            <span id="infoEmail"></span>
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Guardar Programación
                    </button>
                    <a asp-action="Index" asp-route-trabajoId="@Model?.TrabajoId" class="btn btn-secondary">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal de Validación de Participantes -->
<div class="modal fade" id="modalValidacionParticipantes" tabindex="-1" aria-labelledby="modalValidacionLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalValidacionLabel">Resultado de Validación de Participantes</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="validacionLoading" class="text-center" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Validando...</span>
                    </div>
                    <p class="mt-2">Validando participantes...</p>
                </div>
                <div id="validacionResultados" style="display: none;">
                    <div class="alert alert-info" id="validacionSummary"></div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Participante</th>
                                    <th>Estado</th>
                                    <th>Motivo</th>
                                    <th>Programaciones Previas</th>
                                    <th>Última Programación</th>
                                </tr>
                            </thead>
                            <tbody id="validacionTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            $('#entrevistadoId').change(function() {
                const selected = $(this).find(':selected');
                const telefono = selected.data('telefono');
                const email = selected.data('email');
                
                if (telefono || email) {
                    $('#infoTelefono').text('Teléfono: ' + (telefono || 'No registrado'));
                    $('#infoEmail').text('Email: ' + (email || 'No registrado'));
                    $('#infoEntrevistado').show();
                } else {
                    $('#infoEntrevistado').hide();
                }
            });

            // Trigger on load if editing
            @if (Model?.EntrevistadoId > 0)
            {
                @:$('#entrevistadoId').trigger('change');
            }

            // Validar participantes seleccionados
            $('#btnValidarParticipantes').click(function() {
                const selectedIds = $('#entrevistadoId').val();
                const fechaProgramada = $('#FechaProgramada').val();

                if (!selectedIds || selectedIds.length === 0) {
                    alert('Debe seleccionar al menos un participante para validar');
                    return;
                }

                const trabajoId = @Model?.TrabajoId ?? 0;
                if (trabajoId === 0) {
                    alert('TrabajoId no válido');
                    return;
                }

                // Mostrar modal y loading
                const modal = new bootstrap.Modal(document.getElementById('modalValidacionParticipantes'));
                modal.show();
                $('#validacionLoading').show();
                $('#validacionResultados').hide();

                // AJAX call
                $.ajax({
                    url: '@Url.Action("ValidateParticipants", "CualitativoProgramacion", new { Area = "OP" })',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        ids: selectedIds.map(id => parseInt(id)),
                        fechaProgramada: fechaProgramada || null
                    }),
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        $('#validacionLoading').hide();
                        if (response.success) {
                            mostrarResultadosValidacion(response.data);
                        } else {
                            $('#validacionResultados').html('<div class="alert alert-danger">Error: ' + response.message + '</div>').show();
                        }
                    },
                    error: function(xhr, status, error) {
                        $('#validacionLoading').hide();
                        $('#validacionResultados').html('<div class="alert alert-danger">Error en la petición: ' + error + '</div>').show();
                    }
                });
            });

            function mostrarResultadosValidacion(data) {
                const totalValidos = data.filter(p => p.disponible).length;
                const totalNoValidos = data.length - totalValidos;

                // Summary
                let summaryHtml = `<strong>Total participantes:</strong> ${data.length} | 
                                   <span class="text-success">Válidos: ${totalValidos}</span> | 
                                   <span class="text-danger">No válidos: ${totalNoValidos}</span>`;
                $('#validacionSummary').html(summaryHtml);

                // Table rows
                let tableHtml = '';
                data.forEach(p => {
                    const badgeClass = p.disponible ? 'bg-success' : 'bg-danger';
                    const estadoText = p.disponible ? 'Disponible' : 'No Disponible';
                    const motivoText = p.motivoNoValido || '-';
                    const ultimaProg = p.ultimaProgramacion ? new Date(p.ultimaProgramacion).toLocaleDateString() : 'Nunca';

                    tableHtml += `<tr class="${p.disponible ? '' : 'table-warning'}">
                        <td>${p.participanteId}</td>
                        <td>${p.nombreCompleto || 'Desconocido'}</td>
                        <td><span class="badge ${badgeClass}">${estadoText}</span></td>
                        <td>${motivoText}</td>
                        <td>${p.programacionesPrevias}</td>
                        <td>${ultimaProg}</td>
                    </tr>`;
                });

                $('#validacionTableBody').html(tableHtml);
                $('#validacionResultados').show();

                // Opcional: bloquear submit si hay no válidos
                if (totalNoValidos > 0) {
                    $('#formProgramacion button[type="submit"]').prop('disabled', true).addClass('btn-secondary').removeClass('btn-primary');
                    $('#formProgramacion').prepend('<div class="alert alert-warning alert-dismissible fade show" role="alert">'
                        + '<strong>Atención:</strong> Hay participantes no válidos. Corrija la selección antes de guardar.'
                        + '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>');
                } else {
                    $('#formProgramacion button[type="submit"]').prop('disabled', false).addClass('btn-primary').removeClass('btn-secondary');
                }
            }
        });
    </script>
}
