@model IEnumerable<MatrixNext.Web.Services.OP.Models.ProgramacionCampoVm>
@{
    ViewData["Title"] = "Programación de Campo";
    var trabajos = (IEnumerable<dynamic>?)ViewData["Trabajos"] ?? Array.Empty<dynamic>();
    var selectedTrabajoId = Convert.ToString(ViewData["TrabajoId"]) ?? string.Empty;
    var estadoFiltro = Convert.ToString(ViewData["EstadoFiltro"]) ?? string.Empty;
    var fechaDesde = Convert.ToString(ViewData["FechaDesde"]) ?? string.Empty;
    var fechaHasta = Convert.ToString(ViewData["FechaHasta"]) ?? string.Empty;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>
        <a asp-action="Edit" asp-route-trabajoId="@selectedTrabajoId" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nueva Programación
        </a>
        <div class="btn-group ms-2">
            <a asp-action="ExportExcel" asp-route-trabajoId="@selectedTrabajoId" asp-route-estado="@estadoFiltro" class="btn btn-success">
                <i class="bi bi-file-earmark-excel"></i> Exportar Excel
            </a>
            <a asp-action="ExportIcs" asp-route-trabajoId="@selectedTrabajoId" asp-route-estado="@estadoFiltro" class="btn btn-outline-success">
                <i class="bi bi-calendar2-plus"></i> Exportar ICS
            </a>
            <a asp-action="Calendar" asp-route-trabajoId="@selectedTrabajoId" asp-route-estado="@estadoFiltro" class="btn btn-outline-primary">
                <i class="bi bi-calendar3"></i> Ver Calendario
            </a>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="trabajoId" class="form-label">Trabajo</label>
                        <select name="trabajoId" id="trabajoId" class="form-select">
                            <option value="">Seleccione...</option>
                            @foreach (var trabajo in trabajos)
                            {
                                var currentTrabajoId = Convert.ToString(trabajo.TrabajoId) ?? string.Empty;
                                <option value="@trabajo.TrabajoId" selected="@(string.Equals(currentTrabajoId, selectedTrabajoId, StringComparison.Ordinal))">
                                    @trabajo.TrabajoId - @trabajo.NombreTrabajo
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="fechaDesde" class="form-label">Fecha Desde</label>
                        <input type="date" name="fechaDesde" id="fechaDesde" class="form-control" value="@fechaDesde" />
                    </div>
                    <div class="col-md-3">
                        <label for="fechaHasta" class="form-label">Fecha Hasta</label>
                        <input type="date" name="fechaHasta" id="fechaHasta" class="form-control" value="@fechaHasta" />
                    </div>
                    <div class="col-md-6">
                        <label for="estadoId" class="form-label">Estado</label>
                        <select name="estadoId" id="estadoId" class="form-select">
                            <option value="">Todos</option>
                            <option value="1">Creado</option>
                            <option value="2">Asignado</option>
                            <option value="3">Confirmado</option>
                            <option value="4">Ejecutado</option>
                            <option value="5">Cancelado</option>
                            <option value="6">No Asistió</option>
                            <option value="7">Reprogramado</option>
                        </select>
                    </div>
                    <div class="col-md-6 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                        <a asp-action="ExportExcel" asp-route-trabajoId="@selectedTrabajoId" asp-route-estado="@estadoFiltro" class="btn btn-success">
                            <i class="bi bi-file-earmark-excel"></i> Exportar Excel
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model?.Any() == true)
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Trabajo</th>
                                <th>Entrevistado</th>
                                <th>Fecha Programada</th>
                                <th>Hora</th>
                                <th>Estado</th>
                                <th>Observaciones</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prog in Model)
                            {
                                <tr>
                                    <td>@prog.ProgramacionId</td>
                                    <td>@prog.TrabajoId - @prog.NombreTrabajo</td>
                                    <td>@prog.NombreEntrevistado</td>
                                    <td>@prog.FechaProgramada?.ToString("dd/MM/yyyy")</td>
                                    <td>@prog.HoraProgramada</td>
                                    <td>
                                        <span class="badge bg-@(prog.EstadoId switch
                                        {
                                            1 => "secondary",
                                            2 => "info",
                                            3 => "primary",
                                            4 => "success",
                                            5 => "danger",
                                            6 => "warning",
                                            7 => "dark",
                                            _ => "light"
                                        })">
                                            @prog.NombreEstado
                                        </span>
                                    </td>
                                    <td>@(string.IsNullOrEmpty(prog.Observaciones) ? "-" : prog.Observaciones.Substring(0, Math.Min(50, prog.Observaciones.Length)))</td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Edit" asp-route-id="@prog.ProgramacionId" class="btn btn-outline-primary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            @if (prog.EstadoId < 4)
                                            {
                                                <button type="button" class="btn btn-outline-success btn-cambiar-estado" 
                                                        data-id="@prog.ProgramacionId" data-estado="@(prog.EstadoId + 1)" title="Avanzar Estado">
                                                    <i class="bi bi-check-circle"></i>
                                                </button>
                                            }
                                            @if (prog.EstadoId != 5)
                                            {
                                                <button type="button" class="btn btn-outline-danger btn-cambiar-estado" 
                                                        data-id="@prog.ProgramacionId" data-estado="5" title="Cancelar">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No hay programaciones registradas para los filtros seleccionados.
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.btn-cambiar-estado').click(function() {
                const id = $(this).data('id');
                const estadoId = $(this).data('estado');
                const estadoNombre = estadoId === 5 ? 'cancelar' : 'avanzar';
                
                if (confirm(`¿Confirma que desea ${estadoNombre} esta programación?`)) {
                    $.ajax({
                        url: '@Url.Action("ChangeStatus")',
                        type: 'POST',
                        data: {
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                            id: id,
                            estado: estadoId
                        },
                        success: function(response) {
                            if (response.success) {
                                location.reload();
                            } else {
                                alert('Error: ' + (response.error || 'No se pudo cambiar el estado'));
                            }
                        },
                        error: function() {
                            alert('Error al procesar la solicitud');
                        }
                    });
                }
            });
        });
    </script>
}
