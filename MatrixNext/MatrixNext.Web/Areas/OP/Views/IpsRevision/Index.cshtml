@model IEnumerable<MatrixNext.Data.Models.OP.IpsRevisionDto>

@{
    ViewData["Title"] = "IPS - Detallado por Tarea";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2>
                <i class="fas fa-tasks"></i>
                IPS - Detallado por Tarea
            </h2>
        </div>
        <div class="col-md-6 text-right">
            <a href="@Url.Action("Index", "Ips")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i>
                Volver a IPS
            </a>
        </div>
    </div>

    @if (Model.Count() == 0)
    {
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle"></i>
            No hay revisiones IPS registradas para esta tarea.
            <a href="@Url.Action("CrearRevision", new { trabajoId = ViewBag.TrabajoId })" 
               class="btn btn-sm btn-primary" 
               data-ajax-modal 
               data-url="@Url.Action("CrearRevision", new { trabajoId = ViewBag.TrabajoId })">
                <i class="fas fa-plus"></i>
                Crear Primera Revisión
            </a>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header bg-primary text-white">
                <div class="row align-items-center">
                    <div class="col">
                        <span class="badge badge-light">@Model.Count() revisiones</span>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-success" 
                                data-ajax-modal 
                                data-url="@Url.Action("CrearRevision", new { trabajoId = ViewBag.TrabajoId })">
                            <i class="fas fa-plus"></i>
                            Nueva Revisión
                        </button>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr class="bg-light">
                            <th style="width: 10%">ID</th>
                            <th style="width: 20%">Pregunta</th>
                            <th style="width: 15%">Observación</th>
                            <th style="width: 15%">Descripción</th>
                            <th style="width: 15%">Respuesta Programador</th>
                            <th style="width: 10%">Tipo Tarea</th>
                            <th style="width: 15%">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><code>@item.Id</code></td>
                                <td>
                                    <strong>@Html.Truncate(item.Pregunta, 40)</strong>
                                    @if (item.Pregunta?.Length > 40)
                                    {
                                        <span title="@item.Pregunta" class="text-muted">...</span>
                                    }
                                </td>
                                <td>
                                    @Html.Truncate(item.Observacion, 30)
                                    @if (item.Observacion?.Length > 30)
                                    {
                                        <span title="@item.Observacion" class="text-muted">...</span>
                                    }
                                </td>
                                <td>
                                    @Html.Truncate(item.DescripcionObservacion, 30)
                                    @if (item.DescripcionObservacion?.Length > 30)
                                    {
                                        <span title="@item.DescripcionObservacion" class="text-muted">...</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.RespuestaProgramador))
                                    {
                                        <span class="badge badge-success">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">No</span>
                                    }
                                </td>
                                <td>
                                    <small>@item.TipoTarea</small>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <button type="button" 
                                                class="btn btn-sm btn-info" 
                                                title="Editar"
                                                data-ajax-modal 
                                                data-url="@Url.Action("EditarRevision", new { revisionId = item.Id, trabajoId = ViewBag.TrabajoId })">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button type="button" 
                                                class="btn btn-sm btn-danger" 
                                                title="Eliminar"
                                                onclick="confirmarEliminar(@item.Id, @ViewBag.TrabajoId)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer text-muted text-right">
                <small>
                    Última modificación: 
                    @if (Model.Any())
                    {
                        @Model.OrderByDescending(x => x.FechaModificacion).First().FechaModificacion?.ToString("dd/MM/yyyy HH:mm")
                    }
                </small>
            </div>
        </div>
    }
</div>

<div id="modalContainer"></div>

@section Scripts {
    <script type="text/javascript">
        function confirmarEliminar(revisionId, trabajoId) {
            if (confirm('¿Está seguro de que desea eliminar esta revisión IPS?')) {
                $.ajax({
                    url: '@Url.Action("EliminarRevision")',
                    type: 'POST',
                    data: {
                        revisionId: revisionId,
                        trabajoId: trabajoId,
                        __RequestVerificationToken: $('[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message || 'Error al eliminar');
                        }
                    },
                    error: function () {
                        alert('Error en la solicitud');
                    }
                });
            }
        }
    </script>
}
