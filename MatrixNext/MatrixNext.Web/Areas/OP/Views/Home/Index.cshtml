@{
    ViewData["Title"] = "Home - OP Cuantitativo";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h2">
                <i class="bi bi-house-door"></i> Módulo OP Cuantitativo
            </h1>
            <p class="text-muted">Sistema de gestión operativa para estudios cuantitativos</p>
        </div>
    </div>

    <div class="row g-4">
        @if (ViewBag.TienePermiso100)
        {
            <div class="col-md-4">
                <div class="card h-100 border-primary">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-briefcase-fill"></i> Portal COE
                        </h5>
                        <p class="card-text">Gestión de trabajos, configuración y cierre de estudios</p>
                        <a href="@Url.Action("Index", "Trabajos")" class="btn btn-primary">
                            <i class="bi bi-arrow-right-circle"></i> Acceder
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (ViewBag.TienePermiso101)
        {
            <div class="col-md-4">
                <div class="card h-100 border-success">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-people-fill"></i> Coordinación
                        </h5>
                        <p class="card-text">Asignación de personal por ciudad y gestión de equipos</p>
                        <a href="@Url.Action("Index", "TrabajosCoordinador")" class="btn btn-success">
                            <i class="bi bi-arrow-right-circle"></i> Acceder
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-info">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-telephone-fill"></i> Call Center
                        </h5>
                        <p class="card-text">Gestión de encuestadores Call Center (CATI/CAWI)</p>
                        <a href="@Url.Action("Index", "TrabajosCallCenter")" class="btn btn-info">
                            <i class="bi bi-arrow-right-circle"></i> Acceder
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (ViewBag.TienePermiso19)
        {
            <div class="col-md-4">
                <div class="card h-100 border-warning">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-search"></i> Consulta de Trabajos
                        </h5>
                        <p class="card-text">Consulta por unidad y asignación de COE</p>
                        <a href="@Url.Action("Index", "ConsultaTrabajos")" class="btn btn-warning">
                            <i class="bi bi-arrow-right-circle"></i> Acceder
                        </a>
                    </div>
                </div>
            </div>
        }

        <div class="col-md-4">
            <div class="card h-100 border-secondary">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-graph-up"></i> Portal General
                    </h5>
                    <p class="card-text">Vista general de trabajos y métricas</p>
                    <a href="@Url.Action("Index", "Portal")" class="btn btn-secondary">
                        <i class="bi bi-arrow-right-circle"></i> Acceder
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-info-circle"></i> Información del Módulo
                    </h5>
                </div>
                <div class="card-body">
                    <h6>Trabajos Activos: <span class="badge bg-primary">@ViewBag.TrabajosActivos</span></h6>
                    <p class="mt-3 mb-0">
                        Este módulo permite la gestión operativa completa de estudios cuantitativos, incluyendo:
                    </p>
                    <ul class="mt-2">
                        <li>Configuración y cierre de trabajos</li>
                        <li>Asignación de personal y coordinación de campo</li>
                        <li>Gestión de encuestadores Call Center</li>
                        <li>Importación de planillas y datos CATI</li>
                        <li>Revisión de productividad por roles</li>
                        <li>Control de calidad IPS</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
