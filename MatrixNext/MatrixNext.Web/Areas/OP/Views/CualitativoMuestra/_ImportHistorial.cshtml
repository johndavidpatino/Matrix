@* Historial de Importaciones *@
@model IEnumerable<MatrixNext.Web.Services.OP.ImportHistorialVm>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header bg-secondary text-white">
                <h6 class="mb-0">
                    <i class="fas fa-history"></i> Historial de Importaciones
                </h6>
            </div>
            <div class="card-body p-0">
                @if (Model != null && Model.Any())
                {
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Archivo</th>
                                <th class="text-center">Procesados</th>
                                <th class="text-center">Exitosos</th>
                                <th class="text-center">Errores</th>
                                <th>Fecha</th>
                                <th>Usuario</th>
                                <th class="text-center">Observaciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <small>
                                            <i class="fas fa-file-excel text-success"></i> 
                                            @item.NombreArchivo
                                        </small>
                                    </td>
                                    <td class="text-center">
                                        <badge class="badge bg-info">@item.RegistrosProcessados</badge>
                                    </td>
                                    <td class="text-center">
                                        <badge class="badge bg-success">@item.RegistrosExitosos</badge>
                                    </td>
                                    <td class="text-center">
                                        @if (item.RegistrosError > 0)
                                        {
                                            <badge class="badge bg-danger">@item.RegistrosError</badge>
                                        }
                                        else
                                        {
                                            <badge class="badge bg-secondary">0</badge>
                                        }
                                    </td>
                                    <td>
                                        <small>@item.FechaImport.ToString("dd/MM/yyyy HH:mm")</small>
                                    </td>
                                    <td>
                                        <small>@item.UsuarioId</small>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Observaciones))
                                        {
                                            <small class="text-muted">@item.Observaciones</small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">-</small>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info m-3 mb-0">
                        <i class="fas fa-info-circle"></i> No hay importaciones registradas aún.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
