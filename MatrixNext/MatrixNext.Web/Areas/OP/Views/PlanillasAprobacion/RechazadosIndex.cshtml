@model IEnumerable<MatrixNext.Data.Models.OP.PlanillaAprobacionDto>

@{
    ViewData["Title"] = "Planillas Rechazadas";
    var ventanaInicio = ViewBag.VentanaInicio as DateTime?;
    var ventanaFin = ViewBag.VentanaFin as DateTime?;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>
                <i class="fas fa-times-circle"></i>
                Planillas Rechazadas
            </h2>
            @if (ventanaInicio.HasValue && ventanaFin.HasValue)
            {
                <small class="text-muted">
                    Ventana de nómina (corte 16-15): @ventanaInicio.Value.ToString("dd/MM/yyyy") - @ventanaFin.Value.ToString("dd/MM/yyyy")
                </small>
            }
        </div>
        <a href="@Url.Action("AprobadosIndex")" class="btn btn-outline-success">
            <i class="fas fa-check-square"></i> Ver Aprobadas
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">Listado de Planillas</h5>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i>
                    No hay planillas rechazadas en este período.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Fecha Ingreso</th>
                                <th>Trabajo</th>
                                <th>Monto</th>
                                <th>Monto Planilla</th>
                                <th>Motivo Rechazo</th>
                                <th>Estado</th>
                                <th>Coordinador</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.FechaIngreso.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <strong>@item.NombreTrabajo</strong>
                                        <small class="d-block text-muted">ID: @item.TrabajoId</small>
                                    </td>
                                    <td class="text-right">
                                        @item.Monto.ToString("N2") @item.Moneda
                                    </td>
                                    <td class="text-right">
                                        @item.MontoPlanilla.ToString("N2") @item.MonedaPlanilla
                                    </td>
                                    <td>
                                        <small>@item.Observaciones</small>
                                    </td>
                                    <td>
                                        <span class="badge badge-danger">@item.Estado</span>
                                    </td>
                                    <td>@item.NombreCoordinador</td>
                                    <td>
                                        <button type="button" 
                                                class="btn btn-sm btn-success btn-reenviar"
                                                data-planilla-id="@item.Id"
                                                data-nombre-trabajo="@item.NombreTrabajo"
                                                title="Reenvidar para revisión">
                                            <i class="fas fa-redo"></i> Reenviar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal para reenviar planilla -->
<div class="modal fade" id="modalReenviar" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="formReenviar" method="post" asp-action="Aprobar">
                @Html.AntiForgeryToken()
                
                <div class="modal-header">
                    <h5 class="modal-title">Reenvivar Planilla</h5>
                    <button type="button" class="close" data-dismiss="modal">
                        <span>&times;</span>
                    </button>
                </div>
                
                <div class="modal-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        <strong id="trabajoNombre"></strong>
                    </div>

                    <input type="hidden" name="PlanillaId" id="planillaId" />
                    
                    <div class="form-group">
                        <label for="montoAutorizado">Monto Autorizado *</label>
                        <input type="number" 
                               class="form-control" 
                               name="MontoAutorizado" 
                               id="montoAutorizado" 
                               step="0.01"
                               required 
                               placeholder="0.00" />
                        <small class="form-text text-muted">Ingrese el monto a autorizar</small>
                    </div>

                    <div class="form-group">
                        <label for="observaciones">Observaciones</label>
                        <textarea class="form-control" 
                                  name="Observaciones" 
                                  id="observaciones" 
                                  rows="3" 
                                  maxlength="500"
                                  placeholder="Observaciones adicionales (opcional)..."></textarea>
                        <small class="form-text text-muted">Máximo 500 caracteres</small>
                    </div>
                </div>
                
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check"></i> Reenviar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.btn-reenviar').on('click', function() {
                var planillaId = $(this).data('planilla-id');
                var nombreTrabajo = $(this).data('nombre-trabajo');
                
                $('#planillaId').val(planillaId);
                $('#trabajoNombre').text(nombreTrabajo);
                $('#montoAutorizado').val('');
                $('#observaciones').val('');
                
                $('#modalReenviar').modal('show');
            });

            $('#formReenviar').on('submit', function(e) {
                e.preventDefault();
                
                var form = $(this);
                $.ajax({
                    url: form.attr('action'),
                    type: form.attr('method'),
                    data: form.serialize(),
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    success: function(response) {
                        if (response.success) {
                            $('#modalReenviar').modal('hide');
                            
                            $('<div class="alert alert-success alert-dismissible fade show" role="alert">' +
                              response.message +
                              '<button type="button" class="close" data-dismiss="alert">&times;</button>' +
                              '</div>').prependTo('.container-fluid').delay(5000).fadeOut();
                            
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function() {
                        alert('Error al procesar la solicitud. Por favor intente nuevamente.');
                    }
                });
            });
        });
    </script>
}
