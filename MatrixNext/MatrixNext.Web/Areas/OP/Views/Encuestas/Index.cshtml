@model MatrixNext.Web.ViewModels.OP.OpEncuestasViewModel

@{
    ViewData["Title"] = "Gestión de Encuestas";
}

<section class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>Activaciones y anulaciones</h1>
            <p class="text-muted mb-0">
                Usa los procedimientos `OP_GestionCampo_ActivarEncuesta` y `OP_GestionCampo_AnularEncuesta` para ejecutar el flujo legacy desde MatrixNext.
            </p>
        </div>
        @if (!string.IsNullOrEmpty(Model.Mensaje))
        {
            <div class="alert @(Model.Exito ? "alert-success" : "alert-danger") mb-0">
                @Model.Mensaje
            </div>
        }
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Activar encuesta</h5>
                    <form asp-action="Activar" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label">Trabajo</label>
                            <select class="form-select" name="TrabajoId" required>
                                <option value="">Seleccione</option>
                                @foreach (var trabajo in Model.Trabajos)
                                {
                                    <option value="@trabajo.Id">@trabajo.JobBook - @trabajo.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Número de encuesta</label>
                            <input type="number" name="NumeroEncuesta" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Observación</label>
                            <textarea name="Observacion" class="form-control" rows="3"></textarea>
                        </div>
                        <button class="btn btn-primary w-100" type="submit">Activar</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Anular encuesta</h5>
                    <form asp-action="Anular" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label">Trabajo</label>
                            <select class="form-select" name="TrabajoId" required>
                                <option value="">Seleccione</option>
                                @foreach (var trabajo in Model.Trabajos)
                                {
                                    <option value="@trabajo.Id">@trabajo.JobBook - @trabajo.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Número de encuesta</label>
                            <input type="number" name="NumeroEncuesta" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Observación</label>
                            <textarea name="Observacion" class="form-control" rows="3"></textarea>
                        </div>
                        <button class="btn btn-danger w-100" type="submit">Anular</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
