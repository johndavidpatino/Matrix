@model MatrixNext.Data.Models.RP.ReporteResultadoDTO

@{
    ViewData["Title"] = "Reportes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-chart-bar"></i>
                        Reportes Disponibles
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <button type="button" class="btn btn-primary" id="btnNuevoReporte">
                                <i class="fas fa-plus"></i> Generar Nuevo Reporte
                            </button>
                        </div>
                    </div>

                    <table id="tblReportes" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Usuario</th>
                                <th>Fecha Generación</th>
                                <th>Proyecto</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- DataTables via AJAX -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Generar Reporte -->
<div class="modal fade" id="modalGenerarReporte" tabindex="-1" aria-labelledby="modalGenerarReporteLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalGenerarReporteLabel">Generar Reporte</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formGenerarReporte">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="reporteId" class="form-label">Tipo de Reporte</label>
                            <select class="form-select" id="reporteId" name="reporteId" required>
                                <option value="">Seleccione...</option>
                                <!-- Cargar via AJAX -->
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="proyectoId" class="form-label">Proyecto</label>
                            <select class="form-select" id="proyectoId" name="proyectoId">
                                <option value="">Todos</option>
                                <!-- Cargar via AJAX -->
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="fechaDesde" class="form-label">Fecha Desde</label>
                            <input type="date" class="form-control" id="fechaDesde" name="fechaDesde">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="fechaHasta" class="form-label">Fecha Hasta</label>
                            <input type="date" class="form-control" id="fechaHasta" name="fechaHasta">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnGenerarReporte">Generar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // DataTable
            var table = $('#tblReportes').DataTable({
                ajax: {
                    url: '@Url.Action("GetReportes", "Reportes")',
                    type: 'GET',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'reporteId' },
                    { data: 'nombre' },
                    { data: 'usuario' },
                    { 
                        data: 'fechaGeneracion',
                        render: function(data) {
                            return data ? new Date(data).toLocaleDateString() : '';
                        }
                    },
                    { data: 'proyecto' },
                        data: null,
                        render: function(data, type, row) {
                            return `
                                <button class="btn btn-sm btn-info btn-ver" data-id="${row.reporteId}">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="btn btn-sm btn-success btn-excel" data-id="${row.reporteId}">
                                    <i class="fas fa-file-excel"></i>
                                </button>
                            `;
                        }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
                }
            });

            // Nuevo reporte
            $('#btnNuevoReporte').click(function() {
                $('#modalGenerarReporte').modal('show');
            });

            // Generar reporte
            $('#btnGenerarReporte').click(function() {
                var formData = $('#formGenerarReporte').serialize();
                $.post('@Url.Action("Generar", "Reportes")', formData, function(response) {
                    if (response.success) {
                        toastr.success('Reporte generado exitosamente');
                        $('#modalGenerarReporte').modal('hide');
                        table.ajax.reload();
                    } else {
                        toastr.error(response.message || 'Error al generar reporte');
                    }
                });
            });

            // Ver reporte
            $(document).on('click', '.btn-ver', function() {
                var reporteId = $(this).data('id');
                window.location.href = '@Url.Action("Detalle", "Reportes")/' + reporteId;
            });

            // Exportar Excel
            $(document).on('click', '.btn-excel', function() {
                var reporteId = $(this).data('id');
                window.location.href = '@Url.Action("ExportarExcel", "Reportes")/' + reporteId;
            });

            // Nota: Exportar PDF no disponible en esta versión (fuera de scope Sprint 10)
        });
    </script>
}
