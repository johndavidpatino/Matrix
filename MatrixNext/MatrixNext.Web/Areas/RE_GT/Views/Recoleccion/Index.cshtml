@* MatrixNext.Web/Areas/RE_GT/Views/Recoleccion/Index.cshtml *@
@using MatrixNext.Data.DTOs.RE_GT
@model RecoleccionDatosMenuDto

@{
    ViewData["Title"] = @Model.TituloPagina;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="display-5 mb-2">
                <i class="fas fa-folder-open text-primary me-2"></i>@Model.TituloPagina
            </h1>
            <p class="text-muted lead">@Model.Descripcion</p>
            <hr />
        </div>
    </div>

    <!-- Secciones de Menú -->
    @foreach (var seccion in Model.Secciones)
    {
        <div class="row mb-5">
            <!-- Encabezado de Sección -->
            <div class="col-md-12">
                <div class="section-header d-flex align-items-center mb-3">
                    <i class="fas fa-2x @seccion.IconoCss text-primary me-3"></i>
                    <div>
                        <h2 class="mb-0">@seccion.Nombre</h2>
                        <small class="text-muted">@seccion.Descripcion</small>
                    </div>
                </div>
            </div>

            <!-- Grid de Items -->
            <div class="col-md-12">
                <div class="row">
                    @foreach (var item in seccion.Items.OrderBy(i => i.Orden))
                    {
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                            <div class="card h-100 shadow-sm border-0 hover-lift transition-all">
                                <div class="card-body d-flex flex-column">
                                    <!-- Icono -->
                                    <div class="mb-3">
                                        <i class="fas fa-3x @item.IconoCss text-primary opacity-75"></i>
                                    </div>

                                    <!-- Título -->
                                    <h5 class="card-title mb-2 flex-grow-1">@item.Titulo</h5>

                                    <!-- Descripción -->
                                    <p class="card-text small text-muted flex-grow-1">
                                        @item.Descripcion
                                    </p>

                                    <!-- Link -->
                                    <a href="@item.Url" 
                                       class="btn btn-sm btn-outline-primary mt-auto"
                                       title="@item.Descripcion"
                                       data-bs-toggle="tooltip">
                                        <i class="fas fa-arrow-right me-1"></i>Acceder
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
        .hover-lift {
            transition: all 0.3s ease;
        }

            .hover-lift:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 16px rgba(0,0,0,0.1) !important;
            }

        .section-header {
            border-bottom: 3px solid #007bff;
            padding-bottom: 1rem;
        }

        .card {
            border-radius: 8px;
            overflow: hidden;
        }

            .card:hover {
                box-shadow: 0 8px 16px rgba(0, 123, 255, 0.2) !important;
            }

        .transition-all {
            transition: all 0.3s ease;
        }

        .btn-outline-primary:hover {
            background-color: #007bff;
            border-color: #007bff;
        }
    </style>
}

@section Scripts {
    <script>
        // Inicializar tooltips de Bootstrap
        document.addEventListener('DOMContentLoaded', function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}
