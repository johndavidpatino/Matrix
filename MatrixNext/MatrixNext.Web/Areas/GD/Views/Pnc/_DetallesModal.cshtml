@model MatrixNext.Data.Models.GD.PncDetalleViewModel

<div class="modal fade" id="modalForm" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="fas fa-info-circle me-2"></i>Detalle PNC #@Model.Producto.Id
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <!-- Info General -->
                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="fas fa-clipboard-list me-2"></i>Información General</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <p><strong>Estado:</strong> 
                                    @{
                                        var estadoClass = Model.Producto.Estado switch
                                        {
                                            1 => "bg-danger",
                                            2 => "bg-success",
                                            _ => "bg-warning"
                                        };
                                        var estadoText = Model.Producto.Estado switch
                                        {
                                            1 => "Abierto",
                                            2 => "Cerrado",
                                            _ => "En proceso"
                                        };
                                    }
                                    <span class="badge @estadoClass">@estadoText</span>
                                </p>
                                <p><strong>Asociado a:</strong> @Model.Producto.AsociadoADescripcion</p>
                                <p><strong>Proyecto/Trabajo:</strong> @Model.Producto.ProyectoTrabajo</p>
                            </div>
                            <div class="col-md-4">
                                <p><strong>Proceso:</strong> @Model.Producto.ProcesoDescripcion</p>
                                <p><strong>Procedimiento:</strong> @Model.Producto.ProcedimientoDescripcion</p>
                                <p><strong>Unidad:</strong> @Model.Producto.UnidadDescripcion</p>
                            </div>
                            <div class="col-md-4">
                                <p><strong>Fuente:</strong> @Model.Producto.FuenteDescripcion</p>
                                <p><strong>Categoría:</strong> @Model.Producto.CategoriaDescripcion</p>
                                <p><strong>Fecha Reclamo:</strong> @Model.Producto.FechaReclamo.ToString("dd/MM/yyyy")</p>
                            </div>
                        </div>
                        <hr>
                        <div class="row">
                            <div class="col-md-4">
                                <p><strong>Persona Identifica:</strong> @Model.Producto.PersonaIdentificaNombre</p>
                            </div>
                            <div class="col-md-4">
                                <p><strong>Responsable:</strong> @Model.Producto.ResponsableNombre</p>
                            </div>
                            <div class="col-md-4">
                                <p><strong>Informar A:</strong> @Model.Producto.InformarANombre</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Descripción -->
                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="fas fa-comment-alt me-2"></i>Descripción del Problema</h6>
                    </div>
                    <div class="card-body">
                        <p>@Model.Producto.Descripcion</p>
                    </div>
                </div>

                <!-- Causas Registradas -->
                <div class="card mb-3">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h6 class="mb-0"><i class="fas fa-search me-2"></i>Causas Registradas</h6>
                        <span class="badge bg-primary">@Model.Causas.Count()</span>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.Causas.Any())
                        {
                            <table class="table table-striped mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Causa</th>
                                        <th>Corrección</th>
                                        <th>Fecha Est. Cierre</th>
                                        <th>Fecha Registro</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var causa in Model.Causas)
                                    {
                                        <tr>
                                            <td>@causa.Id</td>
                                            <td>@causa.Causa</td>
                                            <td>@causa.Correccion</td>
                                            <td>@causa.FechaEstimadaCierre?.ToString("dd/MM/yyyy")</td>
                                            <td>@causa.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                No hay causas registradas aún
                            </div>
                        }
                    </div>
                </div>

                <!-- Acciones Registradas -->
                <div class="card mb-3">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h6 class="mb-0"><i class="fas fa-tasks me-2"></i>Acciones Correctivas</h6>
                        <span class="badge bg-primary">@Model.Acciones.Count()</span>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.Acciones.Any())
                        {
                            <table class="table table-striped mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Acción</th>
                                        <th>Responsable</th>
                                        <th>F. Compromiso</th>
                                        <th>F. Cierre</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var accion in Model.Acciones)
                                    {
                                        <tr>
                                            <td>@accion.Id</td>
                                            <td>@accion.Accion</td>
                                            <td>@accion.Responsable</td>
                                            <td>@accion.FechaCompromiso?.ToString("dd/MM/yyyy")</td>
                                            <td>@accion.FechaCierre?.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                @{
                                                    var accionClass = accion.Estado == 1 ? "bg-warning" : "bg-success";
                                                    var accionText = accion.Estado == 1 ? "Pendiente" : "Completada";
                                                }
                                                <span class="badge @accionClass">@accionText</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="fas fa-clipboard-check fa-2x mb-2 d-block"></i>
                                No hay acciones registradas aún
                            </div>
                        }
                    </div>
                </div>

                <!-- Historial de Estados -->
                <div class="card">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h6 class="mb-0"><i class="fas fa-history me-2"></i>Historial de Estados</h6>
                        <span class="badge bg-secondary">@Model.HistorialEstados.Count()</span>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.HistorialEstados.Any())
                        {
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Estado</th>
                                        <th>Usuario</th>
                                        <th>Observación</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.HistorialEstados.OrderByDescending(x => x.Fecha))
                                    {
                                        <tr>
                                            <td>@log.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@log.EstadoDescripcion</td>
                                            <td>@log.UsuarioNombre</td>
                                            <td>@log.Observacion</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="text-center py-3 text-muted">
                                Sin historial de estados
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cerrar
                </button>
            </div>
        </div>
    </div>
</div>