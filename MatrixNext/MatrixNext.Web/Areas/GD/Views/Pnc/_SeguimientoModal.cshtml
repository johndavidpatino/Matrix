@model MatrixNext.Data.Models.GD.PncDetalleViewModel

<div class="modal fade" id="modalForm" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-chart-line me-2"></i>Seguimiento PNC #@Model.Producto.Id
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <!-- Resumen -->
                <div class="alert alert-info">
                    <div class="row">
                        <div class="col-md-8">
                            <strong>@Model.Producto.ProyectoTrabajo</strong> - @Model.Producto.ProcesoDescripcion
                            <br>
                            <small class="text-muted">@Model.Producto.Descripcion</small>
                        </div>
                        <div class="col-md-4 text-end">
                            @{
                                var estadoClass = Model.Producto.Estado switch
                                {
                                    1 => "bg-danger",
                                    2 => "bg-success",
                                    _ => "bg-warning"
                                };
                                var estadoText = Model.Producto.Estado switch
                                {
                                    1 => "Abierto",
                                    2 => "Cerrado",
                                    _ => "En proceso"
                                };
                            }
                            <span class="badge @estadoClass fs-6">@estadoText</span>
                        </div>
                    </div>
                </div>

                <!-- Indicadores -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="card text-center">
                            <div class="card-body py-3">
                                <h3 class="text-primary mb-0">@Model.Causas.Count()</h3>
                                <small class="text-muted">Causas Registradas</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card text-center">
                            <div class="card-body py-3">
                                <h3 class="text-info mb-0">@Model.Acciones.Count()</h3>
                                <small class="text-muted">Acciones Correctivas</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card text-center">
                            <div class="card-body py-3">
                                @{
                                    var accionesPendientes = Model.Acciones.Count(a => a.Estado == 1);
                                    var badgeClass = accionesPendientes > 0 ? "text-warning" : "text-success";
                                }
                                <h3 class="@badgeClass mb-0">@accionesPendientes</h3>
                                <small class="text-muted">Acciones Pendientes</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Causas y sus Acciones -->
                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="fas fa-list-check me-2"></i>Causas y Acciones</h6>
                    </div>
                    <div class="card-body">
                        @if (Model.Causas.Any())
                        {
                            <div class="accordion" id="accordionCausas">
                                @{
                                    int index = 0;
                                    foreach (var causa in Model.Causas)
                                    {
                                        var accionesCausa = Model.Acciones.Where(a => a.CausaId == causa.Id).ToList();
                                        <div class="accordion-item">
                                            <h2 class="accordion-header">
                                                <button class="accordion-button @(index > 0 ? "collapsed" : "")" type="button" 
                                                        data-bs-toggle="collapse" data-bs-target="#causa@index">
                                                    <span class="badge bg-secondary me-2">C@(index + 1)</span>
                                                    @(causa.Causa.Length > 50 ? causa.Causa.Substring(0, 50) + "..." : causa.Causa)
                                                    @if (accionesCausa.Any())
                                                    {
                                                        <span class="badge bg-info ms-2">@accionesCausa.Count acciones</span>
                                                    }
                                                </button>
                                            </h2>
                                            <div id="causa@index" class="accordion-collapse collapse @(index == 0 ? "show" : "")" 
                                                 data-bs-parent="#accordionCausas">
                                                <div class="accordion-body">
                                                    <p><strong>Causa:</strong> @causa.Causa</p>
                                                    <p><strong>Corrección:</strong> @(causa.Correccion ?? "No especificada")</p>
                                                    <p><strong>Fecha Est. Cierre:</strong> @(causa.FechaEstimadaCierre?.ToString("dd/MM/yyyy") ?? "No definida")</p>
                                                    
                                                    @if (accionesCausa.Any())
                                                    {
                                                        <hr>
                                                        <h6>Acciones Correctivas:</h6>
                                                        <ul class="list-group list-group-flush">
                                                            @foreach (var accion in accionesCausa)
                                                            {
                                                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                                                    <div>
                                                                        <small>@accion.Accion</small>
                                                                        <br>
                                                                        <span class="text-muted"><small>Responsable: @accion.Responsable</small></span>
                                                                    </div>
                                                                    @{
                                                                        var accionBadgeClass = accion.Estado == 1 ? "bg-warning" : "bg-success";
                                                                        var accionBadgeText = accion.Estado == 1 ? "Pendiente" : "Completada";
                                                                    }
                                                                    <span class="badge @accionBadgeClass">@accionBadgeText</span>
                                                                </li>
                                                            }
                                                        </ul>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        index++;
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="fas fa-exclamation-circle fa-2x mb-2 d-block text-warning"></i>
                                <strong>No hay causas registradas</strong>
                                <p class="mb-0"><small>Este PNC requiere registrar causas para su seguimiento</small></p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Historial de Estados -->
                <div class="card">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="fas fa-history me-2"></i>Historial de Cambios</h6>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.HistorialEstados.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var log in Model.HistorialEstados.OrderByDescending(x => x.Fecha))
                                {
                                    <li class="list-group-item">
                                        <div class="d-flex w-100 justify-content-between">
                                            <h6 class="mb-1">@log.EstadoDescripcion</h6>
                                            <small class="text-muted">@log.Fecha.ToString("dd/MM/yyyy HH:mm")</small>
                                        </div>
                                        <p class="mb-1 text-muted"><small>@log.Observacion</small></p>
                                        <small>Por: @log.UsuarioNombre</small>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-center py-3 text-muted">
                                Sin historial de cambios
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cerrar
                </button>
            </div>
        </div>
    </div>
</div>