@model MatrixNext.Web.Models.ViewModels.GD.SolicitudListVM
@{
    ViewData["Title"] = "Solicitudes de Documentos";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">@ViewData["Title"]</h2>
            <p class="text-muted mb-0">Creación y seguimiento de solicitudes de documentos.</p>
        </div>
        <button class="btn btn-primary" id="btnCrearSolicitud">
            <i class="fas fa-plus"></i> Nueva Solicitud
        </button>
    </div>

    @if (ViewData["Error"] != null)
    {
        <div class="alert alert-danger">@ViewData["Error"]</div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle" id="tblSolicitudes">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Documento</th>
                    <th>Tipo Solicitud</th>
                    <th>Solicitante</th>
                    <th>Estado</th>
                    <th>Revisores Pendientes</th>
                    <th>Revisores Aprobados</th>
                    <th>Fecha</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Solicitudes ?? new List<MatrixNext.Web.Models.ViewModels.GD.SolicitudListItemVM>())
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.NombreDocumento</td>
                        <td>@item.TipoSolicitud</td>
                        <td>@item.Solicitante</td>
                        <td><span class="badge bg-info text-dark">@item.Estado</span></td>
                        <td><span class="badge bg-warning text-dark">@item.RevisoresPendientes</span></td>
                        <td><span class="badge bg-success">@item.RevisoresAprobados</span></td>
                        <td>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-info btnAsignarRevisores" data-id="@item.Id" title="Asignar Revisores">
                                <i class="fas fa-users"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" title="Ver Detalles">
                                <i class="fas fa-eye"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if ((Model.Solicitudes?.Count ?? 0) == 0)
        {
            <div class="alert alert-info">No hay solicitudes registradas.</div>
        }
    </div>
</div>

<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true"></div>
<div class="modal fade" id="assignReviewersModal" tabindex="-1" aria-hidden="true"></div>

@section Scripts {
    <script>
        $(function() {
            // Crear solicitud
            $('#btnCrearSolicitud').click(function() {
                $.get('@Url.Action("Create")', function(html) {
                    $('#createModal').html(html).modal('show');
                });
            });

            // Asignar revisores
            $(document).on('click', '.btnAsignarRevisores', function() {
                var id = $(this).data('id');
                $.get('@Url.Action("AssignReviewers")', { id: id }, function(html) {
                    $('#assignReviewersModal').html(html).modal('show');
                });
            });

            // Crear solicitud - Submit
            $(document).on('submit', '#frmCreateSolicitud', function(e) {
                e.preventDefault();
                var form = this;
                $.post('@Url.Action("Create")', $(form).serialize(), function(response) {
                    if (response.success) {
                        $('#createModal').modal('hide');
                        // Mostrar modal de asignar revisores
                        $.get('@Url.Action("AssignReviewers")', { id: response.idSolicitud }, function(html) {
                            $('#assignReviewersModal').html(html).modal('show');
                        });
                    } else {
                        alert(response.message || 'Error al crear solicitud');
                    }
                });
            });

            // Asignar revisores - Submit
            $(document).on('submit', '#frmAssignReviewers', function(e) {
                e.preventDefault();
                $.post('@Url.Action("AssignReviewers")', $(this).serialize(), function(response) {
                    if (response.success) {
                        $('#assignReviewersModal').modal('hide');
                        location.reload();
                    } else {
                        alert(response.message || 'Error al asignar revisores');
                    }
                });
            });
        });
    </script>
}
