@model MatrixNext.Web.Models.ViewModels.GD.SolicitudCreateVM
@{
    var hasErrors = !ViewData.ModelState.IsValid;
}

<div class="modal-content">
    <div class="modal-header">
        <h5 class="modal-title">Crear Nueva Solicitud</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <form id="frmCreateSolicitud" method="post">
        @Html.AntiForgeryToken()
        <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
            @if (hasErrors)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var key in ViewData.ModelState.Keys.Where(k => ViewData.ModelState[k].Errors.Count > 0))
                        {
                            <li>@ViewData.ModelState[key].Errors.First().ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div class="row g-3">
                <!-- Tipo de Solicitud -->
                <div class="col-md-6">
                    <label for="TipoSolicitud" class="form-label">Tipo de Solicitud <span class="text-danger">*</span></label>
                    <select id="TipoSolicitud" name="TipoSolicitud" class="form-select" required>
                        <option value="">-- Seleccionar --</option>
                        @foreach (var item in (Model.TiposSolicitud ?? new List<MatrixNext.Data.Adapters.GD.Models.SelectListItemDto>()).Where(x => x != null))
                        {
                            <option value="@item.Id">@item.Nombre</option>
                        }
                    </select>
                    @Html.ValidationMessageFor(m => m.TipoSolicitud)
                </div>

                <!-- Documento -->
                <div class="col-md-6">
                    <label for="IdDocumento" class="form-label">Documento <span class="text-danger">*</span></label>
                    <select id="IdDocumento" name="IdDocumento" class="form-select" required>
                        <option value="">-- Seleccionar --</option>
                        @foreach (var item in (Model.Documentos ?? new List<MatrixNext.Data.Adapters.GD.Models.SelectListItemDto>()).Where(x => x != null))
                        {
                            <option value="@item.Id">@item.Nombre</option>
                        }
                    </select>
                    @Html.ValidationMessageFor(m => m.IdDocumento)
                </div>

                <!-- Área -->
                <div class="col-md-6">
                    <label for="Area" class="form-label">Área <span class="text-danger">*</span></label>
                    <input type="text" id="Area" name="Area" class="form-control" value="@Model.Area" required maxlength="100" />
                    @Html.ValidationMessageFor(m => m.Area)
                </div>

                <!-- Cargo -->
                <div class="col-md-6">
                    <label for="Cargo" class="form-label">Cargo <span class="text-danger">*</span></label>
                    <input type="text" id="Cargo" name="Cargo" class="form-control" value="@Model.Cargo" required maxlength="100" />
                    @Html.ValidationMessageFor(m => m.Cargo)
                </div>

                <!-- Razón -->
                <div class="col-12">
                    <label for="Razon" class="form-label">Razón de la Solicitud <span class="text-danger">*</span></label>
                    <input type="text" id="Razon" name="Razon" class="form-control" value="@Model.Razon" required maxlength="500" />
                    @Html.ValidationMessageFor(m => m.Razon)
                </div>

                <!-- Descripción -->
                <div class="col-12">
                    <label for="Descripcion" class="form-label">Descripción <span class="text-danger">*</span></label>
                    <textarea id="Descripcion" name="Descripcion" class="form-control" rows="3" required maxlength="1000">@Model.Descripcion</textarea>
                    @Html.ValidationMessageFor(m => m.Descripcion)
                </div>

                <!-- Área de Uso (opcional) -->
                <div class="col-md-6">
                    <label for="AreaUso" class="form-label">Área de Uso</label>
                    <input type="text" id="AreaUso" name="AreaUso" class="form-control" value="@Model.AreaUso" maxlength="100" />
                </div>

                <!-- Sitio de Acceso (opcional) -->
                <div class="col-md-6">
                    <label for="SitioAcceso" class="form-label">Sitio de Acceso</label>
                    <input type="text" id="SitioAcceso" name="SitioAcceso" class="form-control" value="@Model.SitioAcceso" maxlength="100" />
                </div>

                <!-- Comentarios (opcional) -->
                <div class="col-12">
                    <label for="Comentarios" class="form-label">Comentarios Adicionales</label>
                    <textarea id="Comentarios" name="Comentarios" class="form-control" rows="2" maxlength="500">@Model.Comentarios</textarea>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Crear Solicitud
            </button>
        </div>
    </form>
</div>
