@model MatrixNext.Web.Models.ViewModels.GD.AprobacionesIndexVM
@{
    ViewData["Title"] = "Aprobaciones de Documentos";
}

<div class="container py-4">
    <h2>@ViewData["Title"]</h2>
    <p class="text-muted">Revisiones pendientes asignadas al usuario actual.</p>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger">@Model.Error</div>
    }

    <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
            <thead>
                <tr>
                    <th>Documento</th>
                    <th>Tipo revisión</th>
                    <th>Fecha</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Revisiones?.Any() == true)
            {
                foreach (var r in Model.Revisiones)
                {
                    <tr>
                        <td>@r.NombreDocumento</td>
                        <td>@r.TipoRevision</td>
                        <td>@(r.FechaAprobacion?.ToString("yyyy-MM-dd HH:mm") ?? "Pendiente")</td>
                        <td class="text-end">
                            <form asp-action="Aprobar" method="post" class="d-inline">
                                <input type="hidden" name="idRevision" value="@r.IdRevision" />
                                <input type="hidden" name="documentoId" value="@r.DocumentoId" />
                                <button type="submit" class="btn btn-sm btn-primary">Aprobar</button>
                                @Html.AntiForgeryToken()
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No hay revisiones pendientes.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
