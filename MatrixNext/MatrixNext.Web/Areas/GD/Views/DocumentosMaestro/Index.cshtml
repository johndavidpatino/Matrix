@model List<MatrixNext.Web.Models.ViewModels.GD.MaestroListVM>
@{
    ViewData["Title"] = "Maestro de Documentos";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">@ViewData["Title"]</h2>
            <p class="text-muted mb-0">CRUD de documentos (construcción, actualización, anulación).</p>
        </div>
        <button class="btn btn-primary" id="btnCreateMaestro">
            <i class="fas fa-plus"></i> Nuevo Documento
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle" id="tblMaestro">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Código</th>
                    <th>Proceso</th>
                    <th>Responsable</th>
                    <th>Estado</th>
                    <th>Creado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model ?? new List<MatrixNext.Web.Models.ViewModels.GD.MaestroListVM>())
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td><span class="badge bg-info text-dark">@item.Codigo</span></td>
                        <td>@item.Proceso</td>
                        <td>@item.Responsable</td>
                        <td>
                            @if (item.Estado == "Activo")
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </td>
                        <td>@item.FechaRegistro.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-warning btnEdit" data-id="@item.Id" title="Editar">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-danger btnDelete" data-id="@item.Id" title="Anular" @(item.Estado != "Activo" ? "disabled" : string.Empty)>
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="ajaxModal" tabindex="-1" aria-hidden="true"></div>

@section Scripts {
    <script>
        (function () {
            const modal = $('#ajaxModal');

            $('#btnCreateMaestro').on('click', function () {
                $.get('@Url.Action("Create")', function (html) {
                    modal.html(html).modal('show');
                });
            });

            $(document).on('click', '.btnEdit', function () {
                const id = $(this).data('id');
                $.get('@Url.Action("Edit")/' + id, function (html) {
                    modal.html(html).modal('show');
                });
            });

            $(document).on('click', '.btnDelete', function () {
                const id = $(this).data('id');
                if (!confirm('¿Está seguro de anular este documento?')) return;

                $.post('@Url.Action("Delete")/' + id, function (res) {
                    if (res.success) {
                        toastr.success(res.message || 'Documento anulado');
                        setTimeout(() => window.location.reload(), 800);
                    } else {
                        toastr.error(res.message || 'No se pudo anular');
                    }
                });
            });

            $(document).on('change', '#TipoSolicitud', function () {
                const value = parseInt($(this).val() || '0');
                const controlled = $('#controlled-section');
                if (value === 1) {
                    controlled.removeClass('d-none');
                } else {
                    controlled.addClass('d-none');
                }
            });

            modal.on('shown.bs.modal', function () {
                $('#TipoSolicitud').trigger('change');
            });

            $(document).on('submit', '#formCreateMaestro, #formEditMaestro', function (e) {
                e.preventDefault();
                const form = $(this);
                const action = form.attr('action');
                const method = form.attr('method') || 'post';
                $.ajax({
                    url: action,
                    type: method,
                    data: form.serialize(),
                    success: function (res) {
                        if (res.success) {
                            toastr.success(res.message || 'Operación exitosa');
                            modal.modal('hide');
                            setTimeout(() => window.location.reload(), 700);
                        } else if (typeof res === 'string') {
                            modal.html(res);
                        } else {
                            toastr.error(res.message || 'Error en la operación');
                        }
                    },
                    error: function () {
                        toastr.error('Error inesperado');
                    }
                });
            });
        })();
    </script>
}
