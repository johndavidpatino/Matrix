@model MatrixNext.Data.DTOs.PC.ProductoInternoDto

<div class="modal-header">
    <h5 class="modal-title">
        @if (Model.Id == 0)
        {
            <i class="fas fa-plus"></i> @:Nuevo Producto Interno
        }
        else
        {
            <i class="fas fa-edit"></i> @:Editar Producto Interno
        }
    </h5>
    <button type="button" class="close" data-dismiss="modal">
        <span>&times;</span>
    </button>
</div>

<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post" id="formProducto">
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Envia" />

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="ProyectoId" class="control-label"></label>
                    <select asp-for="ProyectoId" class="form-control" id="selectProyecto" required>
                        <option value="">Seleccione un proyecto...</option>
                        @* Cargar dinámicamente desde API *@
                    </select>
                    <span asp-validation-for="ProyectoId" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="FechaEnvio" class="control-label"></label>
                    <input asp-for="FechaEnvio" type="date" class="form-control" />
                    <span asp-validation-for="FechaEnvio" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="UnidadEnvia" class="control-label"></label>
                    <select asp-for="UnidadEnvia" class="form-control" id="selectUnidadEnvia" required>
                        <option value="">Seleccione unidad...</option>
                        @* Cargar dinámicamente desde API *@
                    </select>
                    <span asp-validation-for="UnidadEnvia" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="UnidadRecibe" class="control-label"></label>
                    <select asp-for="UnidadRecibe" class="form-control" id="selectUnidadRecibe" required>
                        <option value="">Seleccione unidad...</option>
                        @* Cargar dinámicamente desde API *@
                    </select>
                    <span asp-validation-for="UnidadRecibe" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <div class="form-group">
                    <label asp-for="Producto" class="control-label"></label>
                    <input asp-for="Producto" class="form-control" maxlength="200" required />
                    <span asp-validation-for="Producto" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="Tipo" class="control-label"></label>
                    <select asp-for="Tipo" class="form-control" id="selectTipo" required>
                        <option value="">Seleccione tipo...</option>
                        @* Cargar dinámicamente desde API *@
                    </select>
                    <span asp-validation-for="Tipo" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Descripcion" class="control-label"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="2" maxlength="500"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Cantidad" class="control-label"></label>
            <input asp-for="Cantidad" type="number" step="0.01" min="0.01" class="form-control" required />
            <span asp-validation-for="Cantidad" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Observaciones" class="control-label"></label>
            <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Observaciones" class="text-danger"></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">
            <i class="fas fa-times"></i> Cancelar
        </button>
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> Guardar
        </button>
    </div>
</form>

<script>
    // Validación cliente para unidades diferentes
    $('#formProducto').on('submit', function(e) {
        var unidadEnvia = $('#selectUnidadEnvia').val();
        var unidadRecibe = $('#selectUnidadRecibe').val();
        
        if (unidadEnvia === unidadRecibe && unidadEnvia !== '') {
            e.preventDefault();
            alert('La unidad que envía no puede ser la misma que recibe');
            return false;
        }
    });
</script>
