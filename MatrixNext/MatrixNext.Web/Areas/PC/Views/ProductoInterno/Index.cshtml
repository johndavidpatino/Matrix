@model IEnumerable<MatrixNext.Data.DTOs.PC.ProductoInternoListDto>

@{
    ViewData["Title"] = "Productos Internos";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="fas fa-boxes"></i> Productos Internos</h2>
        <button class="btn btn-primary" onclick="abrirModalCrear()">
            <i class="fas fa-plus"></i> Nuevo Producto
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert">
                <span>&times;</span>
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert">
                <span>&times;</span>
            </button>
        </div>
    }

    <!-- Filtros -->
    <div class="card mb-3">
        <div class="card-body">
            <form asp-action="Index" method="get" class="form-inline">
                <div class="form-group mr-3">
                    <label for="unidadId" class="mr-2">Unidad:</label>
                    <select name="unidadId" id="unidadId" class="form-control">
                        <option value="">Todas</option>
                        @* Aquí cargar unidades dinámicamente *@
                    </select>
                </div>

                <div class="form-group mr-3">
                    <label for="proyectoId" class="mr-2">Proyecto:</label>
                    <select name="proyectoId" id="proyectoId" class="form-control">
                        <option value="">Todos</option>
                        @* Aquí cargar proyectos dinámicamente *@
                    </select>
                </div>

                <div class="form-group mr-3">
                    <div class="custom-control custom-checkbox">
                        <input type="checkbox" class="custom-control-input" id="soloEnviados" name="soloEnviados" 
                               value="true" @(ViewBag.SoloEnviados == true ? "checked" : "")>
                        <label class="custom-control-label" for="soloEnviados">Solo Enviados</label>
                    </div>
                </div>

                <div class="form-group mr-3">
                    <div class="custom-control custom-checkbox">
                        <input type="checkbox" class="custom-control-input" id="soloPendientes" name="soloPendientes" 
                               value="true" @(ViewBag.SoloPendientes == true ? "checked" : "")>
                        <label class="custom-control-label" for="soloPendientes">Solo Pendientes</label>
                    </div>
                </div>

                <button type="submit" class="btn btn-secondary mr-2">
                    <i class="fas fa-filter"></i> Filtrar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-times"></i> Limpiar
                </a>
            </form>
        </div>
    </div>

    <!-- Grid de productos -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="tablaProductos">
                    <thead>
                        <tr>
                            <th>Proyecto</th>
                            <th>Producto</th>
                            <th>Unidad Envía</th>
                            <th>Unidad Recibe</th>
                            <th>Cantidad</th>
                            <th>Fecha Envío</th>
                            <th>Fecha Recepción</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.ProyectoNombre</td>
                                    <td>
                                        <strong>@item.Producto</strong>
                                        @if (!string.IsNullOrEmpty(item.Descripcion))
                                        {
                                            <br /><small class="text-muted">@item.Descripcion</small>
                                        }
                                    </td>
                                    <td>@item.UnidadEnviaNombre</td>
                                    <td>@item.UnidadRecibeNombre</td>
                                    <td>
                                        <span class="badge badge-info">@item.Cantidad.ToString("N2")</span>
                                    </td>
                                    <td>
                                        @if (item.FechaEnvio.HasValue)
                                        {
                                            @item.FechaEnvio.Value.ToString("dd/MM/yyyy")
                                        }
                                    </td>
                                    <td>
                                        @if (item.FechaRecepcion.HasValue)
                                        {
                                            @item.FechaRecepcion.Value.ToString("dd/MM/yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Pendiente</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge badge-@item.EstadoClass">@item.Estado</span>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <button type="button" class="btn btn-sm btn-info" 
                                                    onclick="verDetalles(@item.Id)" 
                                                    title="Ver detalles">
                                                <i class="fas fa-eye"></i>
                                            </button>

                                            @if (!item.FechaRecepcion.HasValue)
                                            {
                                                <button type="button" class="btn btn-sm btn-warning" 
                                                        onclick="editarProducto(@item.Id)" 
                                                        title="Editar">
                                                    <i class="fas fa-edit"></i>
                                                </button>

                                                <button type="button" class="btn btn-sm btn-success" 
                                                        onclick="recibirProducto(@item.Id)" 
                                                        title="Recibir">
                                                    <i class="fas fa-check"></i>
                                                </button>

                                                <button type="button" class="btn btn-sm btn-danger" 
                                                        onclick="eliminarProducto(@item.Id)" 
                                                        title="Eliminar">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted">
                                    <i class="fas fa-inbox fa-3x mb-3"></i>
                                    <p>No hay productos registrados</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Container -->
<div class="modal fade" id="modalProducto" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="modalContent">
            <!-- Contenido cargado dinámicamente -->
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pc/producto-interno.js"></script>
}
