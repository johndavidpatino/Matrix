@model MatrixNext.Web.ViewModels.FiltrosVM
@{
    ViewData["Title"] = "Proyectos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">Proyectos</h2>
            <small class="text-muted">Gestión de proyectos (PY_Proyectos)</small>
        </div>
        <button class="btn btn-primary" data-url="@Url.Action("CreateModal")" data-ajax-modal>
            <i class="bi bi-plus-lg"></i> Nuevo Proyecto
        </button>
    </div>

    <form id="filtrosForm" class="row g-2 mb-3" data-grid-target="#gridContainer" data-grid-url="@Url.Action("Grid")">
        <div class="col-md-4">
            <input asp-for="Busqueda" class="form-control" placeholder="Buscar por nombre o JobBook" />
        </div>
        <div class="col-md-2">
            <select asp-for="Estado" class="form-select">
                <option value="-1">Todos</option>
                <option value="1">Activo</option>
                <option value="0">Inactivo</option>
            </select>
        </div>
        <div class="col-md-2">
            <select asp-for="PageSize" class="form-select">
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-center">
            <button type="submit" class="btn btn-outline-secondary me-2">Filtrar</button>
            <button type="button" class="btn btn-outline-light border" id="btnLimpiar">Limpiar</button>
        </div>
    </form>

    <div id="gridContainer" data-grid-url="@Url.Action("Grid")">
        <partial name="_GridTable" model="new MatrixNext.Web.ViewModels.PaginationResultVM<MatrixNext.Web.Models.PY.Proyecto>()" />
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
    <script>
        (function() {
            const form = document.getElementById('filtrosForm');
            const grid = document.getElementById('gridContainer');
            const btnLimpiar = document.getElementById('btnLimpiar');

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                refreshGrid();
            });

            btnLimpiar.addEventListener('click', () => {
                form.reset();
                refreshGrid();
            });

            function refreshGrid(page) {
                const url = grid.dataset.gridUrl;
                const formData = new FormData(form);
                if (page) formData.set('PageNumber', page);
                fetch(url, { method: 'POST', body: formData })
                    .then(r => r.text())
                    .then(html => { grid.innerHTML = html; attachPager(); });
            }

            function attachPager() {
                grid.querySelectorAll('[data-page]').forEach(btn => {
                    btn.addEventListener('click', () => refreshGrid(btn.dataset.page));
                });
            }

            attachPager();
        })();
    </script>
}
