@model IEnumerable<MatrixNext.Web.Models.PY.SegmentosCuali>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Num. Participantes</th>
            <th>Cuota Min-Max</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Descripcion</td>
                <td>@item.NumeroParticipantes</td>
                <td>@(item.CuotaMinima ?? 0) - @(item.CuotaMaxima ?? 0)</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-primary" data-url="@Url.Action("ObtenerPorId", new { id = item.Id })" data-ajax-modal>Editar</button>
                    <button class="btn btn-sm btn-outline-secondary" data-url="@Url.Action("Duplicar", new { id = item.Id })" data-ajax-modal>Duplicar</button>
                    <button class="btn btn-sm btn-outline-danger" data-delete data-url="@Url.Action("Eliminar", new { id = item.Id })">Eliminar</button>
                    <a href="@Url.Action("Index", "SesionesCuali", new { idSegmento = item.Id })" class="btn btn-sm btn-outline-info">Sesiones</a>
                </td>
            </tr>
        }
    }
    else
    {
        <tr><td colspan="7" class="text-center text-muted">Sin segmentos definidos</td></tr>
    }
    </tbody>
</table>
