@{
    ViewData["Title"] = "Instructivos - " + ViewBag.NombreTrabajo;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>
                <i class="fas fa-book"></i> Instructivos Generales
            </h2>
            <small class="text-muted">Trabajo: <strong>@ViewBag.NombreTrabajo</strong></small>
        </div>
        <button class="btn btn-primary" 
                data-ajax-modal 
                data-url="@Url.Action("UploadModal", "Instructivos", new { idTrabajo = ViewBag.IdTrabajo })">
            <i class="fas fa-upload"></i> Cargar Instructivo
        </button>
    </div>

    @if (Model?.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-light">
                    <tr>
                        <th><i class="fas fa-file-pdf"></i> Archivo</th>
                        <th>Versión</th>
                        <th>Fecha Carga</th>
                        <th>Usuario</th>
                        <th>Tamaño</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var archivo in Model.OrderByDescending(a => a.FechaSubida))
                    {
                        <tr>
                            <td>
                                <i class="fas fa-file-@(archivo.Nombre.EndsWith(".pdf") ? "pdf text-danger" : "word text-primary")"></i>
                                <strong>@archivo.Nombre</strong>
                            </td>
                            <td>
                                <span class="badge badge-secondary">v@(archivo.Version ?? "1.0")</span>
                            </td>
                            <td>@archivo.FechaSubida.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <small>@archivo.UsuarioSubida</small>
                            </td>
                            <td>
                                <small class="text-muted">@(Math.Round(archivo.TamanoBytess / 1024.0, 2)) KB</small>
                            </td>
                            <td>
                                <a href="@Url.Action("Download", "Instructivos", new { idArchivo = archivo.IdArchivo })" 
                                   class="btn btn-sm btn-info" 
                                   title="Descargar">
                                    <i class="fas fa-download"></i>
                                </a>
                                <button type="button" 
                                        class="btn btn-sm btn-outline-danger"
                                        onclick="if (confirm('¿Eliminar este instructivo?')) { window.location = '@Url.Action("Delete", "Instructivos", new { idArchivo = archivo.IdArchivo })'; }">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Botón para ver Instructivos Cualitativos -->
        <div class="mt-4">
            <a href="@Url.Action("Cualitativos", "Instructivos", new { idTrabajo = ViewBag.IdTrabajo })" 
               class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> Ver Instructivos Cualitativos
            </a>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No hay instructivos cargados aún.
            <button class="btn btn-sm btn-primary ms-2" 
                    data-ajax-modal 
                    data-url="@Url.Action("UploadModal", "Instructivos", new { idTrabajo = ViewBag.IdTrabajo })">
                Cargar Ahora
            </button>
        </div>
    }
</div>

<div id="modalContainer"></div>

<!-- Toast Notifications -->
<div id="toastContainer" style="position: fixed; top: 20px; right: 20px; z-index: 9999;"></div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Manejo de modales AJAX
            $(document).on('click', '[data-ajax-modal]', function (e) {
                e.preventDefault();
                var url = $(this).data('url');
                $.get(url, function (html) {
                    $('#modalContainer').html(html);
                    $('#instructivoModal').modal('show');
                });
            });
        });

        function showToast(message, type) {
            var alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            var alert = $('<div class="alert ' + alertClass + ' alert-dismissible fade show" role="alert">' +
                '<i class="fas fa-check-circle"></i> ' + message +
                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                '</div>');
            $('#toastContainer').append(alert);
            setTimeout(() => alert.remove(), 5000);
        }
    </script>
}
