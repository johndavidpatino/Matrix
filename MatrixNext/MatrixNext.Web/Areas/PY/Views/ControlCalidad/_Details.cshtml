@using MatrixNext.Data.DTOs.PY.ControlCalidad
@model ControlCalidadDetailDto

@{
    var estadoBadge = Model.Estado?.ToLower() == "aprobado" ? "badge-success" : 
                      Model.Estado?.ToLower() == "rechazado" ? "badge-danger" : "badge-warning";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">
            Detalles del Control de Calidad
            <span class="badge @estadoBadge" style="float: right;">@Model.Estado</span>
        </h5>
    </div>
    <div class="card-body">
        <!-- InformaciÃ³n Principal -->
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="form-group">
                    <label><strong>ID:</strong></label>
                    <p>@Model.Id</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label><strong>Trabajo:</strong></label>
                    <p>@Model.NombreTrabajo</p>
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <div class="form-group">
                    <label><strong>Evaluador:</strong></label>
                    <p>@Model.Evaluador</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label><strong>Rol del Evaluador:</strong></label>
                    <p>@Model.RolEvaluador</p>
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <div class="form-group">
                    <label><strong>Fecha del Control:</strong></label>
                    <p>@Model.FechaControl.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label><strong>CalificaciÃ³n Promedio:</strong></label>
                    <p>
                        <strong>@(Model.Detalles != null && Model.Detalles.Count > 0 ? Model.Detalles.Average(d => d.Calificacion ?? 0).ToString("F2") + "%" : "N/A")</strong>
                    </p>
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-12">
                <div class="form-group">
                    <label><strong>Observaciones:</strong></label>
                    <p>@Model.Observaciones</p>
                </div>
            </div>
        </div>

        <!-- AuditorÃ­a -->
        <div class="row mb-3 text-muted small">
            <div class="col-md-6">
                <p><strong>Registrado por:</strong> @Model.RegistradoPor<br />
                <strong>Fecha:</strong> @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <div class="col-md-6">
                @if (!string.IsNullOrEmpty(Model.ModificadoPor))
                {
                    <p><strong>Modificado por:</strong> @Model.ModificadoPor<br />
                    <strong>Fecha:</strong> @Model.FechaModificacion?.ToString("dd/MM/yyyy HH:mm")</p>
                }
            </div>
        </div>

        <!-- Respuestas a Preguntas -->
        @if (Model.Detalles != null && Model.Detalles.Count > 0)
        {
            <div class="card mt-4">
                <div class="card-header">
                    <h6 class="mb-0">Respuestas a Preguntas (@Model.Detalles.Count)</h6>
                </div>
                <div class="card-body">
                    <table class="table table-striped table-sm">
                        <thead>
                            <tr>
                                <th style="width: 40%">Pregunta</th>
                                <th style="width: 40%">Respuesta</th>
                                <th style="width: 10%; text-align: center">CalificaciÃ³n</th>
                                <th style="width: 10%; text-align: center">ObservaciÃ³n</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detalle in Model.Detalles)
                            {
                                var calificacionClass = detalle.Calificacion >= 80 ? "badge-success" : 
                                                       detalle.Calificacion >= 60 ? "badge-warning" : "badge-danger";
                                <tr>
                                    <td>@detalle.PreguntaTexto</td>
                                    <td>@detalle.Respuesta</td>
                                    <td style="text-align: center">
                                        <span class="badge @calificacionClass">@detalle.Calificacion%</span>
                                    </td>
                                    <td style="text-align: center">
                                        @if (!string.IsNullOrEmpty(detalle.Observacion))
                                        {
                                            <i class="fas fa-comment text-info" title="@detalle.Observacion"></i>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

