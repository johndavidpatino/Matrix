@using MatrixNext.Web.DTOs.PY.ControlCalidad
@model IEnumerable<ControlCalidadListDto>

@{
    ViewData["Title"] = "Control de Calidad";
    var tiposProc = new Dictionary<int, string> { 
        { 1, "Control de Campo" }, 
        { 2, "Evaluación Moderadora" }, 
        { 3, "Evaluación Entrevistadora" },
        { 4, "Control de Transcripciones" },
        { 5, "Control de Informe" }
    };
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@ViewData["Title"]</h2>
        <button class="btn btn-primary" id="btnNuevoControl">
            <i class="fas fa-plus"></i> Nuevo Control
        </button>
    </div>

    <!-- Selector de Tipo de Proceso -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="form-group">
                <label for="tipoProceso">Tipo de Proceso:</label>
                <select id="tipoProceso" class="form-control" style="max-width: 300px;">
                    <option value="">-- Seleccione --</option>
                    @foreach (var tipo in tiposProc)
                    {
                        <option value="@tipo.Key">@tipo.Value</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- Grid de Controles -->
    <div class="card">
        <div class="card-body">
            <table id="gridControles" class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Trabajo</th>
                        <th>Evaluador</th>
                        <th>Rol</th>
                        <th>Fecha</th>
                        <th>Preguntas</th>
                        <th>Calificación</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal para crear/editar control -->
<div class="modal fade" id="modalControl" tabindex="-1" role="dialog" aria-labelledby="modalControlLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalControlLabel">Nuevo Control de Calidad</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalControlBody">
                <!-- Contenido del formulario será cargado aquí -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnGuardarControl">Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast para notificaciones -->
<div id="toastContainer" style="position: fixed; top: 20px; right: 20px; z-index: 9999;">
</div>

@section Scripts {
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap4.min.js"></script>
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap4.min.css" />
    
    <script>
        $(document).ready(function () {
            // Inicializar DataTable
            var table = $('#gridControles').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/es-ES.json'
                },
                pageLength: 10,
                processing: true
            });

            // Evento cambio de tipo de proceso
            $('#tipoProceso').on('change', function () {
                var tipoProceso = $(this).val();
                if (tipoProceso) {
                    cargarControles(tipoProceso, table);
                }
            });

            // Nuevo control
            $('#btnNuevoControl').on('click', function () {
                var tipoProceso = $('#tipoProceso').val();
                if (!tipoProceso) {
                    mostrarToast('Por favor seleccione un tipo de proceso', 'warning');
                    return;
                }
                abrirModalControl(null, tipoProceso);
            });

            // Guardar control
            $('#btnGuardarControl').on('click', function () {
                guardarControl();
            });
        });

        function cargarControles(tipoProceso, table) {
            $.ajax({
                url: '/api/py/controlcalidad/' + tipoProceso,
                type: 'GET',
                success: function (response) {
                    if (response.success) {
                        table.clear();
                        $.each(response.data, function (idx, control) {
                            table.row.add([
                                control.nombreTrabajo || '',
                                control.evaluador || '',
                                control.rolEvaluador || '',
                                moment(control.fechaControl).format('DD/MM/YYYY'),
                                control.cantidadPreguntas || 0,
                                (control.calificacion || 0).toFixed(2) + '%',
                                '<span class="badge badge-info">' + (control.estado || 'Pendiente') + '</span>',
                                '<button class="btn btn-sm btn-info" onclick="verDetalle(' + control.id + ')"><i class="fas fa-eye"></i></button> ' +
                                '<button class="btn btn-sm btn-warning" onclick="editarControl(' + control.id + ')"><i class="fas fa-edit"></i></button> ' +
                                '<button class="btn btn-sm btn-danger" onclick="eliminarControl(' + control.id + ')"><i class="fas fa-trash"></i></button>'
                            ]).draw();
                        });
                    } else {
                        mostrarToast(response.message || 'Error al cargar los controles', 'error');
                    }
                },
                error: function () {
                    mostrarToast('Error al cargar los controles', 'error');
                }
            });
        }

        function abrirModalControl(controlId, tipoProceso) {
            var url = controlId ? '/py/controlcalidad/edit/' + controlId : '/py/controlcalidad/create?tipoProceso=' + tipoProceso;
            $.get(url, function (html) {
                $('#modalControlBody').html(html);
                $('#modalControl').modal('show');
            }).fail(function () {
                mostrarToast('Error al abrir el formulario', 'error');
            });
        }

        function guardarControl() {
            var form = $('form', '#modalControlBody');
            if (!form.length) return;

            var formData = new FormData(form[0]);
            var url = form.attr('action');
            var isEdit = form.data('edit') === true;

            $.ajax({
                url: url,
                type: 'POST',
                processData: false,
                contentType: false,
                data: formData,
                success: function (response) {
                    if (response.success) {
                        mostrarToast(response.message || 'Operación exitosa', 'success');
                        $('#modalControl').modal('hide');
                        var tipoProceso = $('#tipoProceso').val();
                        if (tipoProceso) {
                            cargarControles(tipoProceso, $('#gridControles').DataTable());
                        }
                    } else {
                        mostrarToast(response.message || 'Error al guardar', 'error');
                    }
                },
                error: function () {
                    mostrarToast('Error al guardar el control', 'error');
                }
            });
        }

        function verDetalle(controlId) {
            $.get('/api/py/controlcalidad/details/' + controlId, function (response) {
                if (response.success) {
                    alert(JSON.stringify(response.data, null, 2));
                } else {
                    mostrarToast(response.message, 'error');
                }
            }).fail(function () {
                mostrarToast('Error al cargar los detalles', 'error');
            });
        }

        function editarControl(controlId) {
            abrirModalControl(controlId, null);
        }

        function eliminarControl(controlId) {
            if (confirm('¿Está seguro de que desea eliminar este control?')) {
                $.ajax({
                    url: '/api/py/controlcalidad/delete/' + controlId,
                    type: 'POST',
                    success: function (response) {
                        if (response.success) {
                            mostrarToast(response.message || 'Control eliminado', 'success');
                            var tipoProceso = $('#tipoProceso').val();
                            if (tipoProceso) {
                                cargarControles(tipoProceso, $('#gridControles').DataTable());
                            }
                        } else {
                            mostrarToast(response.message || 'Error al eliminar', 'error');
                        }
                    },
                    error: function () {
                        mostrarToast('Error al eliminar el control', 'error');
                    }
                });
            }
        }

        function mostrarToast(mensaje, tipo) {
            var tipoClase = 'alert-' + (tipo === 'error' ? 'danger' : tipo === 'warning' ? 'warning' : 'success');
            var html = '<div class="alert ' + tipoClase + ' alert-dismissible fade show" role="alert">' +
                mensaje +
                '<button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>' +
                '</div>';
            $('#toastContainer').html(html);
            
            setTimeout(function () {
                $('#toastContainer').fadeOut(function () { $(this).html(''); });
            }, 3000);
        }
    </script>
}
