@model IEnumerable<MatrixNext.Web.Models.PY.TrabajosCuali>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>JobBook</th>
            <th>Nombre</th>
            <th>Tipo Estudio</th>
            <th>Estado</th>
            <th>Coordinador</th>
            <th>Ubicación</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <tr>
                <td>@item.JobBook</td>
                <td>@item.Nombre</td>
                <td>@item.TipoEstudio</td>
                <td>
                    @{
                        var badgeClass = item.Estado switch
                        {
                            "Nuevo" => "bg-primary",
                            "En Proceso" => "bg-warning text-dark",
                            "Finalizado" => "bg-success",
                            "Anulado" => "bg-danger",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @badgeClass">@item.Estado</span>
                </td>
                <td>@item.IdCoordinador</td>
                <td>@item.Ubicacion</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-primary" data-url="@Url.Action("ObtenerPorId", new { id = item.Id })" data-ajax-modal>Editar</button>
                    <button class="btn btn-sm btn-outline-secondary" data-url="@Url.Action("Duplicar", new { id = item.Id })" data-ajax-modal>Duplicar</button>
                    <button class="btn btn-sm btn-outline-danger" data-delete data-url="@Url.Action("Eliminar", new { id = item.Id })">Eliminar</button>
                    <a href="@Url.Action("Index", "SegmentosCuali", new { idTrabajo = item.Id })" class="btn btn-sm btn-outline-info">Segmentos</a>
                </td>
            </tr>
        }
    }
    else
    {
        <tr><td colspan="7" class="text-center text-muted">Sin trabajos cualitativos</td></tr>
    }
    </tbody>
</table>
