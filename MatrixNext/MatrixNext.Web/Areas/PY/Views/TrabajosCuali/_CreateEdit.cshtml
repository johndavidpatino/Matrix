@model MatrixNext.Web.Models.PY.TrabajosCuali

<form id="formTrabajoCuali" asp-action="Crear" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="IdProyecto" type="hidden" />
    
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Nombre <span class="text-danger">*</span></label>
            <input asp-for="Nombre" class="form-control" required />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">JobBook</label>
            <input asp-for="JobBook" class="form-control" />
            <span asp-validation-for="JobBook" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Descripción</label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label">Id Coordinador</label>
            <input asp-for="IdCoordinador" type="number" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Tipo de Estudio <span class="text-danger">*</span></label>
            <select asp-for="TipoEstudio" class="form-select" required>
                <option value="">Seleccione...</option>
                <option value="Focus Group">Focus Group</option>
                <option value="Entrevistas Profundidad">Entrevistas a Profundidad</option>
                <option value="Observación">Observación</option>
                <option value="Etnografía">Etnografía</option>
                <option value="Diarios">Diarios</option>
                <option value="Comunidades Online">Comunidades Online</option>
            </select>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label">Número de Participantes Estimado</label>
            <input asp-for="NumeroParticipantesEstimado" type="number" class="form-control" min="0" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Presupuesto Estimado</label>
            <input asp-for="PresupuestoEstimado" type="number" step="0.01" class="form-control" />
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Ubicación</label>
        <input asp-for="Ubicacion" class="form-control" placeholder="Ciudad, Sala, etc." />
    </div>

    <div class="mb-3">
        <label class="form-label">Fecha Vencimiento</label>
        <input asp-for="FechaVencimiento" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Estado</label>
        <select asp-for="Estado" class="form-select">
            <option value="Nuevo">Nuevo</option>
            <option value="En Proceso">En Proceso</option>
            <option value="Finalizado">Finalizado</option>
            <option value="Anulado">Anulado</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Notas</label>
        <textarea asp-for="Notas" class="form-control" rows="3"></textarea>
    </div>

    <div class="form-check form-switch mb-3">
        <input asp-for="Activo" class="form-check-input" />
        <label class="form-check-label">Activo</label>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save"></i> Guardar
        </button>
    </div>
</form>

<script>
    $(document).ready(function() {
        $('#formTrabajoCuali').on('submit', function(e) {
            e.preventDefault();
            
            const formData = $(this).serialize();
            const url = '@Url.Action("Crear")';
            
            $.ajax({
                url: url,
                type: 'POST',
                data: formData,
                success: function(response) {
                    if (response.exitoso) {
                        alert(response.mensaje);
                        window.location.reload();
                    } else {
                        alert(response.mensaje);
                    }
                },
                error: function() {
                    alert('Error al guardar el trabajo cualitativo');
                }
            });
        });
    });
</script>
