@model MatrixNext.Web.Models.PY.AsignacionProyecto
@{
    Layout = "";
}

<div class="modal-header bg-warning text-dark">
    <h5 class="modal-title">
        <i class="fas fa-exchange-alt"></i> Reasignar Gerente
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<form asp-action="Reasignar" method="post" data-ajax-form>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" asp-for="IdAsignacion" />

        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i>
            <strong>Proyecto:</strong> @Model.NombreProyecto<br />
            <strong>Gerente Actual:</strong> @Model.NombreGerentePrincipal
        </div>

        <div class="form-group mb-3">
            <label asp-for="IdGerentePrincipal" class="form-label">Nuevo Gerente *</label>
            <select asp-for="IdGerentePrincipal" class="form-control" required>
                <option value="">-- Seleccione nuevo gerente --</option>
            </select>
            <span asp-validation-for="IdGerentePrincipal" class="text-danger"></span>
            <small class="form-text text-muted">
                Gerente actual: <strong>@Model.NombreGerentePrincipal</strong>
            </small>
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Trabajos a Reasignar (opcional)</label>
            <div id="listaTrabajosReasignar" style="max-height: 250px; overflow-y: auto; border: 1px solid #ddd; padding: 10px; border-radius: 4px;">
                <p class="text-muted">Cargando trabajos asignados...</p>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="ObservacionesAsignacion" class="form-label">Motivo de Reasignación *</label>
            <textarea asp-for="ObservacionesAsignacion" class="form-control" rows="4" 
                      placeholder="Especifique por qué se reasigna el gerente (cambio de cartera, desempeño, disponibilidad, etc.)..." 
                      required></textarea>
            <span asp-validation-for="ObservacionesAsignacion" class="text-danger"></span>
        </div>

        <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="notificarAnterior" name="NotificarGerenteAnterior" value="true">
            <label class="form-check-label" for="notificarAnterior">
                Notificar al gerente anterior por correo
            </label>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="fas fa-times"></i> Cancelar
        </button>
        <button type="submit" class="btn btn-warning">
            <i class="fas fa-sync-alt"></i> Reasignar
        </button>
    </div>
</form>

@section Scripts {
    <script>
        $(document).ready(function () {
            var idAsignacionActual = $('[name="IdAsignacion"]').val();

            // Cargar gerentes disponibles (excepto actual)
            $.get('@Url.Action("GetGerentesDisponibles", "Asignaciones", new { area = "PY" })', function (data) {
                $.each(data.datos, function (i, item) {
                    if (item.idEmpleado != @Model.IdGerentePrincipal) {
                        $('[name="IdGerentePrincipal"]').append(
                            $('<option></option>')
                                .attr('value', item.idEmpleado)
                                .text(item.nomCompleto + ' (' + item.email + ')')
                        );
                    }
                });
            });

            // Cargar trabajos asignados
            $.get('@Url.Action("GetTrabajosAsignados", "Asignaciones", new { area = "PY" })', 
                { id: idAsignacionActual }, 
                function (data) {
                    var html = '';
                    $.each(data.datos, function (i, item) {
                        html += `<div class="form-check">
                            <input class="form-check-input trabajoCheck" type="checkbox" value="${item.idTrabajo}" id="trabajo_${item.idTrabajo}" name="IdsTrabajos" checked>
                            <label class="form-check-label" for="trabajo_${item.idTrabajo}">
                                ${item.numeroTrabajo} - ${item.nombreTrabajo}
                                <span class="badge badge-info">${item.estado}</span>
                            </label>
                        </div>`;
                    });
                    $('#listaTrabajosReasignar').html(html || '<p class="text-muted">No hay trabajos asignados</p>');
                });
        });
    </script>
}
