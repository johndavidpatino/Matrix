@{
    ViewData["Title"] = "Reportes - Variables de Control";
    var empleados = ViewBag.Empleados as Dictionary<long, string> ?? new Dictionary<long, string>();
}

<div class="container-fluid">
    <h3><i class="fas fa-chart-bar"></i> Reportes - Variables de Control</h3>
    
    <!-- Filtros -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <label>Año</label>
                    <input type="number" id="filtroAno" class="form-control" min="2020" max="2030" value="@DateTime.Now.Year" />
                </div>
                <div class="col-md-3">
                    <label>Mes</label>
                    <select id="filtroMes" class="form-select">
                        <option value="">Todos</option>
                        @for (int i = 1; i <= 12; i++)
                        {
                            var fecha = new DateTime(2000, i, 1);
                            <option value="@i">@fecha.ToString("MMMM")</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label>Empleado</label>
                    <select id="filtroEmpleado" class="form-select">
                        <option value="">Todos</option>
                        @foreach (var emp in empleados)
                        {
                            <option value="@emp.Key">@emp.Value</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label>&nbsp;</label><br />
                    <button class="btn btn-primary" onclick="buscarDetallado()">
                        <i class="fas fa-search"></i> Buscar
                    </button>
                    <button class="btn btn-success" onclick="exportarExcel('detallado')">
                        <i class="fas fa-file-excel"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-bs-toggle="tab" href="#tabDetallado">Reporte Detallado</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#tabPorMes">Por Mes</a>
        </li>
    </ul>

    <div class="tab-content p-3 border border-top-0">
        <!-- Tab Detallado -->
        <div id="tabDetallado" class="tab-pane fade show active">
            <div id="tablaDetallado"></div>
        </div>

        <!-- Tab Por Mes -->
        <div id="tabPorMes" class="tab-pane fade">
            <button class="btn btn-primary mb-2" onclick="buscarPorMes()">
                <i class="fas fa-sync"></i> Actualizar
            </button>
            <button class="btn btn-success mb-2" onclick="exportarExcel('pormes')">
                <i class="fas fa-file-excel"></i> Exportar
            </button>
            <div id="tablaPorMes"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function getFiltros() {
            return {
                ano: $('#filtroAno').val() ? parseInt($('#filtroAno').val()) : null,
                mes: $('#filtroMes').val() ? parseInt($('#filtroMes').val()) : null,
                idEvaluado: $('#filtroEmpleado').val() ? parseInt($('#filtroEmpleado').val()) : null
            };
        }

        function buscarDetallado() {
            $.ajax({
                url: '@Url.Action("ReporteDetallado")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(getFiltros()),
                success: function(data) {
                    let html = '<table class="table table-striped table-sm"><thead><tr>';
                    html += '<th>Evaluado</th><th>Tipo</th><th>Fecha</th><th>Trabajo</th>';
                    html += '<th>JobBook</th><th>% Cumple</th><th>% No Cumple</th></tr></thead><tbody>';
                    
                    data.forEach(item => {
                        html += `<tr>
                            <td>${item.nombreEvaluado || ''}</td>
                            <td>${item.tipoEvaluado || ''}</td>
                            <td>${new Date(item.fechaCreacion).toLocaleDateString()}</td>
                            <td>${item.nombreTrabajo || ''}</td>
                            <td>${item.jobBook || ''}</td>
                            <td><span class="badge bg-success">${item.totalCumple}%</span></td>
                            <td><span class="badge bg-danger">${item.totalNoCumple}%</span></td>
                        </tr>`;
                    });
                    
                    html += '</tbody></table>';
                    $('#tablaDetallado').html(html);
                }
            });
        }

        function buscarPorMes() {
            $.ajax({
                url: '@Url.Action("ReportePorMes")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(getFiltros()),
                success: function(data) {
                    let html = '<table class="table table-striped"><thead><tr>';
                    html += '<th>Evaluado</th><th>Año</th><th>Mes</th><th>% Cumple</th><th>% No Cumple</th>';
                    html += '</tr></thead><tbody>';
                    
                    data.forEach(item => {
                        html += `<tr>
                            <td>${item.nombreEvaluado || ''}</td>
                            <td>${item.ano}</td>
                            <td>${item.nombreMes || ''}</td>
                            <td><span class="badge bg-success">${item.porcentajeCumplimiento || 0}%</span></td>
                            <td><span class="badge bg-danger">${item.porcentajeGeneral || 0}%</span></td>
                        </tr>`;
                    });
                    
                    html += '</tbody></table>';
                    $('#tablaPorMes').html(html);
                }
            });
        }

        function exportarExcel(tipoReporte) {
            $.ajax({
                url: '@Url.Action("Exportar")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ filtros: getFiltros(), tipoReporte }),
                xhrFields: { responseType: 'blob' },
                success: function(blob) {
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `VariablesControl_${tipoReporte}_${new Date().getTime()}.xlsx`;
                    a.click();
                }
            });
        }

        $(document).ready(function() {
            buscarDetallado();
        });
    </script>
}
