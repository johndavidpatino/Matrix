@model MatrixNext.Web.Models.PY.Trabajo
@{
    var idOriginal = ViewBag.IdOriginal as long?;
}

<form asp-action="Duplicate" method="post" data-ajax="true" data-ajax-method="post" data-ajax-success="onDuplicateSuccess" data-ajax-failure="onDuplicateFailure">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@idOriginal" />
    <div class="mb-3">
        <label class="form-label">Nombre nuevo</label>
        <input name="nombre" class="form-control" value="@(Model?.Nombre ?? string.Empty) (Copia)" />
    </div>
    <div class="mb-3">
        <label class="form-label">JobBook nuevo</label>
        <input name="jobBook" class="form-control" value="@Model?.JobBook" />
    </div>
    <div class="d-flex justify-content-end">
        <button type="submit" class="btn btn-primary">Duplicar</button>
    </div>
</form>

<script>
    function onDuplicateSuccess(response) {
        if (response && response.success) {
            window.location.reload();
        }
    }
    function onDuplicateFailure() {
        alert('No se pudo duplicar el trabajo');
    }
</script>
