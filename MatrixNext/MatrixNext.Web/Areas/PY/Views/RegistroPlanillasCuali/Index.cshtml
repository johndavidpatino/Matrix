@{
    ViewData["Title"] = "Registro Planillas Cualitativo - " + ViewBag.NombreTrabajo;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>
                <i class="fas fa-file-excel"></i> Registro de Planillas Cualitativo
            </h2>
            <small class="text-muted">Trabajo: <strong>@ViewBag.NombreTrabajo</strong></small>
        </div>
        <button class="btn btn-success" 
                data-ajax-modal 
                data-url="@Url.Action("UploadModal", "RegistroPlanillasCuali", new { idTrabajo = ViewBag.IdTrabajo })">
            <i class="fas fa-upload"></i> Cargar Planilla
        </button>
    </div>

    <!-- Alert de Información -->
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> 
        <strong>Formato requerido:</strong> Excel (.xlsx o .xls) con campos: EntrevistadorId, FechaEntrevista, Respuestas, etc.
        <a href="#" class="ms-2 text-info">Descargar plantilla</a>
    </div>

    @if (Model?.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-light">
                    <tr>
                        <th><i class="fas fa-file-excel"></i> Planilla</th>
                        <th>Fecha Carga</th>
                        <th>Usuario</th>
                        <th>Tamaño</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var planilla in Model.OrderByDescending(p => p.FechaSubida))
                    {
                        <tr>
                            <td>
                                <i class="fas fa-file-excel text-success"></i>
                                <strong>@planilla.Nombre</strong>
                            </td>
                            <td>@planilla.FechaSubida.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <small>@planilla.UsuarioSubida</small>
                            </td>
                            <td>
                                <small class="text-muted">@(Math.Round(planilla.TamanoBytess / 1024.0, 2)) KB</small>
                            </td>
                            <td>
                                <span class="badge badge-success">
                                    <i class="fas fa-check-circle"></i> Procesada
                                </span>
                            </td>
                            <td>
                                <a href="@Url.Action("Download", "RegistroPlanillasCuali", new { idArchivo = planilla.IdArchivo })" 
                                   class="btn btn-sm btn-info" 
                                   title="Descargar">
                                    <i class="fas fa-download"></i>
                                </a>
                                <button type="button" 
                                        class="btn btn-sm btn-outline-danger"
                                        onclick="if (confirm('¿Eliminar esta planilla?')) { $.post('@Url.Action("Delete", "RegistroPlanillasCuali", new { idArchivo = planilla.IdArchivo })', function(r) { location.reload(); }); }">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="fas fa-warning"></i> No hay planillas cargadas aún.
            <button class="btn btn-sm btn-success ms-2" 
                    data-ajax-modal 
                    data-url="@Url.Action("UploadModal", "RegistroPlanillasCuali", new { idTrabajo = ViewBag.IdTrabajo })">
                Cargar Ahora
            </button>
        </div>
    }
</div>

<div id="modalContainer"></div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $(document).on('click', '[data-ajax-modal]', function (e) {
                e.preventDefault();
                var url = $(this).data('url');
                $.get(url, function (html) {
                    $('#modalContainer').html(html);
                    $('#planillaModal').modal('show');
                });
            });
        });
    </script>
}
