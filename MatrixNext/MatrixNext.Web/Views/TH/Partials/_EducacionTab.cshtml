<!-- Educación Tab -->
<div class="tab-pane fade" id="educacion" role="tabpanel">
    <div class="card-body">
        <div class="d-flex justify-content-between mb-3">
            <h6 class="mb-0">Educación</h6>
            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#educacionModal" onclick="NestedResourcesModule.resetForm()">
                <i class="bi bi-plus"></i> Agregar
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-sm">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Título</th>
                        <th>Institución</th>
                        <th>País</th>
                        <th>Año Graduación</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody id="educacionTableBody">
                    <tr><td colspan="6" class="text-center py-4">Cargando...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Educación Modal -->
<div class="modal fade" id="educacionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Agregar Educación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="educacionForm" novalidate>
                    <div class="mb-3">
                        <label class="form-label">Título</label>
                        <input type="text" class="form-control" name="titulo" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Institución</label>
                        <input type="text" class="form-control" name="institucion" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">País</label>
                        <input type="text" class="form-control" name="pais" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Año Graduación</label>
                        <input type="number" class="form-control" name="anoGraduacion" min="1900" max="2100">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="NestedResourcesModule.saveItem()">Guardar</button>
            </div>
        </div>
    </div>
</div>

<script>
NestedResourcesModule.init('educacion', '/api/empleados/{id}/educacion', {
    title: 'Educación',
    parentIdParam: 'personaId'
});
</script>
