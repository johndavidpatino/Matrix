<!-- Hijos Tab -->
<div class="tab-pane fade" id="hijos" role="tabpanel">
    <div class="card-body">
        <div class="d-flex justify-content-between mb-3">
            <h6 class="mb-0">Hijos</h6>
            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#hijosModal" onclick="NestedResourcesModule.resetForm()">
                <i class="bi bi-plus"></i> Agregar
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-sm">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Nombre</th>
                        <th>Fecha Nacimiento</th>
                        <th>Edad</th>
                        <th>Género</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody id="hijosTableBody">
                    <tr><td colspan="6" class="text-center py-4">Cargando...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Hijos Modal -->
<div class="modal fade" id="hijosModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Agregar Hijo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="hijosForm" novalidate>
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-control" name="nombre" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Fecha de Nacimiento</label>
                        <input type="date" class="form-control" name="fechaNacimiento" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Género</label>
                        <select class="form-control" name="genero" required>
                            <option value="">Seleccione...</option>
                            <option value="M">Masculino</option>
                            <option value="F">Femenino</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="NestedResourcesModule.saveItem()">Guardar</button>
            </div>
        </div>
    </div>
</div>

<script>
NestedResourcesModule.init('hijos', '/api/empleados/{id}/hijos', {
    title: 'Hijo',
    parentIdParam: 'personaId'
});
</script>
