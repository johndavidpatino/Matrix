@*
    Componente de Alerta Informativa Contextual
    Uso: <partial name="~/Views/Shared/_InfoAlert.cshtml" model='new { Message = "Mensaje", Type = "info" }' />
    
    Tipos: info (azul), success (verde), warning (amarillo), danger (rojo), tip (celeste)
*@
@{
    var message = ViewData["Message"]?.ToString() ?? "";
    var type = ViewData["Type"]?.ToString() ?? "info";
    var dismissible = ViewData["Dismissible"]?.ToString() == "true";
    var icon = ViewData["Icon"]?.ToString();
    
    var alertClass = type switch
    {
        "info" => "alert-info",
        "success" => "alert-success",
        "warning" => "alert-warning",
        "danger" => "alert-danger",
        "tip" => "alert-primary",
        _ => "alert-info"
    };
    
    var iconClass = icon ?? type switch
    {
        "info" => "bi-info-circle-fill",
        "success" => "bi-check-circle-fill",
        "warning" => "bi-exclamation-triangle-fill",
        "danger" => "bi-x-circle-fill",
        "tip" => "bi-lightbulb-fill",
        _ => "bi-info-circle-fill"
    };
}

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @alertClass @(dismissible ? "alert-dismissible fade show" : "") d-flex align-items-center py-2" role="alert">
        <i class="bi @iconClass me-2"></i>
        <div class="small">@Html.Raw(message)</div>
        @if (dismissible)
        {
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        }
    </div>
}
